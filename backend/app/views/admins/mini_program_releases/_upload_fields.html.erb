<%# 弹窗和旧上传页面共享输入、微信读取和手填兜底。 %>
<div role="alert" class="text-danger mb-2"></div>
<div class="mb-3">
  <label class="form-label required" for="upload-app">目标小程序</label>
  <% selected_app = apps.find { |app| app.id.to_s == params[:app_id].to_s } || (apps.first if apps.one?) %>
  <%= select_tag :target_app, options_for_select(apps.map { |app| ["#{app.display_name} · #{app.appid}", admins_app_releases_path(app)] }, (admins_app_releases_path(selected_app) if selected_app)), include_blank: "请选择已授权的小程序", required: true, id: "upload-app", class: "form-select", data: { enhanced_select: "search" } %>
</div>
<div class="mb-3">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <label class="form-label required mb-0" for="upload-template">代码模板</label>
    <button type="button" class="btn btn-sm" data-refresh-templates><%= render "layouts/admins/icon", name: :rotate %>刷新模板</button>
  </div>
  <%= select_tag :selected_template, options_for_select(Array(local_assigns[:templates]).map { |row| ["##{row["template_id"]} · #{row["user_version"]} · #{row["user_desc"]}", row["template_id"]] }), include_blank: "请选择模板", required: true, id: "upload-template", class: "form-select", data: { enhanced_select: "search" } %>
  <div class="form-hint" role="status" aria-live="polite"></div>
</div>
<div class="row g-3 mb-3" data-template-fields hidden>
  <div class="col-6"><%= f.label :template_id, "模板 ID", class: "form-label" %><%= f.text_field :template_id, required: true, pattern: "[0-9]+", readonly: true, class: "form-control" %></div>
  <div class="col-6"><%= f.label :template_type, "模板类型", class: "form-label" %><%= f.select :template_type, WechatPlatform::CodeTemplates::TYPES.invert, {}, class: "form-select", data: { enhanced_select: "single" } %></div>
  <div class="col-12"><%= f.label :version, "版本", class: "form-label" %><%= f.text_field :version, required: true, readonly: true, class: "form-control" %></div>
  <div class="col-12"><%= f.label :description, "说明", class: "form-label" %><%= f.text_area :description, required: true, readonly: true, rows: 2, class: "form-control" %></div>
</div>
