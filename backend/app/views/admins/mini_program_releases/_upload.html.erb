<div class="modal fade" id="release-upload" tabindex="-1" aria-labelledby="upload-title" data-templates="<%= templates_admins_mini_program_releases_path %>" data-open="<%= params[:upload] == '1' %>">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title" id="upload-title">上传代码</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <%= form_with url: admins_app_releases_path(@upload_apps.first), scope: :release, class: "modal-body", data: { release_form: true } do |f| %>
      <div role="alert" class="text-danger mb-2"></div>
      <label class="form-label" for="upload-app">目标应用</label>
      <select data-enhanced-select="search" id="upload-app" class="form-select mb-3" required><% @upload_apps.each do |app| %><option value="<%= admins_app_releases_path(app) %>" <%= "selected" if params[:app_id].to_s == app.id.to_s %>><%= app.display_name %> · <%= app.appid %></option><% end %></select>
      <div class="d-flex justify-content-between align-items-center"><label class="form-label" for="upload-template">代码模板</label><button type="button" class="btn btn-sm" data-refresh-templates><%= render "layouts/admins/icon", name: :rotate %>刷新模板</button></div>
      <select data-enhanced-select="search" id="upload-template" class="form-select my-2"></select><div class="small text-secondary mb-2" role="status"></div>
      <div class="row g-3 mb-3"><div class="col-sm-6"><%= f.label :template_id, "模板 ID", class: "form-label" %><%= f.text_field :template_id, required: true, pattern: "[0-9]+", class: "form-control" %></div>
        <div class="col-sm-6"><%= f.label :template_type, "模板类型", class: "form-label" %><%= f.select :template_type, WechatPlatform::CodeTemplates::TYPES.invert, {}, class: "form-select", data: { enhanced_select: "single" } %></div>
        <div class="col-12"><%= f.label :version, "版本", class: "form-label" %><%= f.text_field :version, required: true, class: "form-control" %></div>
        <div class="col-12"><%= f.label :description, "说明", class: "form-label" %><%= f.text_area :description, required: true, class: "form-control" %></div></div>
      <div class="btn-list justify-content-end"><button type="button" class="btn" data-bs-dismiss="modal">取消</button><%= render "admins/shared/submit_button", label: "确认上传", icon: :import %></div>
    <% end %>
  </div></div>
</div>
