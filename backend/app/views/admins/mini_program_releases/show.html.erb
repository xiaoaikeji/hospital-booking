<% content_for :title, "#{@release.app.display_name} · #{@release.version} · 代码" %>
<% content_for :head do %><%= javascript_include_tag "admins/releases", defer: true %><% end %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "#{@release.app.display_name} · #{@release.version}", icon: :package } do %>
  <%= link_to "全部代码记录", admins_mini_program_releases_path(app_id: @release.app_id), class: "btn" %>
<% end %>
<section class="card mb-3"><div class="card-header"><h2 class="card-title">上传快照</h2></div><div class="card-body">
  <%= render "admins/shared/field_rows", fields: { "应用" => link_to(@release.app.display_name, admins_app_path(@release.app)), "AppID" => @release.app.appid, "模板 ID" => @release.template_id, "模板类型" => WechatPlatform::CodeTemplates::TYPES[@release.template_type], "版本" => @release.version, "最近结果" => MiniProgramRelease::STATES[@release.progress], "上传人" => @release.operator.display_name, "上传时间" => admin_list_time(@release.created_at), "说明" => @release.description, "扩展配置" => tag.code(@release.ext_config.to_json) }, full: %w[说明 扩展配置] %>
  <% if @release.error_code %><p class="text-danger mt-3"><%= Wechat::BaseClient::Rejected.new(@release.error_code).message %></p><% end %>
  <% if !@release.current_build? && %w[rejected withdrawn].include?(@release.action_round&.status) %>
    <p class="text-secondary mt-3">体验版已更换。请核对当前体验版；如需再次提审此代码，可从<%= link_to "本应用代码列表", admins_mini_program_releases_path(app_id: @release.app_id) %>上传。</p>
  <% end %>
  <div class="mt-3"><%= render "actions", release: @release, detail: true %></div>
</div></section>
<section class="card"><div class="card-header"><h2 class="card-title">历次审核</h2></div>
  <% if @rounds.empty? %><%= render "admins/shared/list_empty", icon: :clock, title: "暂无提审记录" %><% end %>
  <div class="list-group list-group-flush"><% @rounds.each do |round| %>
    <article class="list-group-item"><%= render "round", round: round %>
      <% if round != @release.action_round %><div class="btn-list mt-2"><%= render "round_actions", release: @release, round: round, actions: WechatPlatform::ReleaseActions.new(@release.app, release: @release, round: round) %></div><% end %>
    </article>
  <% end %></div>
</section>
<% if @activity.any? %><section class="card mt-3"><div class="card-header"><h2 class="card-title">操作记录</h2></div><div class="list-group list-group-flush">
  <% @activity.each do |entry| %><div class="list-group-item"><%= Log::OPERATION_EVENTS[[entry.category, entry.action]] %> · <%= @operators[entry.actor_id]&.display_name || "管理员 ##{entry.actor_id}" %> · <%= admin_list_time(entry.created_at) %>
    <% if entry.action == "wechat.publication_mode" %> · <%= entry.details["before"] ? "自动" : "手动" %> → <%= entry.details["after"] ? "自动" : "手动" %><% end %>
  </div><% end %></div></section><% end %>
<%= render "dialog" %>
