<p><strong><%= @release.app.display_name %></strong> · <%= @release.app.appid %> · <%= @release.version %></p>
<%= form_with url: verify_upload_admins_app_release_path(@release.app, @release), method: :patch, data: { release_form: true } do |f| %>
  <div role="alert" class="text-danger"></div>
  <div class="d-flex align-items-center gap-1 mb-2">
    <%= f.label :outcome, "微信体验版核实结果", class: "form-label required mb-0" %>
    <%= render "admins/shared/field_help", label: "查看核实结果说明", text: "微信体验版由外部上传，或版本与说明相同、无法确认模板时，选择保留。系统会关闭本地待核实记录，不会修改微信上的代码。" %>
  </div>
  <div class="mb-3">
    <%= f.select :outcome, [["本次上传已生效", "uploaded"], ["微信未执行本次上传", "not_uploaded"],
          ["保留微信当前体验版", "keep_remote"]], { prompt: "请选择核实结果" },
          class: "form-select", required: true %>
  </div>
  <label class="form-check"><%= f.check_box :confirmed, required: true, class: "form-check-input" %>已在微信后台核对当前体验版</label>
  <div class="btn-list justify-content-end"><button type="button" class="btn" data-bs-dismiss="modal">取消</button><%= render "admins/shared/submit_button", label: "登记核实结果", icon: :check %></div>
<% end %>
