<p><strong><%= @release.app.display_name %></strong> · <%= @release.app.appid %> · 版本 <%= @release.version %></p>
<ul class="alert alert-info d-block ps-5"><% @warnings.each do |text| %><li><%= text %></li><% end %></ul>
<%= form_with url: submit_admins_app_release_path(@release.app, @release), data: { release_form: true } do |f| %>
  <div role="alert" class="text-danger mb-2"></div>
  <%= f.hidden_field :expected_round, value: @revision %>
  <%= f.label :description, "本轮提审说明", class: "form-label" %><%= f.text_area :description, value: @release.latest_audit&.description || @release.description, class: "form-control mb-3" %>
  <label class="form-check mb-3"><%= f.check_box :auto_publish, checked: true, class: "form-check-input" %>审核通过后自动发布</label>
  <div class="btn-list justify-content-end"><button type="button" class="btn" data-bs-dismiss="modal">取消</button><%= render "admins/shared/submit_button", label: "确认提审", icon: :check %></div>
<% end %>
