<% content_for :title, "小程序代码管理 · Booking 管理后台" %>
<% content_for :fill_content, "true" if @releases.empty? %>
<%= render "admins/shared/enhanced_select_assets" %>
<% content_for :head do %>
  <%= javascript_include_tag "admins/releases", "admins/app_qrcode", defer: true %>
<% end %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "小程序代码管理", icon: :code } do %>
  <button type="button" class="btn btn-primary text-nowrap" data-bs-toggle="modal" data-bs-target="<%= @upload_apps.any? ? '#release-upload' : '#upload-requirements' %>"><%= render "layouts/admins/icon", name: :import %>上传代码</button>
  <%= link_to admins_wechat_notifications_path(app_id: @selected_app&.id), class: "btn" do %><%= render "layouts/admins/icon", name: :bell %>通知记录<% end %>
  <% if @upload_scope.any?(&:platform_authorized?) %>
    <%= link_to admins_mini_program_releases_path(@filters.merge(page: @pagy.page, quota: 1)), class: "btn" do %><%= render "layouts/admins/icon", name: :search %>查询额度<% end %>
  <% end %>
<% end %>
<% if @quota %><div class="alert alert-info">提审剩余 <%= @quota["rest"] %> / <%= @quota["limit"] %>，加急剩余 <%= @quota["speedup_rest"] %> / <%= @quota["speedup_limit"] %></div><% elsif @quota_error %><div class="alert alert-warning"><%= @quota_error %></div><% end %>
<section class="card mb-3" aria-label="代码筛选条件">
  <button type="button" class="btn d-md-none justify-content-between border-0" data-bs-toggle="collapse" data-bs-target="#release-filter-options" aria-expanded="false" aria-controls="release-filter-options">
    <span><%= render "layouts/admins/icon", name: :search %>筛选条件</span>
    <span class="text-secondary"><%= [@selected_app&.display_name, @filters["in_progress"] == "1" ? "进行中" : MiniProgramRelease::STAGES.dig(@filters["status"], 0)].compact.presence&.join(" · ") || "全部" %></span>
  </button>
  <div id="release-filter-options" class="collapse d-md-block"><div class="list-group list-group-flush">
    <% url_for_filter = ->(changes) { admins_mini_program_releases_path(@filters.merge(changes).compact_blank) } %>
    <% if @apps.any? %>
      <%= render "admins/shared/list_filter_row", label: "小程序", key: "app_id", options: @apps.to_h { |app| [app.id.to_s, app.display_name] }, selected: @filters["app_id"], filter_url: url_for_filter %>
    <% end %>
    <%= render "admins/shared/list_filter_row", label: "发布状态", key: "status",
          options: { "ongoing" => "进行中" }.merge(MiniProgramRelease::STAGES.transform_values(&:first)), selected: @filters["in_progress"] == "1" ? "ongoing" : @filters["status"],
          filter_url: ->(changes) { value = changes["status"]; url_for_filter.call("in_progress" => ("1" if value == "ongoing"), "status" => (value unless value == "ongoing")) } %>
  </div></div>
</section>
<section class="<%= class_names("card", "flex-fill" => @releases.empty?) %>" aria-label="代码列表">
  <div class="card-header flex-shrink-0">
    <%= form_with url: admins_mini_program_releases_path, method: :get, class: "d-flex flex-wrap flex-lg-nowrap align-items-center gap-2 w-100", html: { role: "search" } do |f| %>
      <% @filters.except("q").each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
      <div class="col-12 col-sm-5 col-lg-3 flex-shrink-0">
        <%= f.search_field :q, value: @filters["q"], placeholder: "名称 / AppID / 版本", aria: { label: "搜索代码" }, class: "form-control text-truncate" %>
      </div>
      <%= f.button type: :submit, class: "btn" do %><%= render "layouts/admins/icon", name: :search %>搜索<% end %>
      <% if @filters.any? %><%= link_to admins_mini_program_releases_path, class: "btn" do %><%= render "layouts/admins/icon", name: :rotate %>重置筛选<% end %><% end %>
      <span class="text-secondary ms-sm-auto"><%= @pagy.count %> 条发布记录</span>
    <% end %>
  </div>
  <div class="d-flex flex-column flex-fill" id="release-list" data-source="<%= admins_mini_program_releases_path(@filters.merge(page: @pagy.page, fragment: 1)) %>"><%= render "list" %></div>
</section>
<%= render "dialog" %>
<%= render @upload_apps.any? ? "upload" : "upload_requirements" %>
<%= render "admins/apps/qrcode_modal" %>
