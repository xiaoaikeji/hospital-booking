<div class="modal fade" id="upload-requirements" tabindex="-1" aria-labelledby="upload-requirements-title">
  <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title" id="upload-requirements-title">上传代码</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <% if @upload_scope.empty? %>
      <div class="modal-body">请先登记需要上传代码的微信小程序。</div>
      <div class="modal-footer"><%= link_to "登记应用", new_admins_app_path, class: "btn btn-primary" %></div>
    <% else %>
      <div class="modal-body"><p>请选择目标小程序，完成对应步骤后即可上传。</p>
        <div class="list-group list-group-flush">
          <% @upload_scope.each do |app| %>
            <div class="list-group-item px-0 d-flex align-items-center gap-3">
              <div class="flex-fill text-break"><strong><%= app.display_name %></strong><div class="text-secondary small"><%= app.appid %></div></div>
              <% if app.platform_authorized? %><%= link_to "核实上次操作", admins_mini_program_releases_path(app_id: app.id, in_progress: 1), class: "btn btn-sm" %>
              <% else %><%= link_to "配置平台授权", admins_app_path(app, anchor: "wechat-authorization"), class: "btn btn-sm btn-outline-primary" %><% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div></div>
</div>
