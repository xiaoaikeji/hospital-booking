<% app = release.app; actions = WechatPlatform::ReleaseActions.new(app, release: release, round: release.action_round) %>
<div class="<%= class_names("d-flex flex-wrap gap-1 align-items-center", "justify-content-end" => local_assigns[:detail]) %>">
  <% unless local_assigns[:detail] %><%= link_to release_detail_url(release), class: "btn btn-sm btn-info" do %><%= render "layouts/admins/icon", name: :eye %>查看<% end %><% end %>
  <% if actions.trial? %>
    <%= render "admins/apps/qrcode_button", app: app, trial: release, label: "查看体验码" %>
  <% end %>
  <% if actions.submit? %>
    <button type="button" class="btn btn-sm btn-primary" data-release-dialog="<%= confirmation_admins_mini_program_release_path(release, app_id: app.id, operation: "submit") %>"><%= render "layouts/admins/icon", name: :check %><%= release.latest_audit ? "重新提审" : "提交审核" %></button>
  <% end %>
  <% if actions.retry_upload? %>
    <%= render "admins/mini_program_releases/confirm_action", record: release, action: "retry_upload", method: :post, url: retry_upload_admins_app_release_path(app, release), label: "重新上传", description: "使用模板 ##{release.template_id} 和此版本快照重新生成体验版。", color: "primary" %>
  <% end %>
  <%= render "admins/mini_program_releases/round_actions", release: release, round: release.action_round, actions: actions if release.action_round %>
  <% if actions.verify_upload? %>
    <button type="button" class="btn btn-sm" data-release-dialog="<%= confirmation_admins_mini_program_release_path(release, app_id: app.id, operation: "verify_upload") %>"><%= render "layouts/admins/icon", name: :check %>核实当前体验版</button>
  <% end %>
  <% if !local_assigns[:detail] && actions.delete? %><%= render "admins/mini_program_releases/retire", release: release, delete: true, compact: true %><% end %>
</div>
