<div class="list-group-item">
  <% prefix = "privacy[entries][#{index}]"
     field_error = local_assigns[:field_error]
     key_error = field_error&.message if field_error&.field == "key"
     purpose_error = field_error&.message if field_error&.field == "purpose" %>
  <div class="row g-3">
    <div class="col-12 col-lg-4">
      <label class="form-check mb-1"><%= check_box_tag "#{prefix}[enabled]", "1", entry["enabled"] == "1", id: "privacy-enabled-#{index}", class: "form-check-input" %>
        <span class="form-check-label">声明此项<%= " · 代码已检测" if detected %></span></label>
      <%= label_tag "privacy-key-#{index}", "微信接口标识", class: "form-label" %>
      <%= text_field_tag "#{prefix}[key]", entry["key"], id: "privacy-key-#{index}", readonly: locked_key,
            class: class_names("form-control", "is-invalid" => key_error),
            aria: { invalid: (true if key_error), describedby: ("privacy-key-#{index}-error" if key_error) } %>
      <%= admin_field_error(key_error, id: "privacy-key-#{index}-error") %>
    </div>
    <div class="col-12 col-lg-8">
      <%= label_tag "privacy-purpose-#{index}", "收集用途", class: "form-label" %>
      <%= text_area_tag "#{prefix}[purpose]", entry["purpose"], id: "privacy-purpose-#{index}", rows: 2,
            class: class_names("form-control", "is-invalid" => purpose_error),
            aria: { invalid: (true if purpose_error), describedby: ("privacy-purpose-#{index}-error" if purpose_error) } %>
      <%= admin_field_error(purpose_error, id: "privacy-purpose-#{index}-error") %>
    </div>
  </div>
</div>
