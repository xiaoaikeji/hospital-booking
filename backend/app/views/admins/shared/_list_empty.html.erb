<div class="empty flex-fill h-auto p-4" role="<%= local_assigns.fetch(:role, "status") %>">
  <div>
    <div class="empty-icon mx-auto"><%= render "layouts/admins/icon", name: icon, icon_class: "w-100 h-100" %></div>
    <h2 class="empty-title"><%= title %></h2>
    <% if local_assigns[:description].present? %><p class="empty-subtitle text-secondary text-break"><%= description %></p><% end %>
    <% if local_assigns[:actions].present? %><div class="empty-action"><%= actions %></div><% end %>
  </div>
</div>
