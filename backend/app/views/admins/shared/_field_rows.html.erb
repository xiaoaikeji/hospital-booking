<dl class="<%= class_names("admin-detail-fields mb-0", "admin-detail-fields-three" => local_assigns[:columns] == 3) %>">
  <% fields.each do |label, value| %>
    <div class="<%= class_names("admin-detail-field", "admin-detail-field-wide" => Array(local_assigns[:full]).include?(label)) %>">
      <dt class="text-secondary"><%= label %></dt>
      <dd class="text-break mb-0"><%= value.presence || "—" %></dd>
    </div>
  <% end %>
</dl>
