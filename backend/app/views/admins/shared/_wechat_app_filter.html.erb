<section class="card mb-3 flex-shrink-0" aria-label="小程序筛选条件">
  <button type="button" class="btn d-md-none justify-content-between border-0" data-bs-toggle="collapse" data-bs-target="#wechat-app-options" aria-expanded="false" aria-controls="wechat-app-options">
    <span class="text-nowrap"><%= render "layouts/admins/icon", name: :search %>筛选小程序</span>
    <span class="text-secondary text-truncate ms-2"><%= selected&.display_name || "全部" %></span>
  </button>
  <div id="wechat-app-options" class="collapse d-md-block"><div class="list-group list-group-flush">
    <%= render "admins/shared/list_filter_row", label: "小程序", key: :app_id, options: apps.to_h { |a| [a.id, a.display_name] }, selected: selected&.id, filter_url: filter_url %>
  </div></div>
</section>
