<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <title><%= h(page.fetch(:badge)) %> · Booking 管理后台</title>
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="stylesheet" href="/error-assets/tabler.min.css">
    <link rel="stylesheet" href="/error-assets/tabler-themes.min.css">
    <link rel="stylesheet" href="/error-assets/typography.css">
  </head>
  <body>
    <a href="#content" class="visually-hidden-focusable skip-link">跳转到主要内容</a>
    <script src="/error-assets/tabler-theme.min.js"></script>
    <!-- Generated by script/build_error_pages.rb from the shared error-page template. -->
    <main class="page page-center" id="content">
      <header class="container-xl px-4 pt-4">
        <a href="/admins" class="navbar-brand d-inline-flex align-items-center gap-2 m-0 text-decoration-none" aria-label="Booking 管理后台首页">
          <%= raw(brand_markup) %>
          <span class="fs-2 fw-semibold text-body">Booking</span>
        </a>
      </header>
      <section class="container-xl px-4 py-4 flex-fill d-flex flex-column justify-content-center" aria-labelledby="error-title">
        <div class="row align-items-center g-5">
          <div class="col-lg-5 text-center text-lg-start">
            <div class="mb-3"><span class="badge bg-primary-lt"><%= h(page.fetch(:badge)) %></span></div>
            <h1 class="display-5 fw-bold mb-3" id="error-title" aria-label="<%= h(page.fetch(:heading).join) %>"><% page.fetch(:heading).each do |part| %><span class="d-inline-block"><%= h(part) %></span><% end %></h1>
            <p class="text-secondary fs-3 mb-4"><%= h(page.fetch(:description)) %></p>
            <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3">
              <% page.fetch(:actions).each_with_index do |action, index| %>
              <a href="<%= h(action.fetch(:href)) %>" class="btn btn-lg<%= " btn-primary" if index.zero? %>"<% if action[:external] %> target="_blank" rel="noopener noreferrer"<% end %>>
                <%= raw(icons.fetch(action.fetch(:icon))) %>
                <%= h(action.fetch(:label)) %>
              </a>
              <% end %>
            </div>
          </div>
          <div class="col-lg-7 order-first order-lg-last text-center">
            <%= raw(illustration_markup) %>
          </div>
        </div>
        <% unless page[:browser] %>
        <nav class="mt-4" aria-label="常用入口">
          <ul class="list-inline d-flex flex-wrap justify-content-center justify-content-lg-start gap-3 mb-0">
            <li class="list-inline-item m-0 text-secondary">常用入口：</li>
            <li class="list-inline-item m-0"><a href="/admins/reservations" class="link-secondary">预约列表</a></li>
            <li class="list-inline-item m-0"><a href="/admins/customers" class="link-secondary">客户列表</a></li>
            <li class="list-inline-item m-0"><a href="/admins/components" class="link-secondary">组件规范</a></li>
          </ul>
        </nav>
        <% end %>
      </section>
    </main>
  </body>
</html>
