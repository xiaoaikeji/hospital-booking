<div class="page-header mt-0 mb-3 d-flex flex-row flex-wrap flex-lg-nowrap align-items-center justify-content-between gap-2">
  <%= content_tag local_assigns.fetch(:heading, :h1), class: "page-title fs-1 gap-2 gap-sm-3 overflow-hidden" do %>
    <span class="text-primary d-inline-flex flex-shrink-0"><%= render "layouts/admins/icon", name: icon, icon_class: "w-5 h-5" %></span>
    <span class="text-truncate" title="<%= title %>"><%= title %></span>
  <% end %>
  <div class="d-flex flex-wrap flex-lg-nowrap align-items-center gap-2"><%= yield %></div>
</div>
