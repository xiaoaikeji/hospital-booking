<% content_for :head do %><%= javascript_include_tag "admins/notification_variables", defer: true %><% end %>
<section class="card mt-3" aria-label="可用变量" data-notification-variables>
  <div class="card-header"><h2 class="card-title">可用变量</h2></div>
  <% if fields.empty? %><div class="card-body text-secondary">没有可用变量</div><% else %>
    <div class="card-body py-2 small text-secondary">点击变量插入文字。预览使用示例值，发送时替换为本次真实数据。</div>
    <table class="table table-fixed card-table table-vcenter mb-0"><tbody>
      <% fields.each do |key, field| %><tr>
        <td class="text-break" style="width: 43%"><button type="button" class="btn btn-link p-0 text-start text-break font-monospace" data-insert-variable="<%= key %>" <%= "disabled" if local_assigns[:readonly] %> style="white-space: normal"><code class="text-break" style="white-space: normal">{<%= key %>}</code></button></td>
        <td class="text-break"><%= field['label'] %><% if field['hint'] %><div class="small text-secondary"><%= field['hint'] %></div><% end %></td>
      </tr><% end %>
    </tbody></table>
    <div class="card-footer small text-secondary">变量仅用于文字。要原样显示大括号，请写成 <code>{{变量名}}</code>。</div>
  <% end %>
</section>
