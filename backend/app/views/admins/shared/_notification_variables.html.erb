<% content_for :head do %><%= javascript_include_tag "admins/notification_variables", defer: true %><% end %>
<% drawer_id = local_assigns[:drawer_id] %>
<% options = capture do %>
  <% if fields.empty? %>
    <p class="text-secondary mb-0">没有可用变量</p>
  <% else %>
    <ul class="list-group list-group-flush" aria-label="可用变量">
      <% fields.each do |key, field| %>
        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 px-0">
          <div class="text-break">
            <div class="fw-medium"><%= field.fetch("label") %></div>
            <% if field["hint"] %><div class="small text-secondary"><%= field["hint"] %></div><% end %>
          </div>
          <%= tag.button "{#{key}}", type: "button", class: "btn btn-sm btn-ghost text-primary font-monospace text-wrap text-break",
            disabled: local_assigns[:readonly], data: { insert_variable: key, bs_dismiss: ("offcanvas" if drawer_id) } %>
        </li>
      <% end %>
    </ul>
    <p class="small text-secondary mb-0 mt-3">要原样显示大括号，请写成 <code>{{变量名}}</code>。</p>
  <% end %>
<% end %>

<% if drawer_id %>
  <div class="offcanvas offcanvas-end" tabindex="-1" id="<%= drawer_id %>" aria-labelledby="<%= drawer_id %>-title" data-notification-variables>
    <div class="offcanvas-header">
      <h2 class="offcanvas-title" id="<%= drawer_id %>-title">插入变量</h2>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="关闭变量抽屉"></button>
    </div>
    <div class="offcanvas-body"><%= options %></div>
  </div>
<% else %>
  <section class="card mt-3" aria-label="可用变量" data-notification-variables>
    <div class="card-header"><h2 class="card-title">可用变量</h2></div>
    <div class="card-body"><%= options %></div>
  </section>
<% end %>
