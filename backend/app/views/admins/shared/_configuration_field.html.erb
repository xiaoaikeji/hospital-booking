<%# Existing form and badge components. Required: form, field, label, source. Optional: record, value, choices, secret, placeholder. %>
<% source_label, source_color = configuration_source(source); record = local_assigns[:record]; choices = local_assigns[:choices]; error_id = "#{field}-error" %>
<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
  <%= form.label field, label, class: "form-label mb-0" %>
  <span class="badge bg-<%= source_color %>-lt"><%= source_label %></span>
</div>
<% input_class = choices ? "form-select" : "form-control"; input_class = admin_field_class(record, field, input_class) if record %>
<% if choices %>
  <%= form.select field, choices, { selected: local_assigns[:value] }, class: input_class, aria: { describedby: error_id } %>
<% else %>
  <% placeholder = configuration_placeholder(source, example: local_assigns.fetch(:placeholder, "未配置，请填写")) %>
  <% if local_assigns.fetch(:secret, false) %>
    <%= form.password_field field, value: nil, class: input_class, autocomplete: "new-password", placeholder: placeholder, aria: { describedby: error_id } %>
  <% else %>
    <%= form.text_field field, value: local_assigns[:value], class: input_class, autocomplete: "off", placeholder: placeholder, aria: { describedby: error_id } %>
  <% end %>
<% end %>
<%= admin_field_errors(record, field) if record %>
