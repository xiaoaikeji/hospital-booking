<%# Tabler Datepicker with an explicit trigger for popup inputs. %>
<% inline = local_assigns.fetch(:inline, false) %>
<% error_id = local_assigns[:error_id] %>
<% picker_id = inline ? "#{id}-calendar" : id %>
<% picker_data = { bs_locale: "zh-CN", bs_date_format: "iso", bs_selection_mode: local_assigns.fetch(:selection_mode, "single"), bs_vcp_options: { displayDatesOutside: false } } %>
<% popup_data = picker_data.merge(admin_date_input: true, bs_placement: "auto", bs_vcp_options: picker_data[:bs_vcp_options].merge(openOnFocus: false)) %>
<% if picker_data[:bs_selection_mode] == "multiple-ranged"
     picker_data[:bs_vcp_options][:enableEdgeDatesOnly] = true
     popup_data[:bs_vcp_options][:enableEdgeDatesOnly] = true
   end %>
<div class="input-group">
  <% if local_assigns[:prefix] %><%= label_tag id, prefix, class: "input-group-text text-nowrap px-2" %><% end %>
  <%= tag.input type: "text", class: class_names("form-control", "is-invalid" => error_id), id: id, name: local_assigns[:name],
    value: local_assigns[:value], placeholder: local_assigns.fetch(:placeholder, "选择日期"), autocomplete: "off", required: local_assigns[:required], readonly: inline,
    aria: { required: local_assigns[:required], expanded: (false unless inline), invalid: (true if error_id), describedby: error_id }, data: (popup_data unless inline) %>
  <% if local_assigns.fetch(:clearable, true) %><button type="button" class="btn btn-outline-secondary" data-admin-date-clear="<%= id %>" data-admin-date-picker="<%= picker_id %>" aria-label="清空<%= local_assigns.fetch(:label, "日期") %>">清空</button><% end %>
</div>
<% if inline %><%= tag.div id: picker_id, class: "mt-2", data: picker_data.merge(bs_toggle: "datepicker", bs_inline: true, bs_bound_input: "##{id}", bs_selected_dates: Array(local_assigns[:value].presence)) %><% end %>
