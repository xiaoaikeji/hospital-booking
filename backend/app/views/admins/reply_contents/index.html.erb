<% content_for :title, "回复内容 · Booking 管理后台" %>
<% empty = @replies.empty? %>
<% content_for :fill_content, "true" if empty %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "回复内容", icon: :templates } do %>
  <% if @app %>
    <%= link_to new_admins_app_reply_content_path(@app), class: "btn btn-primary" do %><%= render "layouts/admins/icon", name: :plus %>新增回复内容<% end %>
    <%= link_to edit_admins_app_reply_rules_path(@app), class: "btn" do %><%= render "layouts/admins/icon", name: :settings %>自动回复规则<% end %>
  <% end %>
<% end %>
<%= render "admins/shared/official_account_filter", accounts: @accounts, selected: @app, path: ->(id) { admins_reply_contents_path(app_id: id) } %>
<section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="回复内容列表">
  <% if empty %>
    <%= render "admins/shared/list_empty", icon: :templates, title: "暂无回复内容", description: "选择公众号后，可新增供菜单、渠道码和自动回复使用的内容。" %>
  <% else %>
    <% configuration = Notifications::AccountConfiguration.new(@app) %>
    <table class="table table-fixed table-vcenter card-table table-hover admin-list-table reply-contents-table mb-0">
      <thead><tr>
        <th scope="col" class="list-column-id px-2">ID</th>
        <th scope="col" class="px-2">名称</th>
        <th scope="col" class="col-sm-2 d-none d-sm-table-cell">消息数</th>
        <th scope="col" class="col-sm-2 d-none d-sm-table-cell">使用入口</th>
        <th scope="col" class="list-column-action px-2">操作</th>
      </tr></thead>
      <tbody>
        <% @replies.each do |id, reply| %>
          <% count = configuration.impacts(id).size %>
          <tr>
            <td class="text-secondary px-2"><%= render "admins/shared/list_text", text: "##{id}" %></td>
            <td class="px-2">
              <%= render "admins/shared/list_text", text: reply.fetch("name") %>
              <small class="d-sm-none d-block text-secondary"><%= reply.fetch("messages").size %> 条消息 · <%= count %> 个入口</small>
            </td>
            <td class="d-none d-sm-table-cell"><%= reply.fetch("messages").size %></td>
            <td class="d-none d-sm-table-cell"><%= count %></td>
            <td class="px-2">
              <%= link_to edit_admins_app_reply_content_path(@app, id), class: "btn btn-sm btn-outline-primary text-nowrap" do %><%= render "layouts/admins/icon", name: :edit %>编辑<% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
