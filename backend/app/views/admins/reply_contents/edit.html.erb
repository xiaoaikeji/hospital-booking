<% content_for :title, "#{params[:id] ? '编辑' : '新增'}回复内容 · Booking 管理后台" %>
<% content_for :head do %><%= javascript_include_tag "admins/reply_composer", defer: true %><% end %>
<%= render "admins/shared/enhanced_select_assets" %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "#{params[:id] ? '编辑' : '新增'}回复内容", icon: :templates } do %>
  <% unless params[:inline] == '1' %>
    <%= link_to admins_reply_contents_path(app_id: @app.id), class: "btn" do %><%= render "layouts/admins/icon", name: :arrow_left %>返回列表<% end %>
  <% end %>
<% end %>
<% cover = MediaUpload::PURPOSES.fetch(:reply_card_cover) %>
<div data-reply-editor data-variables="<%= @variable_fields.to_json %>" data-examples="<%= @variable_examples.to_json %>" data-reply="<%= @reply.to_json %>" data-input="<%= @input.to_json %>" data-inline="<%= params[:inline] == '1' %>"
     data-cover-types="<%= cover[:formats].values.uniq.join(',') %>"
     data-save="<%= params[:id] ? admins_app_reply_content_path(@app, params[:id]) : admins_app_reply_contents_path(@app) %>"
     data-image="<%= image_admins_app_reply_contents_path(@app) %>" data-media="<%= media_admins_app_reply_contents_path(@app) %>" data-back="<%= params[:qrcode_id].present? ? edit_admins_app_channel_qrcode_path(@app, params[:qrcode_id]) : admins_reply_contents_path(app_id: @app.id) %>">
  <div class="alert alert-danger" data-reply-error hidden role="alert"></div>
  <div class="row g-3 align-items-start">
    <div class="col-12 col-lg-8"><section class="card">
      <div class="card-header"><h2 class="card-title"><%= @app.display_name %></h2></div><div class="card-body">
        <label class="form-label required" for="reply-name">内容名称</label><div class="mb-3"><input id="reply-name" class="form-control" maxlength="60" value="<%= @reply['name'] %>" placeholder="例如 活动说明" required data-reply-field="name" data-required-message="请填写回复内容名称"></div>
        <%= render "admins/shared/notification_send_interval", value: @reply["send_interval"], hint: "同一粉丝在间隔内只收到一次这组回复。留空或填 0 表示不限。" %>
        <% if params[:id] %>
          <label class="form-label" for="reply-scope">修改范围</label>
          <select id="reply-scope" class="form-select mb-3" data-enhanced-select="single"><option value="only" <%= 'selected' if @input[:scope] == 'only' %>><%= params[:qrcode_id].present? ? '仅改这个码' : '复制为新的回复内容' %></option><option value="all" <%= 'selected' if @input[:scope] == 'all' %>>更新全部</option></select>
          <div data-reply-impacts class="<%= class_names("alert alert-warning", "d-none" => @input[:scope] != "all") %>">
            <div>
              <strong>更新全部将影响以下入口</strong>
              <ul class="mb-0">
                <% @impacts.each do |item| %><li><%= item %></li><% end %>
                <% if @impacts.empty? %><li>暂无已绑定入口</li><% end %>
              </ul>
            </div>
          </div>
        <% end %>
        <%= render "admins/shared/notification_message_items" %>
        <div class="btn-list justify-content-end"><button type="button" class="btn" data-reply-add="text"><%= render "layouts/admins/icon", name: :plus %>新增文字</button><button type="button" class="btn" data-reply-add="miniprogrampage"><%= render "layouts/admins/icon", name: :plus %>新增小程序卡片</button></div>
      </div><div class="card-footer btn-list justify-content-end"><%= render "admins/shared/submit_button", label: "保存", icon: :save, type: "button", data: { reply_save: true } %></div>
    </section></div>
    <div class="col-12 col-lg-4"><section class="card"><div class="card-header"><h2 class="card-title">回复预览</h2></div><div class="card-body bg-body-tertiary" data-reply-preview aria-live="polite"></div></section></div>
  </div>
  <%= render "admins/shared/notification_variables", fields: @variable_fields, drawer_id: "reply-variable-drawer" %>
  <template data-reply-cover-help>
    <%= render "admins/shared/field_help", label: "查看卡片封面要求", text: "JPG 或 PNG，大小不超过 #{cover[:limit] / 1.megabyte} MB。" %>
  </template>
  <template data-reply-card-template>
    <div class="mb-3">
      <label class="form-label required">目标小程序</label>
      <select class="form-select" data-content="appid" data-reply-field="appid" data-required-message="请选择目标小程序"
              data-enhanced-select="search" aria-required="true" required>
        <option value="">请选择目标小程序</option>
        <% @targets.each do |target| %><%= tag.option target.display_name, value: target.appid %><% end %>
      </select>
    </div>
  </template>
</div>
