<% content_for :title, "新增海报 · Booking 管理后台" %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "新增海报", icon: :templates } do %>
  <%= link_to "返回列表", admins_posters_path, class: "btn" %>
<% end %>
<%= form_with model: @poster, url: admins_posters_path, class: "card", data: { admin_form: true } do |f| %>
  <div class="card-header"><h2 class="card-title">上传底图</h2></div>
  <div class="card-body">
    <%= render "admins/shared/form_errors", record: @poster %>
    <div class="row g-3">
      <div class="col-md-6"><%= f.label :name, "海报名称", class: "form-label required" %><%= f.text_field :name, maxlength: 120, size: nil, required: true, class: admin_field_class(@poster, :name) %><%= admin_field_errors(@poster, :name) %></div>
      <div class="col-md-6"><%= render "background_field", form: f %></div>
    </div>
  </div>
  <div class="card-footer btn-list justify-content-end"><%= render "admins/shared/submit_button", label: "保存并设置扫码目标", icon: :save %></div>
<% end %>
