<% content_for :title, "发送记录 · Booking 管理后台" %>
<% content_for :fill_content, "true" if @notifications.empty? %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "发送记录", icon: :bell } do %>
  <%= link_to "微信历史记录", admins_wechat_notifications_path, class: "btn" %>
<% end %>
<section class="card <%= 'flex-fill' if @notifications.empty? %>">
  <% if @notifications.empty? %>
    <%= render "admins/shared/list_empty", icon: :bell, title: "暂无发送记录", description: "触发通知后，在这里查看每条消息的实际内容和处理结果。" %>
  <% else %>
    <table class="table table-fixed table-vcenter card-table table-hover admin-list-table mb-0">
      <thead><tr><th class="list-column-id">ID</th><th>事件</th><th class="d-none d-md-table-cell">目标</th><th class="list-column-status">状态</th><th class="d-none d-lg-table-cell list-column-time">创建时间</th><th class="list-column-action">操作</th></tr></thead>
      <tbody><% @notifications.each do |row| %><tr>
        <td class="text-secondary">#<%= row.id %></td><td><%= render "admins/shared/list_text", text: row.event %></td>
        <td class="d-none d-md-table-cell"><%= render "admins/shared/list_text", text: row.payload.dig("target", "label") || row.payload.dig("target", "channel_key") %></td>
        <td><span class="badge bg-<%= row.uncertain? ? 'warning' : (row.status == 'sent' ? 'success' : 'secondary') %>-lt"><%= row.status_label %></span></td>
        <td class="d-none d-lg-table-cell"><%= admin_list_time(row.created_at) %></td>
        <td><%= link_to admins_notification_path(row), class: "btn btn-sm btn-info" do %><%= render "layouts/admins/icon", name: :eye %>查看<% end %></td>
      </tr><% end %></tbody>
    </table>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { admins_notifications_path(page: page) } %>
  <% end %>
</section>
