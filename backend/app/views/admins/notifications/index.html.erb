<% content_for :title, "发送记录 · Booking 管理后台" %>
<% empty = (@hospital_skips || @interval_skips || @notifications).empty? %>
<% content_for :fill_content, "true" if empty %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "发送记录", icon: :bell } do %>
  <% if WechatNotificationEvent.exists? %><%= link_to admins_wechat_notifications_path, class: "btn" do %><%= render "layouts/admins/icon", name: :history %>微信历史记录<% end %><% end %>
<% end %>
<div class="card mb-3"><div class="list-group list-group-flush">
  <%= render "admins/shared/list_filter_row", label: "记录", key: :view, include_all: false,
        options: { nil => "发送任务", "hospital_skips" => "医院通知登记跳过", "interval_skips" => "公众号间隔跳过" }, selected: params[:view],
        filter_url: ->(filters) { admins_notifications_path(filters.compact) } %>
</div></div>
<% if @hospital_skips %>
  <%= render "hospital_skips", empty: empty %>
<% elsif @interval_skips %>
  <%= render "interval_skips", empty: empty %>
<% else %>
<section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="发送记录">
  <% if empty %>
    <%= render "admins/shared/list_empty", icon: :bell, title: "暂无发送记录", description: "触发通知后，在这里查看每条消息的实际内容和处理结果。" %>
  <% else %>
    <table class="table table-fixed table-vcenter card-table table-hover admin-list-table notification-delivery-table mb-0">
      <thead><tr>
        <th scope="col" class="list-column-id px-2">ID</th>
        <th scope="col" class="px-2">事件</th>
        <th scope="col" class="d-none d-md-table-cell">目标</th>
        <th scope="col" class="list-column-status px-2">状态</th>
        <th scope="col" class="d-none d-lg-table-cell list-column-time px-2">创建时间</th>
        <th scope="col" class="list-column-action px-2">操作</th>
      </tr></thead>
      <tbody>
        <% @notifications.each do |row| %>
          <tr>
            <td class="text-secondary px-2"><%= render "admins/shared/list_text", text: "##{row.id}" %></td>
            <td class="px-2"><%= render "admins/shared/list_text", text: notification_event_label(row.event) %></td>
            <td class="d-none d-md-table-cell"><%= render "admins/shared/list_text", text: row.payload.dig("target", "label") || row.payload.dig("target", "channel_key") %></td>
            <td class="px-2"><%= notification_status_badge(row.delivery_outcome, row.status_label) %></td>
            <td class="d-none d-lg-table-cell px-2 text-nowrap"><%= admin_list_time(row.created_at) %></td>
            <td class="px-2"><%= link_to admins_notification_path(row), class: "btn btn-sm btn-info text-nowrap" do %><%= render "layouts/admins/icon", name: :eye %>查看<% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { admins_notifications_path(page: page) } %>
  <% end %>
</section>
<% end %>
