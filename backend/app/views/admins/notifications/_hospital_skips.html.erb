<section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="医院通知登记跳过">
  <% if empty %>
    <%= render "admins/shared/list_empty", icon: :bell, title: "暂无登记跳过记录", description: "医院通知文案为空或登记失败时，可在这里核对原因。" %>
  <% else %>
    <div class="list-group list-group-flush">
      <% @hospital_skips.each do |entry| %>
        <div class="list-group-item">
          <div class="fw-medium"><%= notification_event_label(entry.details.is_a?(Hash) ? entry.details["event"] : nil) %> · <%= (entry.details.is_a?(Hash) && entry.details["reason"].presence_in(["模板无可发内容", "通知生成或登记失败"])) || "登记已跳过" %></div>
          <% if (number = @order_numbers[entry.target_id]) %><%= link_to number, admins_reservation_path(number) %><% end %>
          <span class="text-secondary"><%= admin_list_time(entry.created_at) %></span>
        </div>
      <% end %>
    </div>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { admins_notifications_path(view: "hospital_skips", page: page) } %>
  <% end %>
</section>
