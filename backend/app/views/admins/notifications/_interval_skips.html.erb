<section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="公众号间隔跳过">
  <% if empty %>
    <%= render "admins/shared/list_empty", icon: :bell, title: "暂无间隔跳过记录", description: "公众号回复因发送间隔跳过后会显示在这里。" %>
  <% else %>
    <table class="table table-fixed table-vcenter card-table admin-list-table mb-0">
      <thead><tr>
        <th scope="col">公众号</th>
        <th scope="col" class="d-none d-md-table-cell">事件</th>
        <th scope="col">回复与原因</th>
        <th scope="col" class="d-none d-lg-table-cell list-column-time">时间</th>
      </tr></thead>
      <tbody><% @interval_skips.each do |entry| %>
        <% account = @accounts[entry.target_id]; event = notification_event_label(entry.details["event"]) %>
        <tr>
          <td>
            <%= render "admins/shared/list_text", text: (account&.display_name || "公众号 ##{entry.target_id}"), url: (admins_app_path(account) if account) %>
            <div class="d-md-none small text-secondary"><%= event %></div>
            <div class="d-lg-none small text-secondary"><%= admin_list_time(entry.created_at) %></div>
          </td>
          <td class="d-none d-md-table-cell"><%= render "admins/shared/list_text", text: event %></td>
          <td class="text-break"><% entry.details.fetch("replies").each do |reply| %>
            <div class="fw-medium"><%= reply["reply_name"] %></div><div class="small text-secondary"><%= reply["reason"] %></div>
          <% end %></td>
          <td class="d-none d-lg-table-cell text-nowrap"><%= admin_list_time(entry.created_at) %></td>
        </tr>
      <% end %></tbody>
    </table>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { admins_notifications_path(view: "interval_skips", page: page) } %>
  <% end %>
</section>
