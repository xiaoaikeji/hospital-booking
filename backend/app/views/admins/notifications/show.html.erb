<% content_for :title, "通知 ##{@notification.id} · Booking 管理后台" %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "通知 ##{@notification.id}", icon: :bell } do %>
  <%= link_to admins_notifications_path, class: "btn" do %><%= render "layouts/admins/icon", name: :arrow_left %>返回列表<% end %>
<% end %>
<div class="card mb-3"><div class="card-body">
  <%= render "admins/shared/field_rows", fields: {
    "事件" => notification_event_label(@notification.event),
    "状态" => notification_status_badge(@notification.uncertain? ? "uncertain" : @notification.status, @notification.status_label),
    "执行次数" => @notification.attempt_count.to_s,
    "事件标识" => @notification.event,
    "渠道标识" => @notification.payload.dig("target", "channel_key"),
    "目标" => @notification.payload.dig("target", "label") || @notification.payload.dig("target", "channel_key")
  }, full: ["目标"] %>
</div></div>
<% if @notification.uncertain? %><div class="alert alert-warning">有消息待核实。请求已发出但没有可靠回执，请先到渠道核对；系统不会自动补发。</div><% end %>
<% @notification.messages.each_with_index do |message, i| %>
  <% result = @notification.result_for(message["id"]) %>
  <section class="card mb-3"><div class="card-header"><h2 class="card-title">第 <%= i + 1 %> 条 · <%= message["type"] == 'text' ? '文字' : (message['type'] == 'template' ? '微信模板消息' : '小程序卡片') %></h2></div>
    <div class="card-body">
      <% if message['type'] == 'text' %>
        <div class="mb-3 text-break" style="white-space: pre-wrap"><%= message.dig('content', 'text') %></div>
      <% else %>
        <% content = message['content'] %>
        <% fields = if message['type'] == 'miniprogrampage'
             { '卡片标题' => content['title'], '小程序' => content['appid'], '页面路径' => content['pagepath'], '封面素材' => content['thumb_media_id'] }
           else
             { '微信模板' => message['title'].presence || content['template_id'] }.merge(content.fetch('data', {}).to_h { |key, value| [(message['fields'] || {}).fetch(key, key), value['value']] })
           end %>
        <div class="mb-3"><%= render 'admins/shared/field_rows', fields: fields %></div>
      <% end %>
      <% status = result.fetch("status")
         badge = if status == "sending" && result["provider_state"] == "passive_prepared"
           notification_status_badge(status, "应答已生成（接收未确认）")
         elsif status == "sending"
           notification_status_badge("uncertain", "待核实")
         else
           notification_status_badge(status)
         end
         stage = { "request_started" => "已发起请求", "channel_accepted" => "渠道已接受", "channel_rejected" => "渠道明确拒绝",
                   "validation_failed" => "发送前校验失败", "awaiting_verification" => "等待核实渠道结果",
                   "passive_response" => "已生成回调文字应答，微信接收待核实" }.fetch(result["stage"], "等待处理")
         fields = { "状态" => badge, "处理步骤" => stage, "尝试次数" => result["attempt_count"].to_s }
         fields["原因"] = result["error_message"] if result["error_message"].present? %>
      <%= render "admins/shared/field_rows", fields: fields, full: ["原因"] %>
      <% if result['history'].present? %><details class="mt-2"><summary>之前的尝试</summary><% result['history'].each do |attempt| %><p class="mb-1 mt-2 text-break"><%= attempt['last_attempt_at'] %> · <%= attempt['error_message'] || attempt['stage'] %></p><% end %></details><% end %>
    </div>
    <% if result['status'] == 'failed' %><div class="card-footer"><%= form_with url: retry_failed_admins_notification_path(@notification), class: "btn-list justify-content-end", data: { admin_form: true } do %>
      <%= hidden_field_tag 'message_ids[]', message['id'] %><%= render "admins/shared/submit_button", label: "仅补发这一条", icon: :rotate %>
    <% end %></div><% end %>
  </section>
<% end %>
