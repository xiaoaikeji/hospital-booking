<div class="col-md-6 col-xl-4">
  <%= f.label :main_title, "职称", class: "form-label" %>
  <%= f.text_field :main_title, maxlength: 100, class: admin_field_class(@entry, :main_title), aria: { describedby: ("main_title-error" if @entry.errors[:main_title].any?) } %>
  <%= admin_field_errors(@entry, :main_title) %>
</div>
<div class="col-md-6">
  <%= f.label :department_ids, "所属科室", class: "form-label" %>
  <%= f.select :department_ids, @department_options, { selected: @selected_department_ids },
    multiple: true, class: admin_field_class(@entry, :department_ids, "form-select"), data: { enhanced_select: "multiple" },
    aria: { describedby: ("department_ids-error" if @entry.errors[:department_ids].any?) } %>
  <%= admin_field_errors(@entry, :department_ids) %>
</div>
<div class="col-md-6 col-xl-4">
  <div class="d-flex align-items-center gap-1 mb-2">
    <%= f.label :fee, "挂号费", class: "form-label required mb-0" %>
    <%= render "admins/shared/field_help", label: "查看挂号费说明", text: "同一位医生在各科室共用此金额。填 0 元表示免挂号费。" %>
  </div>
  <div class="input-group">
    <%= f.number_field :fee, required: true, step: "0.01", min: "0", max: "99999999.99", class: admin_field_class(@entry, :fee),
      aria: { describedby: ("fee-error" if @entry.errors[:fee].any?) } %>
    <span class="input-group-text">元</span>
  </div>
  <%= admin_field_errors(@entry, :fee) %>
</div>
<div class="col-12">
  <%= f.label :good_in, "擅长", class: "form-label" %>
  <%= f.text_area :good_in, rows: 2, class: "form-control" %>
</div>
<div class="col-12">
  <%= f.label :introduction, "简介", class: "form-label" %>
  <%= f.text_area :introduction, rows: 4, class: "form-control" %>
</div>
<div class="col-12">
  <label class="form-check form-switch mb-0"><%= f.check_box :display_on_homepage, { class: "form-check-input", role: "switch" } %><span class="form-check-label">首页展示</span></label>
</div>
