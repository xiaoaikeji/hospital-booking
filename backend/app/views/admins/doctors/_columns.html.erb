<% if entry %>
  <td class="directory-title px-2"><%= render "admins/shared/list_text", text: main_title %></td>
  <td class="directory-secondary px-2"><%= render "admins/shared/list_text", text: department_names %></td>
  <td class="directory-fee px-2 text-nowrap"><%= render "admins/shared/list_text", text: "#{entry.fee_in_yuan} 元" %></td>
<% else %>
  <th scope="col" class="directory-title px-2">职称</th>
  <th scope="col" class="directory-secondary px-2">所属科室</th>
  <th scope="col" class="directory-fee px-2" aria-sort="<%= { "fee_asc" => "ascending", "fee_desc" => "descending" }.fetch(@filters[:sort], "none") %>">
    <%= form_with url: admins_doctors_path, method: :get, id: "doctor-fee-sort" do %>
      <% @filters.except(:sort).each do |key, value| %>
        <%= hidden_field_tag key, value, id: nil %>
      <% end %>
      <%= render "admins/doctors/fee_sort" %>
    <% end %>
  </th>
<% end %>
