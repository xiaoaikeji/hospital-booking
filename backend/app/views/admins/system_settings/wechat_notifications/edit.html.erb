<% content_for :title, "微信通知设置 · Booking 管理后台" %>
<%= render "admins/system_settings/navigation", title: "微信通知设置" %>
<%= form_with scope: :notification_settings, url: admins_system_settings_wechat_notifications_path, method: :patch, class: "card admin-form-card" do |f| %>
  <div class="card-header flex-wrap gap-2"><h2 class="card-title">企业微信群与定时同步</h2><div class="card-actions">
    <%= link_to admins_wechat_notifications_path, class: "btn" do %><%= render "layouts/admins/icon", name: :history %>通知记录<% end %>
  </div></div>
  <div class="card-body">
    <% if @settings.error %><p class="alert alert-danger" role="alert"><%= @settings.error %></p><% end %>
    <%= f.hidden_field :revision, value: @input&.fetch(:revision, nil) || @settings.revision %>
    <div class="mb-4"><label class="form-check form-switch">
      <%= f.check_box :pull_violations, checked: @input ? @input[:pull_violations] == "1" : @settings.pull, class: "form-check-input" %>
      <span class="form-check-label">定时同步违规与申诉记录</span></label>
      <div class="form-hint">每 30 分钟查询已授权小程序。首次同步的历史记录仅供查阅。</div>
    </div>
    <div class="mb-4 col-lg-8"><%= f.label :webhook_key, "企业微信群机器人 Key", class: "form-label" %>
      <%= f.text_field :webhook_key, value: @input&.fetch(:webhook_key, nil) || @settings.key, class: "form-control", autocomplete: "off", spellcheck: false %>
      <div class="form-hint">当前来源：<%= @settings.source %>。支持 Key 或完整 Webhook 地址。</div>
      <% if @settings.source == "加密数据库" %><label class="form-check mt-2"><%= f.check_box :clear_key, class: "form-check-input" %><span class="form-check-label">清除已保存的 Key，回退到部署配置</span></label><% end %>
    </div>
    <fieldset><legend class="form-label">发送到企业微信群的事件</legend><div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-2">
      <% selected = @input ? Array(@input[:kinds]) : @settings.kinds %>
      <% WechatPlatform::NotificationSettings::LABELS.each do |kind, label| %><div class="col"><label class="form-check mb-0">
        <%= check_box_tag "notification_settings[kinds][]", kind, selected.include?(kind), id: "notify_#{kind}", class: "form-check-input" %>
        <span class="form-check-label"><%= label %></span></label></div><% end %>
    </div></fieldset>
  </div>
  <div class="card-footer"><%= f.button class: "btn btn-primary" do %><%= render "layouts/admins/icon", name: :check %>保存设置<% end %></div>
<% end %>
