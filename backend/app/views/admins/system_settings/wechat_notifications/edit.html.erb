<% content_for :title, "微信通知设置 · Booking 管理后台" %>
<%= render "admins/system_settings/navigation", title: "微信通知设置" %>
<% can_clear = @settings.source == "加密数据库"; revision = @settings.revision %>
<% history_link = capture do %>
  <%= link_to edit_admins_system_settings_wecom_notification_content_path, class: "btn" do %><%= render "layouts/admins/icon", name: :edit %>通知文案<% end %>
  <%= link_to admins_wechat_notifications_path, class: "btn" do %><%= render "layouts/admins/icon", name: :history %>通知记录<% end %>
<% end %>
<%= form_with scope: :notification_settings, url: admins_system_settings_wechat_notifications_path, method: :patch, class: "card", data: { admin_form: true } do |f| %>
  <%= f.hidden_field :revision, value: @input&.fetch(:revision, nil) || revision %>
  <%= render layout: "admins/shared/configuration_card", locals: { title: "企业微信群与定时同步", record: @settings, header_actions: history_link,
        clear_target: "#clear-notification-configuration", clear_disabled: !can_clear } do %>
    <div class="row g-4">
      <div class="col-12 d-flex align-items-center gap-1">
        <label class="form-check form-switch mb-0">
          <%= f.check_box :pull_violations, checked: @input ? @input[:pull_violations] == "1" : @settings.pull, class: "form-check-input" %>
          <span class="form-check-label">定时同步违规与申诉记录</span>
        </label>
        <%= render "admins/shared/field_help", text: "每 30 分钟查询已授权小程序。首次同步的历史记录仅供查阅。", label: "查看定时同步说明" %>
      </div>
      <div class="col-lg-8">
        <%= render "admins/shared/configuration_field", form: f, record: @settings, field: :webhook_key, label: "企业微信群机器人 Key",
              source: @settings.source, value: @input&.fetch(:webhook_key, nil) || @settings.key,
              placeholder: "请输入 Key 或完整 Webhook 地址", help: ("可填写机器人 Key 或完整 Webhook 地址。留空保留当前来源。" if @settings.key.present?) %>
      </div>
      <fieldset class="col-12">
        <legend class="form-label">发送到企业微信群的事件</legend>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-2">
          <% selected = @input ? Array(@input[:kinds]) : @settings.kinds %>
          <% WechatPlatform::NotificationSettings::LABELS.each do |kind, label| %>
            <div class="col"><label class="form-check mb-0">
              <%= check_box_tag "notification_settings[kinds][]", kind, selected.include?(kind), id: "notify_#{kind}", class: "form-check-input" %>
              <span class="form-check-label"><%= label %></span>
            </label></div>
          <% end %>
        </div>
      </fieldset>
    </div>
  <% end %>
<% end %>
<% if can_clear %>
  <%= form_with scope: :notification_settings, url: admins_system_settings_wechat_notifications_path, method: :patch,
        id: "clear-notification-configuration-form", class: "d-none" do |f| %>
    <%= f.hidden_field :revision, value: revision, id: nil %>
    <%= f.hidden_field :clear_key, value: "1", id: nil %>
  <% end %>
  <%= render "admins/shared/confirmation_modal", modal_id: "clear-notification-configuration", form_id: "clear-notification-configuration-form",
      title: "确认清除系统配置", context: "企业微信群机器人 Key",
      description: "清除数据库中的 Key 后，将按环境变量、Rails credentials 的顺序读取。定时同步和通知事件仍按已保存的设置运行。",
      color: "warning", confirm_label: "确认清除", confirm_icon: :trash, cancel_icon: :close %>
<% end %>
