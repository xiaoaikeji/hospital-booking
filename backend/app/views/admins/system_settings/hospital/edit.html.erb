<% content_for :title, "医院资料 · Booking 管理后台" %>
<%= render "admins/system_settings/navigation", title: "医院资料" %>
<% image = { asset: image_admins_system_settings_hospital_path, title: "医院图片" } if @profile.record&.hospital_image&.attached? %>
<% cancel = capture do %>
  <%= link_to edit_admins_system_settings_hospital_path, class: "btn" do %>
    <%= render "layouts/admins/icon", name: :close %>取消
  <% end %>
<% end %>
<%= form_with model: @profile, scope: :hospital, url: admins_system_settings_hospital_path, method: :patch, class: "card", data: { admin_form: true } do |f| %>
  <%= render layout: "admins/shared/configuration_card", locals: { title: "医院介绍", record: @profile,
    title_help: "这些资料会展示在小程序「我的 → 了解我院」。", footer_actions: cancel,
    footer_actions_class: "pe-6 pe-md-5" } do %>
    <div class="row g-4 py-1">
      <div class="col-xl-8 d-flex flex-column gap-4">
        <div class="row g-4">
          <div class="col-md-6">
            <%= f.label :company_name, "医院名称", class: "form-label" %>
            <%= f.text_field :company_name, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= f.label :mobile, "电话", class: "form-label" %>
            <%= f.telephone_field :mobile, class: "form-control", placeholder: "例如 010-00000000" %>
          </div>
          <div class="col-md-6">
            <%= f.label :address, "地址", class: "form-label" %>
            <%= f.text_field :address, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= f.label :time_range, "营业时间", class: "form-label" %>
            <%= f.text_field :time_range, class: "form-control", placeholder: "例如 周一至周六 08:00–17:30" %>
          </div>
        </div>
        <div class="d-flex flex-column flex-fill">
          <%= f.label :introduction, "医院简介", class: "form-label" %>
          <%= f.text_area :introduction, class: "form-control flex-fill", rows: 4 %>
        </div>
      </div>
      <div class="col-md-8 col-xl-4 order-first order-xl-last">
        <%= render "admins/shared/single_image_field", form: f, image: image, label: "医院图片",
          limit: MediaUpload::PURPOSES.fetch(:hospital_image).fetch(:limit) / 1.megabyte,
          modal_id: "hospital-image", variant: :tile, ratio: "ratio-16x9", panel: true,
          size_hint: "建议使用 16:9 的横图。" %>
      </div>
    </div>
  <% end %>
<% end %>
<%= render "admins/shared/image_modal", image: image, modal_id: "hospital-image" if image %>
