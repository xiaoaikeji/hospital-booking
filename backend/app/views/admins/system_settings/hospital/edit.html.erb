<% content_for :title, "医院资料 · Booking 管理后台" %>
<%= render "admins/system_settings/navigation", title: "医院资料" %>
<% has_image = @profile.record&.hospital_image&.attached? %>
<% image = { asset: image_admins_system_settings_hospital_path, title: "医院图片" } if has_image %>
<%= form_with model: @profile, scope: :hospital, url: admins_system_settings_hospital_path, method: :patch, class: "card", data: { admin_form: true } do |f| %>
  <%= render layout: "admins/shared/configuration_card", locals: { title: "医院介绍", record: @profile } do %>
    <div class="row g-3">
      <div class="col-md-6">
        <%= f.label :company_name, "医院名称", class: "form-label" %>
        <%= f.text_field :company_name, class: "form-control" %>
      </div>
      <div class="col-md-6">
        <%= f.label :address, "地址", class: "form-label" %>
        <%= f.text_field :address, class: "form-control" %>
      </div>
      <div class="col-md-6">
        <%= f.label :mobile, "电话", class: "form-label" %>
        <%= f.telephone_field :mobile, class: "form-control" %>
      </div>
      <div class="col-md-6">
        <%= f.label :time_range, "营业时间", class: "form-label" %>
        <%= f.text_field :time_range, class: "form-control", placeholder: "例如 周一至周六 08:00–17:30" %>
      </div>
      <div class="col-md-6">
        <div class="d-flex align-items-center gap-1 mb-2">
          <%= f.label :image, "医院图片", class: "form-label mb-0" %>
          <%= render "admins/shared/field_help", label: "查看图片要求", text: "支持 JPG、PNG 和 WebP，单张最多 10 MB。" %>
        </div>
        <% if has_image %>
          <div class="mb-2"><%= render "admins/shared/image_thumbnail", image: image, modal_id: "hospital-image" %></div>
        <% end %>
        <%= f.file_field :image, accept: "image/jpeg,image/png,image/webp", class: admin_field_class(@profile, :image),
          aria: { describedby: ("image-error" if @profile.errors[:image].any?) } %>
        <%= admin_field_errors(@profile, :image) %>
        <% if has_image %>
          <label class="form-check mt-2 mb-0"><%= f.check_box :remove_image, { class: "form-check-input", checked: params.dig(:hospital, :remove_image) == "1" } %><span class="form-check-label">移除当前图片</span></label>
        <% end %>
      </div>
      <div class="col-12">
        <%= f.label :introduction, "医院简介", class: "form-label" %>
        <%= f.text_area :introduction, class: "form-control", rows: 5 %>
      </div>
    </div>
  <% end %>
<% end %>
<%= render "admins/shared/image_modal", image: image, modal_id: "hospital-image" if has_image %>
