<% content_for :title, "医院资料 · Booking 管理后台" %>
<%= render "admins/system_settings/navigation", title: "医院资料" %>
<% image = { asset: image_admins_system_settings_hospital_path, title: "医院图片" } if @profile.record&.hospital_image&.attached? %>
<%= form_with model: @profile, scope: :hospital, url: admins_system_settings_hospital_path, method: :patch, class: "card", data: { admin_form: true } do |f| %>
  <%= render layout: "admins/shared/configuration_card", locals: { title: "医院介绍", record: @profile,
    title_help: "这些资料会展示在小程序「我的 → 了解我院」。" } do %>
    <div class="row g-4 align-items-start">
      <div class="col-xl-8">
        <div class="row g-3">
          <div class="col-md-7">
            <%= f.label :company_name, "医院名称", class: "form-label" %>
            <%= f.text_field :company_name, class: "form-control" %>
          </div>
          <div class="col-md-5">
            <%= f.label :mobile, "电话", class: "form-label" %>
            <%= f.telephone_field :mobile, class: "form-control" %>
          </div>
          <div class="col-md-7">
            <%= f.label :address, "地址", class: "form-label" %>
            <%= f.text_field :address, class: "form-control" %>
          </div>
          <div class="col-md-5">
            <%= f.label :time_range, "营业时间", class: "form-label" %>
            <%= f.text_field :time_range, class: "form-control", placeholder: "例如 周一至周六 08:00–17:30" %>
          </div>
          <div class="col-12">
            <%= f.label :introduction, "医院简介", class: "form-label" %>
            <%= f.text_area :introduction, class: "form-control", rows: 5 %>
          </div>
        </div>
      </div>
      <div class="col-md-8 col-xl-4">
        <div class="form-fieldset mb-0">
          <%= render "admins/shared/single_image_field", form: f, image: image,
            label: "医院图片", limit: 10, modal_id: "hospital-image", variant: :tile, ratio: "ratio-16x9" %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
<%= render "admins/shared/image_modal", image: image, modal_id: "hospital-image" if image %>
