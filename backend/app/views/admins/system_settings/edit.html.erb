<% content_for :title, "系统设置 · Booking 管理后台" %>
<% sources = StorageSettings::FIELDS.keys.index_with { |field| @settings.source(field) } %>
<% revision = @settings.revision; can_clear = sources.values.any? { |source| source.start_with?("系统配置") } %>
<% service = @settings.form_value("service", source: sources.fetch("service")) || "local"; cos_enabled = service == "tencent_cos" %>
<div class="page-header mt-0 mb-3"><h1 class="page-title fs-1 gap-3"><span class="text-primary d-inline-flex"><%= render "layouts/admins/icon", name: :settings, icon_class: "w-5 h-5" %></span>系统设置</h1></div>
<%= form_with url: admins_system_settings_path, scope: :storage_settings, method: :patch, class: "card", data: { admin_form: true, storage_settings: true } do |form| %>
  <%= form.hidden_field :revision, value: revision %>
  <%= render layout: "admins/shared/configuration_card", locals: { title: "文件存储", record: @settings, clear_target: "#clear-storage-settings-confirmation", clear_disabled: !can_clear } do %>
    <div class="row g-3">
      <div class="col-md-6 col-xl-4" data-storage-service>
        <%= render "admins/shared/configuration_field", form: form, record: @settings, field: "service", label: "存储方式", source: sources.fetch("service"), value: service, choices: [["本地存储", "local"], ["腾讯云 COS", "tencent_cos"]] %>
      </div>
      <% StorageSettings::LABELS.except("service").each do |field, label| %>
        <% source = sources.fetch(field); secret = StorageSettings::SECRETS.include?(field) %>
        <% form_value = (@settings.form_value(field, source: source) unless secret) %>
        <% fallback_value = (@settings.read(field) if !secret && ["环境变量", "Rails credentials"].include?(source)) %>
        <fieldset class="col-md-6 col-xl-4" data-storage-cos-fields <%= tag.attributes(hidden: !cos_enabled, disabled: !cos_enabled) %>>
          <%= render "admins/shared/configuration_field", form: form, record: @settings, field: field, label: label, source: source, value: form_value, secret: secret, fallback_value: fallback_value, placeholder: ({"secret_id" => "请输入 SecretId", "secret_key" => "请输入 SecretKey", "region" => "例如 ap-shanghai", "bucket" => "例如 booking-1234567890", "endpoint" => "留空按地域生成 HTTPS API 地址"}.fetch(field)) %>
        </fieldset>
      <% end %>
    </div>
  <% end %>
<% end %>
<%= form_with url: admins_system_settings_path, scope: :storage_settings, method: :patch, id: "clear-storage-settings", class: "d-none", data: { admin_form: true } do |form| %>
  <%= form.hidden_field :revision, value: revision, id: "clear-storage-settings-revision" %>
  <% StorageSettings::FIELDS.each_key do |field| %><%= hidden_field_tag "storage_settings[clear_fields][]", field, id: nil %><% end %>
<% end %>
<%= render "admins/shared/confirmation_modal", modal_id: "clear-storage-settings-confirmation", title: "确认清除系统配置", context: "文件存储", description: "清除本页的系统配置后，将按 ENV、credentials 读取；存储方式无其他配置时恢复本地存储。", confirm_label: "确认清除", color: "warning", confirm_icon: :trash, cancel_icon: :close, form_id: "clear-storage-settings" %>
