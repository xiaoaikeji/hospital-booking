<% content_for :title, "预约设置 · Booking 管理后台" %>
<% content_for :head do %><%= javascript_include_tag "admins/appointment_settings", defer: true %><% end %>
<%= render "admins/shared/enhanced_select_assets" %>
<%= render "admins/system_settings/navigation", title: "预约设置" %>
<%= form_with scope: :appointment, url: admins_system_settings_appointment_path, method: :patch, class: "card", data: { admin_form: true } do |f| %>
  <%= f.hidden_field :revision, value: @settings.revision %>
  <%= render layout: "admins/shared/configuration_card", locals: { title: "预约规则", record: @settings } do %>
    <% rules = [
      [AppointmentSettings::PHONE_FIELD, "预约前验证微信手机号", "每个账号只需验证一次。给家人预约时，联系电话可以填家人的号码。"],
      [Schedule::NIGHT_SETTING, "启用晚班", "关闭后，排班日历和小程序会隐藏晚班。已有晚班会保留，重新启用后可见。"],
      ["show_unscheduled_doctors", "按日期显示未排班医生", "关闭后，预约挂号的「按日期」只列当天实际出诊的医生。"],
      ["require_booking_remark", "预约时症状必填", "开启后，患者需填写症状描述才能确认预约。"],
      ["display_free_fee_when_fee_is_zero", "零元挂号显示「免费」", "关闭后，预约表单收起零元医生的挂号费一行。"],
      ["display_hospital_address", "预约页显示就诊地址", "开启后在预约表单显示「医院资料」中填写的地址。"],
      [AppointmentSettings::TIME_SLOT_FIELD, "启用分时预约", "患者可选择一个 30 分钟时段。各时段共用所属班次的号源。"]
    ] %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 gx-4 gy-3 align-items-center">
      <% rules.each do |field, label, help| %>
        <div class="col d-flex align-items-center gap-1">
          <label class="form-check form-switch mb-0">
            <%= f.check_box field, checked: @settings.enabled?(field), class: "form-check-input",
              aria: { controls: ("appointment-slot-capacity" if field == AppointmentSettings::TIME_SLOT_FIELD) } %>
            <span class="form-check-label"><%= label %></span>
          </label>
          <%= render "admins/shared/field_help", label: "查看#{label}说明", text: help %>
        </div>
      <% end %>
    </div>
    <div class="row g-3 mt-3">
      <div class="col-sm-6 col-xl-4">
        <div class="d-flex align-items-center gap-1 mb-2">
          <%= f.label :default_capacity, "默认放号数", class: "form-label mb-0" %>
          <%= render "admins/shared/field_help", label: "查看默认放号数说明", text: "整班预约时，号数留空的班次使用此值。" %>
        </div>
        <%= f.number_field :default_capacity, value: @settings.default_capacity, class: "form-control",
          min: 1, max: 2_147_483_647, step: 1, required: true %>
      </div>
      <div id="appointment-slot-capacity" class="<%= class_names("col-sm-6 col-xl-4", "d-none" => !@settings.time_slot_booking?) %>">
        <%= f.label AppointmentSettings::SLOT_CAPACITY_FIELD, "每 30 分钟最多可约人数", class: "form-label" %>
        <%= f.number_field AppointmentSettings::SLOT_CAPACITY_FIELD, value: @settings.max_bookings_per_slot,
          class: "form-control", min: 1, max: 2_147_483_647, step: 1, required: true, disabled: !@settings.time_slot_booking? %>
      </div>
    </div>
    <fieldset class="mt-4">
      <legend class="form-label">班次时间</legend>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3">
        <% AppointmentSettings::SHIFT_TIME_DEFAULTS.each do |shift, fields| %>
          <% name = ScheduleCalendar::SHIFT_LABELS.fetch(shift) %>
          <div class="col"><div class="row g-2">
            <% fields.keys.zip(%w[开始 结束]).each do |field, boundary| %>
              <div class="col-6">
                <%= f.label field, "#{name}#{boundary}", class: "form-label" %>
                <% choices = boundary == "开始" ? AppointmentSettings::SLOT_TIMES[0...-1] : AppointmentSettings::SLOT_TIMES.drop(1) %>
                <%= f.select field, choices, { selected: @settings.shift_time(field) },
                  class: "form-select", data: { enhanced_select: "single" } %>
              </div>
            <% end %>
          </div></div>
        <% end %>
      </div>
    </fieldset>
    <div class="mt-4">
      <div class="d-flex align-items-center gap-1 mb-2">
        <%= f.label :booking_notice, "预约须知", class: "form-label mb-0" %>
        <%= render "admins/shared/field_help", label: "查看预约须知的展示位置",
          text: "填写并保存后，患者可在小程序首页和预约表单查看。清空并保存后收起。" %>
      </div>
      <%= f.text_area :booking_notice, value: @settings.booking_notice, class: "form-control", rows: 4 %>
    </div>
  <% end %>
<% end %>
