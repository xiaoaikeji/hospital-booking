<% content_for :title, "微信支付 · Booking 管理后台" %>
<%= render "admins/shared/enhanced_select_assets" %>
<% content_for :head do %><%= javascript_include_tag "admins/wechat_pay_settings", defer: true %><% end %>
<%= render "admins/system_settings/navigation", title: "微信支付" %>
<% version = @submitted&.[]("version") || @settings.value("version") %>
<% form_fields = @settings.form_fields(@submitted)
   changing_merchant = @settings.changing_merchant?(@submitted&.[]("merchant_id"))
   has_backup = WechatPaySettings::BACKUP.any? { |field| form_fields.fetch(field).first.present? }
   backup_open = has_backup || WechatPaySettings::BACKUP.any? { |field| @settings.errors[field].any? } %>
<% versions = WechatPaySettings::VERSIONS.map { |id, name| [name, id] }
   versions.unshift(["请选择接口版本", "", { disabled: true }]) unless WechatPaySettings::VERSIONS.key?(version) %>
<% help = {
  "version" => "新单使用所选版本。旧单保留原商户和版本，使用该商户更新后的凭据。",
  "merchant_id" => "保留原商户时，凭据留空沿用原配置。更换商户号时，请从新商户的微信支付商户平台取得密钥、证书和验签材料。",
  "notify_origin" => "填写微信服务器可访问的医院后台 HTTPS 域名。",
  "v2_certificate" => "收款时可留空。发起退款前粘贴有效的 apiclient_cert.pem 及配套私钥。",
  "v2_private_key" => "收款时可留空。发起退款前粘贴与商户 API 证书配套的 apiclient_key.pem。",
  "merchant_serial" => "填写签发商户私钥所对应的 API 证书序列号。",
  "v3_private_key" => "粘贴商户 API 证书配套的 apiclient_key.pem，用于请求和收银台签名。",
  "verification_id" => "公钥模式填写 PUB_KEY_ID_ 开头的 ID，平台证书模式填写该证书的序列号。",
  "verification_pem" => "粘贴与所填 ID 对应的微信支付公钥或平台证书 PEM，用于验证微信应答和通知。"
} %>
<%= form_with scope: :wechat_pay, url: admins_system_settings_wechat_pay_path, method: :patch, class: "card", data: { admin_form: true, wechat_pay_settings: true, configured_merchant: @settings.value("merchant_id") } do |f| %>
  <%= f.hidden_field :revision, value: @submitted&.[]("revision") || @settings.revision %>
  <%= render layout: "admins/shared/configuration_card", locals: { title: "普通商户直连", record: @settings, clear_target: "#clear-wechat-pay", clear_disabled: !@settings.stored? } do %>
    <div <%= tag.attributes(class: "alert alert-info mb-3", data: { merchant_change: true }, role: "status", hidden: !changing_merchant) %>>
      <span data-merchant-version="v2" <%= "hidden" unless version == "v2" %>>请填写新商户的 APIv2 密钥。需要退款时，再补齐该商户的 API 证书和配套私钥。</span>
      <span data-merchant-version="v3" <%= "hidden" unless version == "v3" %>>请填写新商户的 APIv3 密钥、商户证书序列号和签名私钥。验签材料请从新商户平台取得，填写公钥 ID 与公钥，或该商户的平台证书序列号与证书。</span>
    </div>
    <div class="row g-3 row-cols-1 row-cols-md-2 <%= version == "v2" ? "row-cols-xl-4" : "row-cols-xl-3" %>" data-payment-fields>
      <% WechatPaySettings::LABELS.except(*WechatPaySettings::BACKUP).each do |field, label| %>
        <% group = WechatPaySettings::MATERIAL.find { |_version, fields| fields.include?(field) }&.first
           inactive = group && group != version
           multiline = %w[v2_certificate v2_private_key v3_private_key verification_pem].include?(field)
           value, source = form_fields.fetch(field)
           optional = WechatPaySettings::V2_TLS.include?(field)
           configured = @settings.value(field).present?
           required = !optional && (!configured || (group.present? && changing_merchant))
           credential_requirement = if group && !optional
             configured ? "new-merchant" : "always"
           end %>
        <fieldset <%= tag.attributes(class: ("col-xl-6" if multiline), hidden: inactive, disabled: inactive,
              data: { payment_version: group, merchant_credential: (true if group), credential_requirement: credential_requirement }) %>>
          <%= render "admins/shared/configuration_field", form: f, record: @settings, field: field, label: label,
                source: source, optional: optional, required: required, value: value, help: help[field], rows: (4 if multiline),
                placeholder: (field == "notify_origin" ? "https://booking.example.org" : ""),
                choices: (versions if field == "version"), enhanced_select: "single" %>
        </fieldset>
      <% end %>
    </div>
    <% if WechatPaySettings::V2_TLS.any? { |field| @settings.value(field).present? } %>
      <fieldset <%= tag.attributes(class: "mt-3", data: { payment_version: "v2", original_merchant: true }, hidden: changing_merchant || version != "v2", disabled: changing_merchant || version != "v2") %>>
        <% if (problem = @settings.v2_refund_problem) %><p class="text-danger mb-2"><%= problem %></p><% end %>
        <label class="form-check mb-0"><%= f.check_box :remove_v2_certificate, class: "form-check-input" %>
          <span class="form-check-label">停用当前退款证书和私钥</span></label>
      </fieldset>
    <% end %>
    <fieldset <%= tag.attributes(class: "mt-3 border-top pt-3", data: { payment_version: "v3" }, hidden: version != "v3", disabled: version != "v3") %>>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <button type="button" class="btn btn-sm" data-bs-toggle="collapse" data-bs-target="#wechat-pay-backup"
                aria-expanded="<%= backup_open %>" aria-controls="wechat-pay-backup">
          <span data-collapse-label="collapsed"><%= render "layouts/admins/icon", name: :chevron_down, icon_class: "me-1" %>展开备用验签材料</span>
          <span data-collapse-label="expanded"><%= render "layouts/admins/icon", name: :chevron_up, icon_class: "me-1" %>收起备用验签材料</span>
        </button>
        <%= render "admins/shared/field_help", label: "查看备用验签材料说明",
              text: "换证期间可同时验证两套微信签名。过渡结束后可停用旧材料。" %>
        <span class="badge bg-secondary-lt">选填</span>
      </div>
      <div class="<%= class_names("collapse", show: backup_open) %>" id="wechat-pay-backup">
        <div class="pt-3">
          <div class="row g-3">
            <% WechatPaySettings::BACKUP.each do |field| %>
              <% value, source = form_fields.fetch(field) %>
              <div class="col-12 col-md-6" data-merchant-credential>
                <%= render "admins/shared/configuration_field", form: f, record: @settings, field: field, label: WechatPaySettings::LABELS.fetch(field),
                      source: source, show_source: source != "未配置", value: value, rows: (4 if field.end_with?("_pem")), placeholder: "" %>
              </div>
            <% end %>
          </div>
          <label <%= tag.attributes(class: "form-check mt-3 mb-0", data: { remove_backup: true }, hidden: !has_backup) %>>
            <%= f.check_box :remove_backup, class: "form-check-input", checked: @submitted&.[]("remove_backup") == "1" %>
            <span class="form-check-label">停用备用验签材料</span></label>
        </div>
      </div>
    </fieldset>
  <% end %>
<% end %>
<% if @gateway_error %>
  <aside class="alert alert-warning mt-3">
    <div><h3 class="alert-title">最近一次 V3 签名错误或查无记录提示 · <%= admin_list_time(@gateway_error.created_at) %></h3>
      <div><%= @gateway_error.details.fetch("reason") %></div>
      <div class="text-secondary text-break">收到的微信签名头：<%= @gateway_error.details.fetch("headers_present").presence&.join("、") || "无" %></div>
    </div>
  </aside>
<% end %>
<% if @settings.stored? %>
  <%= form_with scope: :wechat_pay, url: admins_system_settings_wechat_pay_path, method: :patch, id: "clear-wechat-pay-form", class: "d-none" do |f| %>
    <%= f.hidden_field :revision, value: @settings.revision, id: nil %>
    <%= f.hidden_field :clear_settings, value: "1", id: nil %>
  <% end %>
  <%= render "admins/shared/confirmation_modal", modal_id: "clear-wechat-pay", form_id: "clear-wechat-pay-form",
        title: "清除微信支付配置", context: "普通商户直连", description: "新单将按环境变量和 Rails credentials 读取配置。已有支付单保留原配置引用。",
        color: "warning", confirm_label: "确认清除", confirm_icon: :trash, cancel_icon: :close %>
<% end %>
