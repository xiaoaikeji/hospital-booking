<% content_for :title, "企微通知文案 · Booking 管理后台" %>
<% content_for :head do %><%= javascript_include_tag "admins/reply_composer", defer: true %><% end %>
<%= render "admins/shared/enhanced_select_assets" %>
<% history_link = capture do %>
  <%= link_to admins_notifications_path, class: "btn" do %><%= render "layouts/admins/icon", name: :history %>发送记录<% end %>
<% end %>
<%= render "admins/system_settings/navigation", title: "企微通知文案", actions: history_link %>
<%= form_with url: edit_admins_system_settings_wecom_notification_content_path, method: :get, class: "card card-body mb-3" do %>
  <div class="row align-items-end g-2"><div class="col-12 col-lg-5"><label class="form-label" for="notification-event">通知事件</label>
    <%= select_tag :event, options_for_select(WechatPlatform::NotificationSettings::LABELS.map { |value, label| [label, value] }, @kind), class: "form-select", id: "notification-event", data: { enhanced_select: "single" } %>
  </div><div class="col-auto"><button type="submit" class="btn"><%= render "layouts/admins/icon", name: :search %>选择事件</button></div></div>
<% end %>
<div data-reply-editor data-reply="<%= @reply.to_json %>" data-input="<%= @input.to_json %>" data-payload-key="notification_content"
     data-variables="<%= @variable_fields.to_json %>" data-examples="<%= @variable_examples.to_json %>"
     data-save="<%= admins_system_settings_wecom_notification_content_path(event: @kind) %>" data-back="<%= edit_admins_system_settings_wecom_notification_content_path(event: @kind) %>">
  <div class="alert alert-danger" data-reply-error hidden role="alert"></div>
  <div class="row g-3 align-items-start">
    <div class="col-12 col-lg-8"><section class="card">
      <div class="card-header"><h2 class="card-title"><%= @reply['name'] %></h2></div><div class="card-body">
        <p class="form-hint">按顺序发送文字。未配置的事件沿用默认文案；保存后只影响新产生的通知。</p>
        <div data-reply-items></div>
        <button type="button" class="btn" data-reply-add="text"><%= render "layouts/admins/icon", name: :plus %>新增文字</button>
      </div><div class="card-footer d-flex flex-wrap gap-2">
        <%= render "admins/shared/submit_button", label: "保存", icon: :save, type: "button", data: { reply_save: true } %>
        <% if @content.stored %><button class="btn" type="button" data-bs-toggle="modal" data-bs-target="#restore-notification-content"><%= render "layouts/admins/icon", name: :rotate %>恢复默认文案</button><% end %>
      </div>
    </section></div>
    <div class="col-12 col-lg-4"><section class="card"><div class="card-header"><h2 class="card-title">示例预览</h2></div><div class="card-body bg-body-tertiary" data-reply-preview aria-live="polite"></div></section>
      <%= render "admins/shared/notification_variables", fields: @variable_fields %>
    </div>
  </div>
</div>
<% if @content.stored %>
  <%= form_with url: admins_system_settings_wecom_notification_content_path(event: @kind), method: :patch, scope: :notification_content, id: "restore-content-form", class: "d-none" do |f| %><%= f.hidden_field :revision, value: @content.revision %><%= f.hidden_field :restore, value: '1' %><% end %>
  <%= render "admins/shared/confirmation_modal", modal_id: "restore-notification-content", form_id: "restore-content-form", title: "恢复默认通知文案", context: @reply['name'], description: "此事件将重新使用系统默认文案，已排队和历史消息保持原内容。", confirm_label: "确认恢复", color: "warning", confirm_icon: :rotate %>
<% end %>
