<%= render layout: "admins/shared/list_page_header", locals: { title: title, icon: :settings } do %>
  <%= local_assigns[:actions] %>
<% end %>
<% pages = system_settings_pages %>
<% if pages.any? %>
  <nav class="nav nav-tabs mb-3" aria-label="系统设置">
    <% pages.each do |label, path| %>
      <%= link_to label, path, class: class_names("nav-link", active: label == title), aria: { current: ("page" if label == title) } %>
    <% end %>
  </nav>
<% end %>
