<% content_for :title, "存储设置 · Booking 管理后台" %>
<%= render "admins/shared/enhanced_select_assets" %>
<% fields = StorageSettings::FIELDS.keys.index_with { |field| @settings.form_field(field) } %>
<% revision = @settings.revision; can_clear = @settings.stored?; cos_enabled = fields.fetch("service").value == "tencent_cos" %>
<% choices = [["本地存储", "local"], ["腾讯云 COS", "tencent_cos"]] %>
<% unless StorageConfiguration::SERVICES.include?(fields.fetch("service").value) %>
  <% choices.unshift(["存储方式无效，请重新选择", "", { disabled: true, selected: true }]) %>
<% end %>
<%= render "admins/system_settings/navigation", title: "存储设置" %>
<%= form_with url: admins_system_settings_storage_path, scope: :storage_settings, method: :patch, class: "card", data: { admin_form: true, storage_settings: true } do |form| %>
  <%= form.hidden_field :revision, value: revision %>
  <%= render layout: "admins/shared/configuration_card", locals: { title: "文件存储", record: @settings, clear_target: "#clear-storage-settings-confirmation", clear_disabled: !can_clear } do %>
    <div class="row g-3">
      <div class="col-md-6 col-xl-4" data-storage-service>
        <%= render "admins/shared/configuration_field", form: form, record: @settings, field: "service", label: "存储方式", field_data: fields.fetch("service"), choices: choices, enhanced_select: "single" %>
      </div>
      <% StorageSettings::LABELS.except("service").each do |field, label| %>
        <fieldset class="col-md-6 col-xl-4" data-storage-cos-fields <%= tag.attributes(hidden: !cos_enabled, disabled: !cos_enabled) %>>
          <%= render "admins/shared/configuration_field", form: form, record: @settings, field: field, label: label, field_data: fields.fetch(field), placeholder: ({"secret_id" => "请输入 SecretId", "secret_key" => "请输入 SecretKey", "region" => "例如 ap-shanghai", "bucket" => "例如 booking-1234567890", "endpoint" => "留空按地域生成 HTTPS API 地址"}.fetch(field)) %>
        </fieldset>
      <% end %>
    </div>
  <% end %>
<% end %>
<%= form_with url: admins_system_settings_storage_path, scope: :storage_settings, method: :patch, id: "clear-storage-settings", class: "d-none", data: { admin_form: true } do |form| %>
  <%= form.hidden_field :revision, value: revision, id: "clear-storage-settings-revision" %>
  <% StorageSettings::FIELDS.each_key do |field| %><%= hidden_field_tag "storage_settings[clear_fields][]", field, id: nil %><% end %>
<% end %>
<%= render "admins/shared/confirmation_modal", modal_id: "clear-storage-settings-confirmation", title: "确认清除系统配置", context: "文件存储", description: "清除本页的系统配置后，将按 ENV、credentials 读取；存储方式无其他配置时恢复本地存储。", confirm_label: "确认清除", color: "warning", confirm_icon: :trash, cancel_icon: :close, form_id: "clear-storage-settings" %>
