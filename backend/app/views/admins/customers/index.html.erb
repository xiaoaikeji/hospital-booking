<% content_for :title, "客户列表 · Booking 管理后台" %>
<% content_for :fill_content, "true" %>
<% filter_url = ->(changes = {}) { admins_customers_path(@filters.merge(q: @query.presence).merge(changes).compact) } %>

<div class="page-header mt-0 mb-3 flex-shrink-0">
  <div class="row g-2 align-items-center">
    <div class="col-auto"><h1 class="page-title fs-1 gap-3"><span class="text-primary d-inline-flex"><%= render "layouts/admins/icon", name: :users, icon_class: "w-5 h-5" %></span>客户列表</h1></div>
    <div class="col-auto ms-auto"><div class="btn-list">
      <button type="button" class="btn" data-bs-toggle="collapse" data-bs-target="#customer-advanced-filters" aria-controls="customer-advanced-filters" aria-expanded="<%= @advanced_filters %>">
        <span data-collapse-label="collapsed">更多筛选</span>
        <span data-collapse-label="expanded">收起筛选</span>
      </button>
      <%= link_to "返回预约列表", admins_reservations_path, class: "btn" %>
    </div></div>
  </div>
</div>

<section class="card mb-3 flex-shrink-0" aria-label="客户筛选条件">
  <div class="list-group list-group-flush border-bottom-0">
    <% [["客户状态", :status], ["客户来源", :source]].each do |label, key| %>
      <%= render "admins/shared/list_filter_row", label: label, key: key, options: @filter_options.fetch(key), selected: @filters[key], filter_url: filter_url %>
    <% end %>
  </div>
  <div class="collapse<%= " show" if @advanced_filters %>" id="customer-advanced-filters">
    <div class="list-group rounded-0">
      <% advanced_rows = [["注册时间", :period], ["客户标签", :tag]] %>
      <% advanced_rows.each_with_index do |(label, key), index| %>
        <%= render "admins/shared/list_filter_row", label: label, key: key, options: @filter_options.fetch(key), selected: @filters[key], filter_url: filter_url,
                   row_class: class_names("border-x-0 rounded-0", "border-bottom-0" => index == advanced_rows.length - 1) %>
      <% end %>
    </div>
  </div>
</section>

<%# Native flex continues through the opt-in layout container and card; no measured or fixed height. %>
<section class="card flex-fill" aria-label="客户记录" data-customer-list>
  <div class="card-header flex-shrink-0">
    <%= form_with url: admins_customers_path, method: :get, class: "row g-3 align-items-center flex-grow-1", html: { role: "search" } do |form| %>
      <% @filters.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
      <div class="col-12 col-sm-6 col-md-4 col-xl-3"><%= form.search_field :q, value: @query, class: "form-control", placeholder: "客户编号 / 姓名 / 手机号", aria: { label: "搜索客户" } %></div>
      <div class="col-12 col-sm-auto"><div class="btn-list align-items-center">
        <button type="submit" class="btn">搜索</button>
        <% if @query.present? || @filters.any? %><%= link_to "重置", admins_customers_path, class: "btn btn-ghost-secondary" %><% end %>
        <span class="text-secondary"><strong class="text-body"><%= @customers.size %></strong> 位客户</span>
      </div></div>
    <% end %>
  </div>
  <%# Tabler .empty has height: 100%; h-auto lets flex allocate only the remaining card space. %>
  <div class="empty flex-fill h-auto p-4" role="status" data-customer-empty>
    <div data-customer-empty-message>
      <div class="empty-icon mx-auto"><%= render "layouts/admins/icon", name: :users, icon_class: "w-100 h-100" %></div>
      <% if @query.present? || @filters.any? %>
        <h2 class="empty-title">没有找到匹配的客户</h2>
        <p class="empty-subtitle text-secondary">试试其他关键词，或清除筛选条件。</p>
        <div class="empty-action"><%= link_to "清除筛选", admins_customers_path, class: "btn btn-primary" %></div>
      <% else %>
        <h2 class="empty-title">暂无客户</h2>
        <p class="empty-subtitle text-secondary">客户信息添加后，会显示在这里。</p>
      <% end %>
    </div>
  </div>
</section>
