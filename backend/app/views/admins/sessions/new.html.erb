<div class="card card-md">
  <div class="card-body">
    <h1 class="h2 text-center mb-4">登录管理后台</h1>
    <%= form_with model: resource, as: resource_name, url: session_path(resource_name), data: { admin_form: true } do |form| %>
      <div class="mb-3">
        <%= form.label :username, "用户名", class: "form-label required" %>
        <%= form.text_field :username, class: "form-control", placeholder: "请输入用户名", autocomplete: "username", required: true, autofocus: true %>
      </div>
      <div class="mb-2">
        <%= form.label :password, "密码", class: "form-label required" %>
        <div class="input-group input-group-flat">
          <%= form.password_field :password, value: nil, class: "form-control", placeholder: "请输入密码", autocomplete: "current-password", required: true %>
          <span class="input-group-text"><%= render "admins/shared/password_toggle", input_id: form.field_id(:password) %></span>
        </div>
      </div>
      <div class="mb-2"><label class="form-check"><%= form.check_box :remember_me, class: "form-check-input" %><span class="form-check-label">记住登录</span></label></div>
      <div class="form-footer"><%= render "admins/shared/submit_button", label: "登录", button_class: "btn btn-primary w-100" %></div>
      <% if flash[:notice].present? || flash[:alert].present? %><div class="mt-3"><%= render "admins/shared/flash" %></div><% end %>
    <% end %>
  </div>
</div>
