<% content_for :title, "开放平台账号" %>
<% list_context = params.permit(:q, :page).to_h.compact_blank %>
<% content_for :fill_content, "true" if @accounts.empty? %>
<%= render layout: "admins/shared/list_page_header", locals: {title: "开放平台账号", icon: :affiliate} do %>
  <%= link_to new_admins_open_platform_account_path, class: "btn btn-primary" do %><%= render "layouts/admins/icon", name: :plus %>新增开放平台账号<% end %>
<% end %>
<section class="<%= class_names("card", "flex-fill" => @accounts.empty?) %>" aria-label="开放平台账号列表">
  <div class="card-header flex-shrink-0">
    <%= form_with url: admins_open_platform_accounts_path, method: :get, class: "d-flex flex-wrap flex-lg-nowrap align-items-center gap-2 w-100", html: {role: "search", aria: {label: "搜索开放平台账号"}} do |form| %>
      <div class="col-12 col-sm-5 col-lg-3 flex-shrink-0">
        <%= form.search_field :q, value: @query, placeholder: "名称 / 开放平台 AppID", aria: {label: "名称或开放平台 AppID"}, class: "form-control text-truncate" %>
      </div>
      <%= form.button class: "btn flex-shrink-0 text-nowrap" do %><%= render "layouts/admins/icon", name: :search %>搜索<% end %>
      <% if @query.present? %><%= link_to admins_open_platform_accounts_path, class: "btn flex-shrink-0 text-nowrap" do %><%= render "layouts/admins/icon", name: :rotate %>重置筛选<% end %><% end %>
    <% end %>
  </div>
  <% if @accounts.empty? %><%= render "admins/shared/list_empty", icon: :affiliate, title: (@query.present? ? "没有找到匹配的开放平台账号" : "暂无开放平台账号") %>
  <% else %><table class="table table-fixed table-vcenter card-table table-hover admin-list-table mb-0">
    <thead><tr>
      <th scope="col" class="list-column-id px-2">ID</th><th scope="col" class="px-2">名称</th>
      <th scope="col" class="d-none d-md-table-cell px-2">开放平台 AppID</th><th scope="col" class="px-2">绑定数</th>
      <th scope="col" class="d-none d-lg-table-cell px-2">登记来源</th><th scope="col" class="d-none d-xl-table-cell px-2 list-column-time">创建时间</th><th scope="col" class="list-column-action px-2">操作</th>
    </tr></thead><tbody>
      <% @accounts.each do |account| %><tr>
        <td class="text-secondary px-2">#<%= account.id %></td>
        <td class="px-2"><%= render "admins/shared/list_text", text: account.name, url: admins_open_platform_account_path(account, list_context) %></td>
        <td class="d-none d-md-table-cell px-2"><%= render "admins/shared/list_text", text: account.open_appid %></td>
        <td class="px-2"><%= @counts.fetch(account.id, 0) %></td>
        <td class="d-none d-lg-table-cell px-2"><%= render "admins/shared/list_text", text: account.created_via_app.display_name, url: admins_app_path(account.created_via_app, tab: "open_platform") %></td>
        <td class="d-none d-xl-table-cell px-2"><%= admin_list_time(account.created_at) %></td>
        <td class="px-2"><%= link_to admins_open_platform_account_path(account, list_context), class: "btn btn-sm btn-info text-nowrap" do %><%= render "layouts/admins/icon", name: :eye %>查看<% end %></td>
      </tr><% end %>
    </tbody></table>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { admins_open_platform_accounts_path(q: @query.presence, page: page) } %>
  <% end %>
</section>
