<% content_for :title, "账号与密码 · Booking 管理后台" %>
<div class="page-header mt-0 mb-3">
  <h1 class="page-title fs-1 gap-3">
    <span class="text-primary d-inline-flex"><%= render "layouts/admins/icon", name: :users, icon_class: "w-5 h-5" %></span>
    账号与密码
  </h1>
</div>

<%= form_with model: @administrator, scope: :account, url: admins_account_path, method: :patch, class: "card", data: { admin_form: true } do |form| %>
  <div class="card-header gap-3">
    <span class="avatar bg-primary-lt rounded-circle flex-shrink-0" aria-hidden="true"><%= @administrator.display_name.first %></span>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <span class="fw-semibold fs-3 text-break"><span class="visually-hidden">用户名 </span><%= @administrator.username %></span>
      <span class="badge bg-secondary-lt"><span class="visually-hidden">角色 </span><%= @administrator.role_name %></span>
    </div>
  </div>
  <div class="card-body">
    <%= render "admins/shared/form_errors", record: @administrator %>
    <div class="row">
      <div class="col-sm-10 col-md-8 col-lg-7 col-xl-5 col-xxl-4">
        <div class="vstack gap-3">
          <% [[:current_password, "当前密码"], [:password, "新密码"], [:password_confirmation, "确认新密码"]].each do |field, label| %>
            <div class="row g-2">
              <%= form.label field, label, class: "col-sm-4 col-form-label fw-medium py-0 py-sm-2" %>
              <div class="col-sm-8">
                <div class="input-group input-group-flat">
                  <%= form.password_field field, value: nil, class: admin_field_class(@administrator, field), autocomplete: (field == :current_password ? "current-password" : "new-password"), placeholder: ("留空保留原密码" if field == :password), aria: { describedby: ("#{field}-error" if @administrator.errors[field].any?) } %>
                  <span class="input-group-text"><%= render "admins/shared/password_toggle", input_id: form.field_id(field) %></span>
                </div>
                <%= admin_field_errors(@administrator, field) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="card-footer bg-transparent">
    <div class="btn-list justify-content-end">
      <%= render "admins/shared/submit_button", label: "修改密码", icon: :save %>
    </div>
  </div>
<% end %>
