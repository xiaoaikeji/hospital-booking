<%= render "admins/shared/enhanced_select_assets" %>
<% content_for :head do %><%= javascript_include_tag "admins/official_account_menu", defer: true %><% end %>
<div id="official-menu-editor" data-buttons="<%= @menu.buttons.to_json %>" data-editable="<%= editable %>" data-revision="<%= @menu.revision %>"
  data-app-id="<%= @app.id %>" data-replies="<%= @replies.to_json %>" data-new-reply="<%= new_admins_app_reply_content_path(@app, inline: 1) %>" data-edit-reply-base="<%= admins_app_reply_contents_path(@app) %>"
  data-publish="<%= publish_admins_app_official_account_menu_path(@app) %>" data-image="<%= image_admins_app_official_account_menu_path(@app) %>" data-media="<%= media_admins_app_official_account_menu_path(@app) %>" data-articles="<%= articles_admins_app_official_account_menu_path(@app) %>">
  <div id="menu-feedback" class="alert alert-danger" role="alert" hidden></div>
  <div class="row g-3 align-items-start">
    <div class="col-12 col-lg-4">
      <section class="card official-menu-phone" aria-label="公众号菜单预览">
        <div class="card-header"><%= render "layouts/admins/icon", name: :device_mobile %><div class="ms-2 overflow-hidden"><h2 class="card-title text-truncate"><%= @app.display_name %></h2><small class="text-secondary"><%= @app.appid %></small></div></div>
        <div class="card-body bg-body-tertiary d-flex flex-column justify-content-end gap-2" id="menu-screen">
          <div class="text-break" id="menu-preview-result" aria-live="polite"></div>
          <div class="list-group" id="menu-children"></div>
        </div>
        <nav id="menu-bar" class="card-footer p-2 d-flex gap-1" aria-label="一级菜单"></nav>
      </section>
    </div>
    <div class="col-12 col-lg-8"><section class="card">
      <div class="card-header"><h2 class="card-title" id="menu-heading">菜单信息</h2><div class="card-actions">
        <button type="button" class="btn btn-sm" id="menu-preview"><%= render "layouts/admins/icon", name: :device_mobile %><span>预览</span></button>
      </div></div>
      <div class="card-body">
        <p id="menu-empty" class="text-secondary mb-0">暂无菜单<%= "，可从微信读取或新增一级菜单。" if editable %></p>
        <fieldset id="menu-fields" hidden <%= "disabled" unless editable %>>
          <div class="mb-3">
            <div class="d-flex align-items-center gap-1 mb-2">
              <label for="menu-name" class="form-label required mb-0">菜单名称</label>
              <%= render "admins/shared/field_help", id: "menu-name-hint", text: "一级菜单最多 4 个汉字或 8 个字母。", label: "查看菜单名称要求" %>
            </div>
            <input id="menu-name" data-field="name" class="form-control" autocomplete="off" maxlength="32">
            <div class="invalid-feedback d-block" id="menu-name-error" hidden></div>
          </div>
          <div id="menu-type-group"><label for="menu-type" class="form-label">菜单动作</label><select id="menu-type" class="form-select"></select></div>
          <div data-panel="miniprogram" class="mt-3">
            <label class="form-label required" for="menu-appid">目标小程序</label><select id="menu-appid" data-field="appid" class="form-select" required>
              <option value="">请选择小程序</option><% @targets.each do |app| %><%= tag.option "#{app.display_name} · #{app.appid}", value: app.appid %><% end %>
            </select>
            <div class="invalid-feedback d-block" id="menu-appid-error" hidden></div>
            <label class="form-label required mt-3" for="menu-page">页面路径</label><input id="menu-page" data-field="pagepath" class="form-control" list="booking-menu-paths" placeholder="pages/booking/index" required>
            <div class="invalid-feedback d-block" id="menu-page-error" hidden></div>
            <datalist id="booking-menu-paths"><option value="pages/index/index">首页</option><option value="pages/booking/index">预约挂号</option><option value="pages/ucenter/appointments">预约记录</option></datalist>
          </div>
          <div data-panel="url" class="mt-3">
            <label for="menu-url" class="form-label" id="menu-url-label">网址</label>
            <input id="menu-url" data-field="url" type="url" class="form-control" placeholder="https://">
            <div class="invalid-feedback d-block" id="menu-url-error" hidden></div>
          </div>
          <div data-panel="media_id" class="form-fieldset mt-3 mb-0">
            <label class="form-label" for="menu-kind">素材类型</label>
            <select class="form-select mb-3" id="menu-kind"><option value="image">图片</option><option value="voice">音频</option><option value="video">视频</option></select>
            <img id="menu-image" class="img-fluid rounded border mb-3" width="240" alt="已选择图片" hidden>
            <div class="d-flex align-items-center gap-1 mb-2">
              <label class="form-label mb-0" for="menu-upload">上传永久素材</label>
              <%= render "admins/shared/field_help", id: "menu-media-hint", text: "JPG、PNG、BMP、GIF，最多 10 MB", label: "查看永久素材上传要求" %>
            </div>
            <input type="file" class="form-control" id="menu-upload">
            <div class="mt-2 text-break" id="menu-media-name"></div>
          </div>
          <div data-panel="article_id" class="mt-3"><div id="menu-article-name" class="mb-2 text-break"></div><button type="button" id="menu-articles" class="btn"><%= render "layouts/admins/icon", name: :search %>选择已发表内容</button></div>
          <div data-panel="click" class="mt-3"><label for="menu-key" class="form-label">回复内容</label><select class="form-select" id="menu-key" data-field="key"></select>
            <% if editable %><div class="d-flex flex-wrap gap-2 mt-2"><button type="button" class="btn btn-sm" id="menu-new-reply"><%= render "layouts/admins/icon", name: :plus %>新增回复内容</button><button type="button" class="btn btn-sm" id="menu-edit-reply"><%= render "layouts/admins/icon", name: :edit %>编辑回复</button></div><% end %></div>
          <div data-panel="legacy"><div class="alert alert-warning mt-3 mb-0 text-break" id="menu-legacy"></div>
            <% if editable %><span id="menu-reuse-text-action" hidden><button type="button" id="menu-reuse-text" class="btn btn-sm mt-2">沿用原文字</button></span><% end %></div>
          <% if editable %><div class="d-flex flex-wrap gap-2 mt-3">
            <% [[:plus,"新增子菜单","add-child"],[:arrow_left,"前移","move-up"],[:arrow,"后移","move-down"],[:trash,"删除菜单","delete"]].each do |icon,label,id| %>
              <button id="menu-<%= id %>" type="button" class="btn btn-sm <%= "btn-outline-danger" if id=="delete" %>"><%= render "layouts/admins/icon", name: icon %><%= label %></button>
            <% end %>
          </div><% end %>
        </fieldset>
      </div>
      <% if editable %><div class="card-footer btn-list justify-content-end">
        <button id="menu-add" class="btn" type="button"><%= render "layouts/admins/icon", name: :plus %>新增一级菜单</button>
        <button id="menu-submit" class="btn btn-primary" type="button"><%= render "layouts/admins/icon", name: :export %>保存并发布</button>
      </div><% end %>
    </section></div>
  </div>
</div>
<% if editable %>
  <% [
       ["publish", "发布公众号菜单", "将整套菜单发布到微信，覆盖该公众号的现有菜单。", "确认发布", "primary"],
       ["clear", "清空公众号菜单", "将删除该公众号在微信上的全部菜单。", "确认清空", "danger"],
       ["remove", "删除菜单", "此项及其子菜单将在本次编辑中移除，保存并发布后对微信用户生效。", "删除", "danger"],
       ["convert", "新增子菜单", "设为一级分组后，原菜单动作将被替换。", "继续", "warning"]
     ].each do |id, title, description, label, color| %>
    <form id="menu-<%= id %>-form" class="d-none"></form>
    <%= render "admins/shared/confirmation_modal", modal_id: "menu-#{id}-confirm", title: title, description: description, context: "#{@app.display_name} · #{@app.appid}", confirm_label: label, color: color, form_id: "menu-#{id}-form" %>
  <% end %>
  <div class="modal modal-blur fade" id="menu-article-picker" tabindex="-1" aria-labelledby="menu-article-title"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title" id="menu-article-title">选择已发表内容</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body" id="menu-article-rows" aria-live="polite"></div><div class="modal-footer"><button type="button" class="btn" id="menu-article-prev">上一页</button><button type="button" class="btn" id="menu-article-next">下一页</button></div>
  </div></div></div>
<% end %>
