<% content_for :title, "操作日志 · Booking 管理后台" %>
<%= render "admins/shared/enhanced_select_assets" %>
<% empty = @logs.empty? %>
<% content_for :fill_content, "true" if empty %>

<%= render layout: "admins/shared/list_page_header", locals: { title: "操作日志", icon: :chart } do %><% end %>

<section class="card mb-3 flex-shrink-0" aria-label="日志结果筛选">
  <div class="list-group list-group-flush">
    <%= render "admins/shared/list_filter_row", label: "结果", key: :status, options: Admins::OperationLogsController::STATUSES, selected: @filters[:status], filter_url: ->(changes) { admins_operation_logs_path(@filters.merge(changes).compact) } %>
  </div>
</section>

<section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="操作日志列表">
  <div class="card-header flex-shrink-0">
    <%= form_with url: admins_operation_logs_path, method: :get, class: "row g-2 align-items-center w-100", html: { role: "search", aria: { label: "筛选操作日志" } } do |form| %>
      <%= form.hidden_field :status, value: @filters[:status] if @filters[:status] %>
      <div class="col-12 col-sm-6 col-xl-2">
        <%= form.select :operation, options_for_select([["全部操作", ""]] + AdminsHelper::LOG_ACTIONS.map { |value, label| [label, value] }, @filters[:operation]), {}, class: "form-select", data: { enhanced_select: "single" }, aria: { label: "操作类型" } %>
      </div>
      <% if current_admin.super_admin? %>
        <div class="col-12 col-sm-6 col-xl-2">
          <%= form.collection_select :actor_id, @actor_options, :id, :display_name, { include_blank: "全部操作人", selected: @filters[:actor_id] }, class: "form-select", data: { enhanced_select: "search" }, aria: { label: "操作人" } %>
        </div>
      <% end %>
      <div class="col-12 col-sm-6 col-xl-3">
        <%= render "admins/shared/date_field", id: "log-date-range", name: :date_range, value: @date_range, prefix: "操作", selection_mode: "multiple-ranged", placeholder: "起止日期", clearable: false %>
      </div>
      <div class="col-auto btn-list">
        <%= form.button type: "submit", class: "btn flex-shrink-0 text-nowrap" do %><%= render "layouts/admins/icon", name: :search %>筛选<% end %>
        <% if @filters.any? %>
          <%= link_to admins_operation_logs_path, class: "btn flex-shrink-0 text-nowrap" do %><%= render "layouts/admins/icon", name: :rotate %>重置筛选<% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if empty %>
    <%= render "admins/shared/list_empty", icon: :chart, title: (@filters.any? ? "没有符合条件的日志" : "暂无操作日志"), description: (@filters.any? ? "试试其他条件，或重置筛选。" : "后续操作记录会显示在这里。") %>
  <% else %>
    <table class="table table-fixed table-vcenter card-table table-hover admin-list-table mb-0">
      <thead><tr>
        <th scope="col" class="list-column-id px-2">ID</th>
        <th scope="col" class="px-2">操作类型</th>
        <th scope="col" class="d-none d-sm-table-cell">操作人</th>
        <th scope="col" class="d-none d-md-table-cell">对象</th>
        <th scope="col" class="list-column-status px-2">结果</th>
        <th scope="col" class="list-column-time d-none d-lg-table-cell">操作时间</th>
        <th scope="col" class="list-column-action px-2">操作</th>
      </tr></thead>
      <tbody>
        <% @logs.each do |log| %>
          <% actor = (@actors[log.actor_id] if log.actor_type == "Admin") %>
          <tr>
            <td class="text-secondary px-2"><%= render "admins/shared/list_text", text: "##{log.id}" %></td>
            <td class="px-2"><%= render "admins/shared/list_text", text: log_action_name(log.action) %></td>
            <td class="d-none d-sm-table-cell"><%= render "admins/shared/list_text", text: actor&.display_name || log_subject_label(log.actor_type, log.actor_id) %></td>
            <td class="d-none d-md-table-cell"><%= render "admins/shared/list_text", text: log_subject_label(log.target_type, log.target_id) %></td>
            <td class="px-2"><%= render "status", status: log.status %></td>
            <td class="d-none d-lg-table-cell"><%= render "admins/shared/list_text", text: admin_list_time(log.created_at) %></td>
            <td class="px-2"><%= link_to admins_operation_log_path(log, @list_context), class: "btn btn-sm btn-info text-nowrap" do %><%= render "layouts/admins/icon", name: :eye %>查看<% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { admins_operation_logs_path(@filters.merge(page: page)) } %>
  <% end %>
</section>
