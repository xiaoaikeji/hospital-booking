<div class="list-group-item" data-keyword-row>
  <div class="row g-2 align-items-end">
    <div class="col-auto d-flex align-items-center gap-1 align-self-end pb-2">
      <span class="cursor-move text-secondary d-inline-flex" data-keyword-handle aria-hidden="true" title="拖动调整优先级">
        <%= render "layouts/admins/icon", name: :grip_vertical %>
      </span>
      <span class="badge bg-primary-lt" data-keyword-position><%= index + 1 if index.is_a?(Integer) %></span>
    </div>
    <div class="col">
      <%= label_tag "keyword-#{index}-words", "关键词", class: "form-label" %>
      <%= text_field_tag "reply_rules[keywords][][words]", rule["words"], id: "keyword-#{index}-words", class: "form-control", maxlength: 500, size: nil, placeholder: "签到,活动" %>
    </div>
    <div class="col-6 col-md-3">
      <%= label_tag "keyword-#{index}-match", "匹配方式", class: "form-label" %>
      <%= select_tag "reply_rules[keywords][][match]", options_for_select([["精确匹配", "exact"], ["包含匹配", "contain"]], rule["match"]),
            id: "keyword-#{index}-match", class: "form-select", data: { enhanced_select: "single" } %>
    </div>
    <div class="col-6 col-md-3">
      <%= label_tag "keyword-#{index}-reply", "回复内容", class: "form-label" %>
      <%= select_tag "reply_rules[keywords][][reply_id]", options_for_select(@config.replies.map { |id, r| [r["name"], id] }, rule["reply_id"]),
            id: "keyword-#{index}-reply", include_blank: "请选择", class: "form-select", data: { enhanced_select: "single" } %>
    </div>
    <div class="col-12 col-xl-auto">
      <div class="btn-list justify-content-end">
        <button type="button" class="btn btn-sm" data-move-keyword="up">上移</button>
        <button type="button" class="btn btn-sm" data-move-keyword="down">下移</button>
        <button type="button" class="btn btn-sm btn-outline-danger" data-remove-keyword><%= render "layouts/admins/icon", name: :trash %>删除</button>
      </div>
    </div>
  </div>
</div>
