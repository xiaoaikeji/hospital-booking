<% content_for :title, "渠道二维码 · Booking 管理后台" %>
<% empty = @codes.blank? %>
<% content_for :fill_content, "true" if empty %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "渠道二维码", icon: :qrcode } do %>
  <% if @app&.platform_authorized? %>
    <%= link_to new_admins_app_channel_qrcode_path(@app, q: @query.presence, page: params[:page]), class: "btn btn-primary" do %><%= render "layouts/admins/icon", name: :plus %>新增渠道二维码<% end %>
  <% end %>
<% end %>
<% if @app %>
  <section class="card mb-3"><div class="list-group list-group-flush">
    <%= render "admins/shared/list_filter_row", label: "公众号", key: :app_id, options: @accounts.to_h { |account| [account.id, account.display_name] }, include_all: false, selected: @app.id, filter_url: ->(overrides) { admins_channel_qrcodes_path(overrides.merge(q: @query.presence)) } %>
  </div></section>
  <% unless @app.platform_authorized? %><div class="alert alert-warning">完成平台授权后可新增渠道二维码。<%= link_to "查看平台授权", admins_app_path(@app) %></div><% end %>
  <section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="渠道码列表">
    <div class="card-header"><%= form_with url: admins_channel_qrcodes_path, method: :get, class: "d-flex flex-wrap align-items-center gap-2 w-100", html: { role: "search" } do %>
      <%= hidden_field_tag :app_id, @app.id %>
      <div class="col-12 col-sm-5 col-lg-3"><%= search_field_tag :q, @query, class: "form-control", placeholder: "渠道码名称", aria: { label: "渠道码名称" } %></div>
      <button type="submit" class="btn"><%= render "layouts/admins/icon", name: :search %>搜索</button>
      <% if @query.present? %><%= link_to admins_channel_qrcodes_path(app_id: @app.id), class: "btn" do %><%= render "layouts/admins/icon", name: :rotate %>重置筛选<% end %><% end %>
    <% end %></div>
    <% if empty %>
      <%= render "admins/shared/list_empty", icon: :qrcode, title: (@query.present? ? "未找到匹配的渠道二维码" : "还没有渠道二维码"), description: ("试试其他关键词，或重置筛选。" if @query.present?) %>
    <% else %>
      <table class="table table-fixed table-vcenter card-table table-hover admin-list-table mb-0">
        <thead><tr><th scope="col" class="list-column-id px-2">ID</th><th scope="col" class="px-2">名称</th><th scope="col" class="col-2 d-none d-sm-table-cell">扫码关注人数</th><th scope="col" class="col-3 d-none d-md-table-cell">创建时间</th><th scope="col" class="col-3 col-sm-2 px-2">操作</th></tr></thead>
        <tbody><% @codes.each do |code| %>
          <% count = @counts.fetch(code.scene, 0) %>
          <tr><td class="text-secondary px-2">#<%= code.id %></td>
            <td class="px-2"><%= render "admins/shared/list_text", text: code.name %><small class="d-sm-none d-block text-secondary">扫码关注 <%= count %> 人</small></td>
            <td class="d-none d-sm-table-cell"><%= number_with_delimiter(count) %></td>
            <td class="d-none d-md-table-cell"><%= admin_list_time(code.created_at) %></td>
            <td class="px-2"><div class="d-flex flex-wrap gap-1"><%= link_to "配置回复", edit_admins_app_channel_qrcode_path(@app, code), class: "btn btn-sm btn-primary" %><%= link_to admins_app_channel_qrcode_path(@app, code, format: :png), class: "btn btn-sm btn-outline-secondary text-nowrap", data: { turbo: false }, download: "#{code.name}.png" do %><%= render "layouts/admins/icon", name: :export %>下载<% end %></div></td>
          </tr>
        <% end %></tbody>
      </table>
      <%= render "admins/shared/pagination", pagy: @pagy, url: ->(n) { admins_channel_qrcodes_path(app_id: @app.id, q: @query.presence, page: n) } %>
    <% end %>
  </section>
<% else %>
  <section class="card flex-fill"><%= render "admins/shared/list_empty", icon: :qrcode, title: "还没有公众号", description: "在应用管理登记微信公众号后，即可配置渠道二维码。" %></section>
<% end %>
