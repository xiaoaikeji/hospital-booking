<% content_for :title, "微信通知记录 · Booking 管理后台" %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "微信通知记录", icon: :bell } do %>
  <%= link_to edit_admins_system_settings_wechat_notifications_path, class: "btn" do %><%= render "layouts/admins/icon", name: :settings %>通知设置<% end %>
<% end %>
<%= render "admins/shared/wechat_app_filter", apps: @apps, selected: @app, filter_url: ->(changes) { admins_wechat_notifications_path(changes.compact) } %>
<section class="card">
  <% if @events.empty? %><%= render "admins/shared/list_empty", icon: :bell, title: "暂无微信通知记录", description: "配置群机器人并勾选事件后，新产生的通知会显示在这里。" %>
  <% else %><div class="list-group list-group-flush"><% @events.each do |event| %><article class="list-group-item py-3">
    <div class="d-flex flex-wrap align-items-center gap-2"><%= link_to event.app.display_name, admins_app_path(event.app), class: "fw-semibold text-break" %>
      <span><%= WechatPlatform::NotificationSettings::LABELS.fetch(event.kind) %></span>
      <span class="badge bg-<%= WechatNotificationEvent.color(event.status) %>-lt"><%= WechatNotificationEvent::STATES.fetch(event.status) %></span>
      <time class="ms-sm-auto text-secondary"><%= admin_list_time(event.created_at) %></time>
    </div><details class="mt-2"><summary>通知内容</summary><div class="text-break mt-2"><%= simple_format(h(event.message)) %></div></details>
    <% if event.error_code %><div class="text-danger small">企业微信错误码 <%= event.error_code %></div><% end %>
    <% if event.status == "unknown" %><small class="text-secondary">请核对群消息，系统已停止重发。</small><% end %>
  </article><% end %></div><%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { admins_wechat_notifications_path(app_id: params[:app_id].presence, page: page) } %>
  <% end %>
</section>
