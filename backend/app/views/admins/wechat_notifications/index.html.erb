<% content_for :title, "微信通知记录 · Booking 管理后台" %>
<% empty = @events.empty? %>
<% content_for :fill_content, "true" if empty %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "微信通知记录", icon: :bell } do %>
  <%= link_to "通知文案", edit_admins_system_settings_wecom_notification_content_path, class: "btn" %>
  <%= link_to "通用发送记录", admins_notifications_path, class: "btn" %>
  <%= link_to edit_admins_system_settings_wechat_notifications_path, class: "btn" do %><%= render "layouts/admins/icon", name: :settings %>通知设置<% end %>
<% end %>
<%= render "admins/shared/wechat_app_filter", apps: @apps, selected: @app, filter_url: ->(changes) { admins_wechat_notifications_path(changes.compact) } %>
<section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="微信通知记录">
  <% if empty %>
    <%= render "admins/shared/list_empty", icon: :bell,
          title: (@app ? "没有找到匹配的通知记录" : "暂无微信通知记录"),
          description: (@app ? "试试其他小程序，或切换为全部。" : "配置群机器人并勾选事件后，新产生的通知会显示在这里。") %>
  <% else %>
    <table class="table table-fixed table-vcenter card-table table-hover admin-list-table wechat-notification-table mb-0">
      <thead><tr>
        <th scope="col" class="list-column-id px-2">ID</th>
        <th scope="col" class="d-none d-sm-table-cell">小程序</th>
        <th scope="col" class="px-2">事件</th>
        <th scope="col" class="list-column-status px-2">状态</th>
        <th scope="col" class="list-column-time d-none d-lg-table-cell px-2">通知时间</th>
        <th scope="col" class="list-column-action px-2">操作</th>
      </tr></thead>
      <tbody>
        <% @events.each do |event| %>
          <tr>
            <td class="text-secondary px-2"><%= render "admins/shared/list_text", text: "##{event.id}" %></td>
            <td class="d-none d-sm-table-cell"><%= render "admins/shared/list_text", text: event.app.display_name, url: admins_app_path(event.app) %></td>
            <td class="px-2">
              <%= render "admins/shared/list_text", text: WechatPlatform::NotificationSettings::LABELS.fetch(event.kind) %>
              <div class="d-sm-none small text-secondary"><%= render "admins/shared/list_text", text: event.app.display_name, url: admins_app_path(event.app) %></div>
            </td>
            <td class="px-2"><%= render "status", event: event %></td>
            <td class="d-none d-lg-table-cell px-2 text-nowrap"><%= admin_list_time(event.created_at) %></td>
            <td class="px-2"><button type="button" class="btn btn-sm btn-info text-nowrap" data-bs-toggle="modal" data-bs-target="#<%= dom_id(event) %>"><%= render "layouts/admins/icon", name: :eye %>查看</button></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render partial: "event", collection: @events %>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { admins_wechat_notifications_path(app_id: @app&.id, page: page) } %>
  <% end %>
</section>
