<% content_for :title, "管理员 · Booking 管理后台" %>
<% empty = @administrators.empty? %>
<% content_for :fill_content, "true" if empty %>
<% filters = { q: @query.presence, status: @status }.compact %>

<%= render layout: "admins/shared/list_page_header", locals: { title: "管理员", icon: :users } do %>
  <%= link_to new_admins_administrator_path, class: "btn btn-primary text-nowrap" do %><%= render "layouts/admins/icon", name: :plus %>新增管理员<% end %>
<% end %>

<section class="card mb-3 flex-shrink-0" aria-label="管理员筛选条件">
  <div class="list-group list-group-flush">
    <%= render "admins/shared/list_filter_row", label: "账号状态", key: :status, options: Admins::AdministratorsController::STATUSES, selected: @status, filter_url: ->(changes) { admins_administrators_path(filters.merge(changes).compact) } %>
  </div>
</section>

<section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="管理员列表">
  <div class="card-header flex-shrink-0">
    <%= form_with url: admins_administrators_path, method: :get, class: "d-flex flex-wrap flex-lg-nowrap align-items-center gap-2 w-100", html: { role: "search", aria: { label: "搜索管理员" } } do |form| %>
      <% if @status %><%= hidden_field_tag :status, @status %><% end %>
      <div class="col-12 col-sm-5 col-lg-3 flex-shrink-0">
        <%= form.search_field :q, value: @query, class: "form-control text-truncate", placeholder: "用户名 / 姓名", aria: { label: "用户名或姓名" } %>
      </div>
      <%= form.button type: "submit", class: "btn flex-shrink-0 text-nowrap" do %><%= render "layouts/admins/icon", name: :search %>搜索<% end %>
      <% if filters.any? %>
        <%= link_to admins_administrators_path, class: "btn flex-shrink-0 text-nowrap" do %><%= render "layouts/admins/icon", name: :rotate %>重置筛选<% end %>
      <% end %>
    <% end %>
  </div>

  <% if empty %>
    <%= render "admins/shared/list_empty", icon: :users, title: (filters.any? ? "没有找到匹配的管理员" : "暂无管理员"), description: ("试试其他关键词，或重置筛选。" if filters.any?) %>
  <% else %>
    <table class="table table-fixed table-vcenter card-table table-hover admin-list-table mb-0">
      <thead><tr>
        <th scope="col" class="list-column-id px-2">ID</th>
        <th scope="col" class="px-2">用户名</th>
        <th scope="col" class="d-none d-sm-table-cell">姓名</th>
        <th scope="col" class="d-none d-md-table-cell">角色</th>
        <th scope="col" class="list-column-status px-2">状态</th>
        <th scope="col" class="list-column-time d-none d-lg-table-cell">最近登录</th>
        <th scope="col" class="list-column-time d-none d-xl-table-cell">创建时间</th>
        <th scope="col" class="list-column-action px-2">操作</th>
      </tr></thead>
      <tbody>
        <% @administrators.each do |administrator| %>
          <tr>
            <td class="text-secondary px-2"><%= render "admins/shared/list_text", text: "##{administrator.id}" %></td>
            <td class="px-2"><%= render "admins/shared/list_text", text: administrator.username %></td>
            <td class="d-none d-sm-table-cell"><%= render "admins/shared/list_text", text: administrator.name.presence || "—" %></td>
            <td class="d-none d-md-table-cell"><%= render "admins/shared/list_text", text: administrator.role_name %></td>
            <td class="px-2"><span class="badge bg-<%= administrator.enabled? ? 'success' : 'secondary' %>-lt"><%= administrator.enabled? ? "启用" : "停用" %></span></td>
            <td class="d-none d-lg-table-cell"><%= render "admins/shared/list_text", text: admin_list_time(administrator.current_sign_in_at, fallback: "尚未登录") %></td>
            <td class="d-none d-xl-table-cell"><%= render "admins/shared/list_text", text: admin_list_time(administrator.created_at) %></td>
            <td class="px-2"><%= link_to edit_admins_administrator_path(administrator), class: "btn btn-sm btn-outline-primary text-nowrap" do %><%= render "layouts/admins/icon", name: :edit %>编辑<% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { admins_administrators_path(filters.merge(page: page)) } %>
  <% end %>
</section>
