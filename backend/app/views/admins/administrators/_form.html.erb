<% form_id = dom_id(administrator, :form); confirmation_id = "disable-administrator" if administrator.persisted? && administrator.enabled_in_database %>
<%= render "admins/shared/enhanced_select_assets" %>
<%= form_with model: administrator, scope: :administrator, id: form_id, url: (administrator.persisted? ? admins_administrator_path(administrator) : admins_administrators_path), method: (administrator.persisted? ? :patch : :post), class: "card", data: { admin_form: true, disable_confirmation: confirmation_id } do |form| %>
  <div class="card-body">
    <%= render "admins/shared/form_errors", record: administrator %>
    <% if administrator.persisted? %>
      <div class="datagrid mb-4">
        <div class="datagrid-item"><div class="datagrid-title">最近登录</div><div class="datagrid-content"><%= admin_list_time(administrator.current_sign_in_at, fallback: "尚未登录") %></div></div>
        <div class="datagrid-item"><div class="datagrid-title">创建时间</div><div class="datagrid-content"><%= admin_list_time(administrator.created_at) %></div></div>
      </div>
    <% end %>
    <div class="row g-3">
      <% [[:username, "用户名"], [:name, "姓名"]].each do |field, label| %>
        <div class="col-md-6"><%= form.label field, label, class: class_names("form-label", "required" => field == :username) %>
          <%= form.text_field field, class: admin_field_class(administrator, field), required: field == :username, autocomplete: "off", aria: { describedby: "#{field}-error" } %>
          <%= admin_field_errors(administrator, field) %>
        </div>
      <% end %>
      <div class="col-md-6">
        <%= form.label :role, "角色", class: "form-label required" %>
        <%= form.select :role, Admin::ROLES.map { |value, label| [label, value] }, {}, class: admin_field_class(administrator, :role, "form-select"), data: { enhanced_select: "single" }, aria: { required: true, describedby: ("role-error" if administrator.errors[:role].any?) } %>
        <%= admin_field_errors(administrator, :role) %>
      </div>
      <div class="col-md-6">
        <%= form.label :enabled, "账号状态", class: "form-label required" %>
        <%= form.select :enabled, [["启用", true], ["停用", false]], {}, class: admin_field_class(administrator, :enabled, "form-select"), data: { enhanced_select: "single" }, aria: { required: true, describedby: ("enabled-error" if administrator.errors[:enabled].any?) } %>
        <%= admin_field_errors(administrator, :enabled) %>
      </div>
      <% password_hint = administrator.persisted? ? "留空保留原密码" : "留空使用默认密码 123456" %>
      <% [[:password, administrator.persisted? ? "重置密码" : "初始密码"], [:password_confirmation, "确认新密码"]].each do |field, label| %>
        <div class="col-md-6">
          <%= form.label field, label, class: "form-label" %>
          <div class="input-group input-group-flat">
            <%= form.password_field field, value: nil, class: admin_field_class(administrator, field), autocomplete: "new-password", placeholder: (password_hint if field == :password), aria: { describedby: ("#{field}-error" if administrator.errors[field].any?) } %>
            <span class="input-group-text"><%= render "admins/shared/password_toggle", input_id: form.field_id(field) %></span>
          </div>
          <%= admin_field_errors(administrator, field) %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="card-footer bg-transparent"><div class="btn-list justify-content-end">
    <%= link_to admins_administrators_path, class: "btn" do %><%= render "layouts/admins/icon", name: :close %>取消<% end %>
    <%= render "admins/shared/submit_button", label: "保存", icon: :save %>
  </div></div>
<% end %>
<% if confirmation_id %>
  <%= render "admins/shared/confirmation_modal", modal_id: confirmation_id, title: "确认停用管理员", context: administrator.display_name, description: "停用后，该账号将无法登录，现有登录也会失效。", confirm_label: "确认停用并保存", color: "warning", confirm_icon: :alert, cancel_icon: :close, form_id: form_id %>
<% end %>
