<% content_for :title, "上传体验版 · Booking 管理后台" %>
<%= render "admins/shared/enhanced_select_assets" %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "上传体验版", icon: :package } do %>
  <%= link_to admins_app_path(@app), class: "btn" do %><%= render "layouts/admins/icon", name: :arrow_left %>返回应用<% end %>
<% end %>
<%= form_with scope: :release, url: admins_app_releases_path(@app), class: "card", data: { admin_form: true } do |f| %>
  <div class="card-header"><h2 class="card-title text-break"><%= @app.display_name %> · <%= @app.appid %></h2></div>
  <div class="card-body"><div class="row g-3">
    <div class="col-md-6">
      <%= f.label :template_id, "微信代码模板", class: "form-label required" %>
      <% if @templates.any? %>
        <%= f.select :template_id, @templates.map { |row| ["#{row["template_id"]} · #{row["user_version"]} #{row["user_desc"]}", row["template_id"]] }, {}, required: true, class: "form-select", data: { enhanced_select: "single" } %>
      <% else %>
        <%= f.text_field :template_id, required: true, pattern: "[0-9]+", placeholder: "填写微信代码模板 ID", class: "form-control" %>
      <% end %>
    </div>
    <div class="col-md-6"><%= f.label :version, "版本号", class: "form-label required" %><%= f.text_field :version, required: true, class: "form-control" %></div>
    <div class="col-12"><%= f.label :description, "版本说明", class: "form-label required" %><%= f.text_area :description, required: true, rows: 3, class: "form-control" %></div>
  </div></div>
  <div class="card-footer bg-transparent"><div class="btn-list justify-content-end">
    <%= link_to admins_app_path(@app), class: "btn" do %><%= render "layouts/admins/icon", name: :close %>取消<% end %>
    <%= render "admins/shared/submit_button", label: "上传体验版", icon: :import %>
  </div></div>
<% end %>
