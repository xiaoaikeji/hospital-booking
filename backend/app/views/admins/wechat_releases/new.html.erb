<% content_for :title, "上传体验版 · Booking 管理后台" %>
<%= render "admins/shared/enhanced_select_assets" %>
<% content_for :head do %><%= javascript_include_tag "admins/releases", defer: true %><% end %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "上传代码", icon: :code } do %>
  <%= link_to admins_app_path(@app), class: "btn" do %><%= render "layouts/admins/icon", name: :arrow_left %>返回应用<% end %>
<% end %>
<section id="release-upload" class="card" data-templates="<%= templates_admins_mini_program_releases_path %>" data-destination="<%= admins_mini_program_releases_path(app_id: @app.id) %>">
  <%= form_with scope: :release, url: admins_app_releases_path(@app), data: { release_form: true } do |f| %>
    <div class="card-body"><%= render "admins/mini_program_releases/upload_fields", f: f, apps: [@app], templates: @templates %></div>
    <div class="card-footer bg-transparent btn-list justify-content-end">
      <%= link_to "取消", admins_app_path(@app), class: "btn" %><%= render "admins/shared/submit_button", label: "确认上传", icon: :import %>
    </div>
  <% end %>
</section>
