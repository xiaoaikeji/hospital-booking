<% editable = @editable %>
<% can_return = editable && reservation.hospital_can_return? %>
<% can_refund = editable && reservation.price_refund_allowed? && reservation.available_refund_cents.positive? %>
<% pending, history = reservation.refund_items.reverse.partition { |item| item["status"] == "requested" } %>
<% if can_return || can_refund || pending.any? || history.any? %>
  <div class="col-12">
    <section class="card" aria-labelledby="reservation-refunds-title">
      <div class="card-header flex-wrap gap-2">
        <h2 class="card-title" id="reservation-refunds-title">退号与退款记录</h2>
        <% if can_return || can_refund %>
          <div class="card-actions btn-list">
            <% if can_return %>
              <button type="button" class="btn btn-outline-warning text-nowrap" data-bs-toggle="modal" data-bs-target="#refund-return"><%= render "layouts/admins/icon", name: :alert %><%= reservation.return_failed? ? "重新发起退号退款" : "医院退号" %></button>
            <% end %>
            <% if can_refund %>
              <button type="button" class="btn btn-outline-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#refund-difference"><%= render "layouts/admins/icon", name: :wallet %>退差价</button>
            <% end %>
          </div>
        <% end %>
      </div>
      <% if pending.any? || history.any? %>
        <div class="list-group list-group-flush">
          <% (pending + history).each do |item| %>
            <%= render "refund_record", reservation: reservation, item: item, editable: editable %>
          <% end %>
        </div>
      <% else %>
        <div class="card-body text-secondary">暂无退号与退款记录</div>
      <% end %>
    </section>
    <%= render "refund_request_modals", reservation: reservation, can_return: can_return, can_refund: can_refund if can_return || can_refund %>
  </div>
<% end %>
