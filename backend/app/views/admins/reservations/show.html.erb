<% reservation = @reservation %>
<% can_cancel_payment = @editable && reservation.pending_payment? && !reservation.payment_cancel_requested_at? %>
<% content_for :title, "#{reservation.order_no} · 预约详情 · Booking 管理后台" %>
<% content_for :mobile_theme_menu, "true" %>
<% content_for :head do %>
  <%= javascript_include_tag "admins/reservation_refunds", defer: true %>
<% end %>

<%= render layout: "admins/shared/list_page_header", locals: { title: "预约详情", icon: :calendar } do %>
  <% if @editable && reservation.can_complete? %>
    <button type="button" class="btn btn-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#confirm-completed-visit"><%= render "layouts/admins/icon", name: :check %>登记已就诊</button>
  <% end %>
  <%= link_to reservation_list_return_path, class: "btn text-nowrap" do %><%= render "layouts/admins/icon", name: :arrow_left %>返回列表<% end %>
<% end %>

<% if @editable && reservation.can_complete? %>
  <%= form_with url: complete_admins_reservation_path(reservation.order_no, @list_context), method: :patch, id: "complete-visit", hidden: true do %><% end %>
  <% description = "请确认患者已经就诊。登记后，预约将办结并关闭退号入口。" %>
  <% if reservation.refund_items.any? { |item| item["kind"] == "cancel" && item["status"] == "requested" } %>
    <% description += "当前待审核的退号申请将被拒绝。" %>
  <% end %>
  <%= render "admins/shared/confirmation_modal", modal_id: "confirm-completed-visit", form_id: "complete-visit", color: "warning",
    title: "登记已就诊", context: reservation.order_no, description: description,
    cancel_icon: :close, confirm_icon: :check, confirm_label: "确定登记" %>
<% end %>

<section class="card mb-3" aria-label="预约概要">
  <div class="card-body">
    <div class="row g-3 align-items-center">
      <div class="col-auto"><span class="avatar avatar-lg bg-primary-lt"><%= render "layouts/admins/icon", name: :calendar, icon_class: "w-5 h-5" %></span></div>
      <div class="col">
        <div class="d-flex flex-wrap align-items-center gap-2">
          <h2 class="h2 mb-0 text-break"><%= reservation.order_no %></h2>
          <%= reservation_badge(reservation) %>
          <% if reservation.deleted_at? %><span class="badge bg-secondary-lt">已归档</span><% end %>
        </div>
        <div class="text-secondary mt-1">创建于 <%= admin_list_time(reservation.created_at) %></div>
        <% if reservation.completed_at %>
          <div class="text-secondary mt-1">登记就诊于 <%= admin_list_time(reservation.completed_at) %><%= " · #{reservation.completed_by_admin.display_name}" if reservation.completed_by_admin %></div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<div class="row row-cards">
  <div class="col-lg-7">
    <section class="card h-100" aria-labelledby="reservation-info-title">
      <div class="card-header"><h2 class="card-title" id="reservation-info-title">预约信息</h2></div>
      <div class="card-body">
        <%= render "admins/shared/field_rows", fields: {
          "预约医生" => reservation.doctor_name, "科室" => reservation.department_name,
          "预约时间" => "#{reservation.appointment_date.iso8601} · #{reservation.slot_label}",
          "就诊医院" => reservation.hospital_snapshot["company_name"], "就诊地址" => reservation.hospital_snapshot["address"],
          "预约来源" => "#{App::PROVIDERS.fetch(reservation.source_platform)}小程序", "症状描述" => reservation.remark
        }, full: ["预约时间", "症状描述"] %>
      </div>
    </section>
  </div>
  <div class="col-lg-5">
    <section class="card h-100" aria-labelledby="reservation-patient-title">
      <div class="card-header"><h2 class="card-title" id="reservation-patient-title">就诊人信息</h2></div>
      <div class="card-body">
        <% patient_fields = {
          "姓名" => reservation.patient_name, "性别" => reservation.patient_sex, "年龄" => "#{reservation.patient_age} 岁",
          "联系电话" => reservation.patient_mobile,
          "预约账号" => link_to(reservation.user.user_no, admins_customer_path(reservation.user))
        } %>
        <%= render "admins/shared/field_rows", fields: patient_fields, full: patient_fields.keys %>
      </div>
    </section>
  </div>
  <div class="col-12">
    <%= render "fees", reservation: reservation, can_cancel_payment: can_cancel_payment %>
  </div>
  <%= render "admins/reservations/refunds", reservation: reservation %>
</div>

<%= render "history" %>

<% if can_cancel_payment %>
  <% cancellation_form = capture do %>
    <%= form_with scope: :payment_cancellation, url: cancel_pending_payment_admins_reservation_path(reservation.order_no, @list_context),
      id: "cancel-pending-payment" do |form| %>
      <%= form.label :reason, "取消原因", class: "form-label required" %>
      <%= form.text_area :reason, class: "form-control", rows: 2, maxlength: Appointments::Payment::CANCEL_REASON_LIMIT, required: true %>
    <% end %>
  <% end %>
  <%= render "admins/shared/confirmation_modal", modal_id: "confirm-cancel-pending-payment",
    form_id: "cancel-pending-payment", form_body: cancellation_form, color: "warning",
    title: "取消待支付预约", context: reservation.order_no, description: "提交后停止续付。关单确认后释放号源，微信已收款时保留预约。",
    cancel_icon: :close, confirm_icon: :check, confirm_label: "确定取消预约" %>
<% end %>
