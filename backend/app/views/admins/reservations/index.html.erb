<% content_for :title, "预约列表 · Booking 管理后台" %>
<%= render "admins/shared/enhanced_select_assets" %>
<% empty = @reservations.empty? %>
<% content_for :fill_content, "true" if empty %>
<% filter_url = ->(changes) { admins_reservations_path(@filters.merge(changes).compact) } %>
<% filtered = @filters.any? %>

<%= render "admins/shared/list_page_header", title: "预约列表", icon: :calendar %>

<section class="card mb-3 flex-shrink-0" aria-label="预约筛选条件">
  <div class="list-group list-group-flush">
    <%= render "admins/shared/list_filter_row", label: "科室", key: :department_id, options: @department_options,
      selected: @filters[:department_id], filter_url: filter_url %>
    <%= render "admins/shared/list_filter_row", label: "预约状态", key: :status, options: Appointment::STATUS_LABELS,
      selected: @filters[:status], filter_url: filter_url %>
    <%= render "admins/shared/list_filter_row", label: "退款状态", key: :refund_status, options: Appointment::REFUND_LABELS.except("none").merge("requested" => "待审核"),
      selected: @filters[:refund_status], filter_url: filter_url %>
  </div>
</section>

<section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="预约记录">
  <div class="card-header flex-shrink-0">
    <%= form_with url: admins_reservations_path, method: :get, class: "row g-2 align-items-center w-100", html: { role: "search", aria: { label: "搜索预约" } } do |form| %>
      <% @filters.except(:q, :period, :date_range, :booking_time).each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
      <div class="col-12 col-sm-6 col-lg-3">
        <%= form.search_field :q, value: @filters[:q], class: "form-control", placeholder: "预约号", aria: { label: "预约号" } %>
      </div>
      <div class="col-12 col-sm-6 col-lg-4">
        <%= render "admins/shared/date_field", id: "reservation-date-range", name: :date_range, value: @date_range,
          prefix: "预约日期", selection_mode: "multiple-ranged", placeholder: "起止日期", clearable: false %>
      </div>
      <div class="col-12 col-sm-6 col-lg-2">
        <%= form.select :booking_time, @time_options, { include_blank: "全部时段", selected: @filters[:booking_time] },
          class: "form-select", data: { enhanced_select: "single" }, aria: { label: "预约时段" } %>
      </div>
      <div class="col-auto btn-list">
        <%= form.button type: "submit", class: "btn text-nowrap" do %><%= render "layouts/admins/icon", name: :search %>搜索<% end %>
        <% if filtered %>
          <%= link_to admins_reservations_path, class: "btn text-nowrap" do %><%= render "layouts/admins/icon", name: :rotate %>重置筛选<% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if empty %>
    <%= render "admins/shared/list_empty", icon: :calendar, title: (filtered ? "没有找到匹配的预约" : "暂无预约") %>
  <% else %>
    <%= render "appointments_table", reservations: @reservations, list_context: @list_context %>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { filter_url.call(page: page) } %>
  <% end %>
</section>
