<% content_for :title, "预约列表 · Booking 管理后台" %>
<% empty = @reservations.empty? %>
<% content_for :fill_content, "true" if empty %>
<% filter_url = ->(changes) { admins_reservations_path(@filters.merge(changes).compact) } %>

<%= render "admins/shared/list_page_header", title: "预约列表", icon: :calendar %>

<section class="card mb-3 flex-shrink-0" aria-label="预约筛选条件">
  <div class="list-group list-group-flush">
    <%= render "admins/shared/list_filter_row", label: "预约日期", key: :period, options: Admins::ReservationsController::PERIODS,
      selected: @filters[:period], filter_url: filter_url %>
  </div>
</section>

<section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="预约记录">
  <div class="card-header flex-shrink-0">
    <%= form_with url: admins_reservations_path, method: :get, class: "d-flex flex-wrap align-items-center gap-2 w-100", html: { role: "search", aria: { label: "搜索预约" } } do |form| %>
      <%= hidden_field_tag :period, @filters[:period] if @filters.key?(:period) %>
      <div class="col-12 col-sm-5 col-lg-3">
        <%= form.search_field :q, value: @filters[:q], class: "form-control", placeholder: "预约号", aria: { label: "预约号" } %>
      </div>
      <%= form.button type: "submit", class: "btn text-nowrap" do %><%= render "layouts/admins/icon", name: :search %>搜索<% end %>
      <% if @filters.any? %>
        <%= link_to admins_reservations_path, class: "btn text-nowrap" do %><%= render "layouts/admins/icon", name: :rotate %>重置筛选<% end %>
      <% end %>
    <% end %>
  </div>

  <% if empty %>
    <%= render "admins/shared/list_empty", icon: :calendar, title: (@filters.any? ? "没有找到匹配的预约" : "暂无预约记录") %>
  <% else %>
    <table class="table table-fixed table-vcenter card-table table-hover admin-list-table mb-0">
      <thead><tr>
        <th scope="col" class="list-column-id px-2">ID</th>
        <th scope="col" class="px-2">预约号</th>
        <th scope="col" class="d-none d-md-table-cell px-2">就诊人</th>
        <th scope="col" class="d-none d-lg-table-cell px-2">医生 / 科室</th>
        <th scope="col" class="d-none d-md-table-cell list-column-status px-2">状态</th>
        <th scope="col" class="d-none d-sm-table-cell px-2">预约时段</th>
        <th scope="col" class="list-column-action px-2">操作</th>
      </tr></thead>
      <tbody>
        <% @reservations.each do |record| %>
          <% detail = admins_reservation_path(record.order_no, @list_context) %>
          <tr>
            <td class="text-secondary px-2"><%= render "admins/shared/list_text", text: "##{record.id}" %></td>
            <td class="px-2 text-break"><%= link_to record.order_no, detail %></td>
            <td class="d-none d-md-table-cell px-2"><%= render "admins/shared/list_text", text: record.patient_name %></td>
            <td class="d-none d-lg-table-cell px-2">
              <%= render "admins/shared/list_text", text: record.doctor_name %>
              <%= render "admins/shared/list_text", text: record.department_name, class_name: "small text-secondary" %>
            </td>
            <td class="d-none d-md-table-cell px-2">
              <span class="badge bg-blue-lt"><%= record.status_label %></span>
              <% if record.refund_status != "none" %><div class="small text-secondary"><%= record.refund_label %></div><% end %>
            </td>
            <td class="d-none d-sm-table-cell px-2">
              <div><%= record.appointment_date.iso8601 %></div>
              <%= render "admins/shared/list_text", text: record.slot_label, class_name: "small text-secondary" %>
            </td>
            <td class="px-2"><%= link_to detail, class: "btn btn-sm btn-info text-nowrap", aria: { label: "查看预约 #{record.order_no}" } do %><%= render "layouts/admins/icon", name: :eye %>查看<% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { filter_url.call(page: page) } %>
  <% end %>
</section>
