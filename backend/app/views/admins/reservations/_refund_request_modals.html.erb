<% remaining = Appointment.cents_in_yuan(reservation.available_refund_cents) %>
<% actions = [] %>
<% actions << ["return", "医院退号", return_booking_admins_reservation_path(reservation.order_no, @list_context)] if can_return %>
<% actions << ["difference", "退差价", refund_difference_admins_reservation_path(reservation.order_no, @list_context)] if can_refund %>

<% actions.each do |kind, title, url| %>
  <% difference = kind == "difference" %>
  <% waiting = !difference && reservation.refund_difference_pending? %>
  <div class="modal modal-blur fade" id="refund-<%= kind %>" tabindex="-1" aria-labelledby="refund-<%= kind %>-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title" id="refund-<%= kind %>-title"><%= title %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
        </div>
        <%= form_with scope: :refund, url: url, data: {
          refund_draft: kind, refund_title: title,
          refund_effect: (difference ? "原预约保留" : (reservation.return_failed? ? "原预约已取消" : "将取消预约"))
        } do |form| %>
          <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid, id: nil %>
          <%= form.hidden_field :confirmed_available, value: reservation.available_refund_cents, disabled: true, id: nil %>
          <div class="modal-body">
            <% if difference %>
              <div class="mb-3">
                <%= form.label :amount, "退差价金额", class: "form-label required", for: "difference-amount" %>
                <div class="input-group">
                  <%= form.number_field :amount, id: "difference-amount", class: "form-control", min: "0.01", step: "0.01",
                    max: remaining, required: true, aria: { describedby: "refund-available" } %>
                  <span class="input-group-text">元</span>
                </div>
                <p id="refund-available" class="form-hint mb-0">当前可退 <%= remaining %> 元</p>
              </div>
            <% else %>
              <p>当前可退 <%= remaining %> 元</p>
              <% if waiting %><p class="text-secondary">已有退差价尚未办结，收到微信结果后可确认退号。</p><% end %>
            <% end %>
            <%= form.label :reason, "#{difference ? '退差价' : '退号'}原因", class: "form-label required", for: "#{kind}-reason" %>
            <%= form.text_area :reason, class: "form-control", id: "#{kind}-reason", rows: 2, maxlength: 500, required: true %>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn me-auto" data-bs-dismiss="modal">取消</button>
            <%= tag.button "核对退款", type: "submit", class: "btn btn-primary", disabled: waiting %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% summary = capture do %>
  <dl class="mb-0">
    <dt class="visually-hidden">金额</dt>
    <dd class="fs-2 fw-bold mb-2" data-refund-summary-amount></dd>
    <dt class="text-secondary">原因</dt>
    <dd class="text-break mb-0" data-refund-summary-reason></dd>
  </dl>
<% end %>
<%= render "admins/shared/confirmation_modal", modal_id: "confirm-hospital-refund", color: "warning",
  title: "确认退款", context: reservation.order_no, description: "", summary: summary,
  cancel_label: "返回修改", cancel_data: { refund_back: true },
  confirm_label: "确认退款", confirm_class: "text-dark", confirm_data: { bs_dismiss: nil, refund_submit: true }, preview_note: false %>
