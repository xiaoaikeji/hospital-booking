<% cancel = item["kind"] == "cancel" %>
<% no_charge = cancel && item["amount_cents"] == 0 %>
<% label = no_charge && item["status"] == "succeeded" ? "已退号" : Appointment::REFUND_ITEM_LABELS.fetch(item["status"]) %>
<% cash = "#{Appointment.cents_in_yuan(item["payer_refund_cents"])} 元" unless item["payer_refund_cents"].nil? %>
<% cash ||= "待核对" if item["amount_cents"].to_i.positive? && item["status"] == "succeeded" %>
<% amount = "#{Appointment.cents_in_yuan(item["amount_cents"])} 元" if item["amount_cents"] %>
<% anchor = reservation_refund_anchor(item) %>

<article class="list-group-item py-3" id="<%= anchor %>">
  <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <h3 class="h4 mb-0"><%= cancel ? "退号" : "退差价" %></h3>
    <%= reservation_refund_badge(item["status"], label) %>
  </div>
  <% fields = { "退款单号" => (item["refund_no"] unless no_charge),
    "发起人" => (item["requested_by_type"] == "Admin" ? @refund_admins[item["requested_by_id"]]&.display_name : "患者"),
    "审核人" => @refund_admins[item["reviewed_by_admin_id"]]&.display_name,
    "申请时间" => (admin_list_time(Time.iso8601(item["created_at"])) if item["created_at"].present?),
    "退款金额" => (amount unless no_charge),
    "原因" => item["reason"], "审核意见" => item["review_note"],
    "现金退款" => cash,
    "退款时间" => (admin_list_time(Time.iso8601(item["refunded_at"])) if item["refunded_at"])
  }.compact %>
  <%= render "admins/shared/field_rows", fields: fields, full: ["原因", "审核意见"] %>

  <% if editable && item["status"] == "requested" %>
    <% available = reservation.refund_confirmation_balance(item) %>
    <% free_return = cancel && available.zero? %>
    <% waiting = cancel && reservation.refund_difference_pending? %>
    <% confirm_amount = format("%.2f", (cancel ? available : item.fetch("amount_cents")).to_d / 100) %>
    <% review_summary = capture do %>
      <% unless free_return %><p class="fs-2 fw-bold mb-2">本次退款 <%= confirm_amount %> 元</p><% end %>
      <% if item["reason"].present? %>
        <p class="text-break mb-0"><%= item["reason"] %></p>
      <% end %>
    <% end %>
    <%= form_with scope: :refund, url: review_refund_admins_reservation_path(reservation.order_no, item["id"], @list_context),
      method: :patch, id: "#{anchor}-review", class: "mt-3", data: { refund_review: true } do |form| %>
      <%= form.hidden_field :confirmed_available, value: available, id: nil %>
      <%= form.label :note, "审核意见（拒绝时必填）", for: "#{anchor}-note", class: "form-label" %>
      <%= form.text_area :note, id: "#{anchor}-note", class: "form-control", rows: 2, maxlength: 500 %>
      <div class="btn-list justify-content-end mt-3 pe-md-4">
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#<%= anchor %>-rejection"><%= render "layouts/admins/icon", name: :close %>拒绝</button>
        <% unless waiting %>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#<%= anchor %>-approval"><%= render "layouts/admins/icon", name: :check %>审核同意</button>
          <button type="submit" name="refund[decision]" value="approve" id="<%= anchor %>-approve" hidden></button>
        <% end %>
        <button type="submit" name="refund[decision]" value="reject" id="<%= anchor %>-reject" hidden></button>
      </div>
    <% end %>
    <% if waiting %>
      <p class="text-secondary mt-2 mb-0">已有退差价尚未办结，收到微信结果后可审核同意。</p>
    <% else %>
      <%= render "admins/shared/confirmation_modal", modal_id: "#{anchor}-approval", form_id: "#{anchor}-review",
        submitter_id: "#{anchor}-approve", color: "warning", title: (cancel ? "同意退号申请" : "同意退差价申请"),
        context: reservation.order_no, description: (free_return ? "确认后取消预约并释放号源" : (cancel ? "将取消预约" : "原预约保留")), summary: review_summary,
        cancel_label: "返回修改", confirm_class: "text-dark", confirm_label: (free_return ? "确认退号" : "确认退款 ¥#{confirm_amount}") %>
    <% end %>
    <%= render "admins/shared/confirmation_modal", modal_id: "#{anchor}-rejection", form_id: "#{anchor}-review",
      submitter_id: "#{anchor}-reject", color: "warning", title: (cancel ? "拒绝退号申请" : "拒绝退差价申请"),
      context: reservation.order_no, description: "原预约保留", cancel_label: "返回修改", confirm_class: "text-dark", confirm_label: "确认拒绝" %>
  <% elsif editable && item["attempted"] && (item["status"] == "processing" || (item["status"] == "succeeded" && item["payer_refund_cents"].nil?)) %>
    <div class="btn-list justify-content-end mt-3 pe-md-4">
      <%= button_to sync_refund_admins_reservation_path(reservation.order_no, item["id"], @list_context),
        method: :post, class: "btn btn-sm btn-outline-secondary" do %><%= render "layouts/admins/icon", name: :rotate %>核对微信退款<% end %>
    </div>
  <% end %>
</article>
