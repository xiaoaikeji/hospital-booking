<table class="table table-fixed table-vcenter card-table table-hover admin-list-table mb-0">
  <thead><tr>
    <th scope="col" class="list-column-id px-2">ID</th>
    <th scope="col" class="px-2">预约号</th>
    <th scope="col" class="d-none d-lg-table-cell px-2">就诊人 / 科室</th>
    <th scope="col" class="d-none d-sm-table-cell px-2">申请类型</th>
    <th scope="col" class="px-2">申请金额</th>
    <th scope="col" class="d-none d-md-table-cell list-column-time px-2">申请时间</th>
    <th scope="col" class="list-column-action px-2">操作</th>
  </tr></thead>
  <tbody>
    <% reservations.each do |record| %>
      <% item = record[:pending_refund] %>
      <% decision_url = admins_reservation_path(record.order_no, list_context.merge(anchor: reservation_refund_anchor(item))) %>
      <% type = item["kind"] == "cancel" ? "退号" : "退差价" %>
      <tr>
        <td class="text-secondary px-2"><%= render "admins/shared/list_text", text: "##{record.id}" %></td>
        <td class="px-2">
          <%= render "admins/shared/list_text", text: record.order_no, url: decision_url %>
          <div class="d-sm-none small text-secondary mt-1"><%= type %></div>
        </td>
        <td class="d-none d-lg-table-cell px-2">
          <%= render "admins/shared/list_text", text: record.patient_name %>
          <div class="small text-secondary"><%= render "admins/shared/list_text", text: record.department_name %></div>
        </td>
        <td class="d-none d-sm-table-cell px-2"><%= type %></td>
        <td class="px-2"><%= render "admins/shared/list_text", text: (item["amount_cents"] ? "#{Appointment.cents_in_yuan(item['amount_cents'])} 元" : "待核对") %></td>
        <td class="d-none d-md-table-cell px-2"><%= render "admins/shared/list_text", text: admin_list_time(Time.iso8601(item.fetch("created_at"))) %></td>
        <td class="px-2"><%= link_to decision_url, class: "btn btn-sm btn-info text-nowrap" do %><%= render "layouts/admins/icon", name: :eye %>查看<% end %></td>
      </tr>
    <% end %>
  </tbody>
</table>
