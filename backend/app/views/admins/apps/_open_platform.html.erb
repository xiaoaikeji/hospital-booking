<% account = @app.open_platform_account
   pending = OpenPlatformOperation.find_by(app_id: @app.id) %>
<section class="card" aria-label="开放平台账号">
  <div class="card-header flex-wrap gap-2">
    <h2 class="card-title">开放平台账号</h2>
    <% if @app.platform_authorized? %><div class="card-actions btn-list">
      <%= button_to admins_app_open_platform_path(@app, application_context_params), method: :patch, class: "btn" do %><%= render "layouts/admins/icon", name: :rotate %>同步绑定状态<% end %>
      <% if !account && !pending %>
        <%= link_to new_admins_open_platform_account_path(app_id: @app.id), class: "btn btn-primary" do %><%= render "layouts/admins/icon", name: :plus %>新增开放平台账号<% end %>
      <% end %>
    </div><% end %>
  </div>
  <div class="card-body">
    <% if pending %><div class="alert alert-warning" role="status">上次<%= OpenPlatformOperation::LABELS.fetch(pending.action) %>的结果待核实，请同步绑定状态。</div><% end %>
    <% if account %>
      <%= render "admins/shared/field_rows", fields: { "账号名称" => link_to(account.name, admins_open_platform_account_path(account)), "开放平台 AppID" => account.open_appid } %>
    <% else %><p class="text-secondary mb-0">本地尚未登记绑定的开放平台账号。</p><% end %>
    <% unless @app.platform_authorized? %><p class="mt-2 mb-0"><%= link_to "恢复平台授权", admins_app_path(@app, application_context_params) %>后可同步微信当前绑定状态。</p><% end %>
  </div>
</section>
