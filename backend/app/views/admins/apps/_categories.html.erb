<%= render "admins/shared/enhanced_select_assets" %>
<% settings = @category_page.fetch(:settings); categories = settings.fetch("categories"); pending = @category_page[:pending] %>
<section class="card" aria-labelledby="categories-title">
  <div class="card-header flex-wrap gap-2">
    <h2 class="card-title" id="categories-title">服务类目 <span class="text-secondary">（<%= categories.size %>）</span></h2>
    <div class="card-actions btn-list">
      <%= link_to admins_app_path(@app, application_context_params.merge(tab: "categories")), class: "btn" do %><%= render "layouts/admins/icon", name: :rotate %>重新读取<% end %>
      <% if !pending && !@category_page[:blocked] && @category_page[:options].any? %>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#category-modal"><%= render "layouts/admins/icon", name: :plus %>新增服务类目</button>
      <% end %>
    </div>
  </div>
  <% if pending %>
    <div class="card-body">
      <p class="text-warning">上次<%= pending.action == "wechat.category_add" ? "新增" : "删除" %>类目 <%= pending.details.values_at("first", "second").join(" / ") %> 的结果待核实。</p>
      <%= form_with url: verify_admins_app_categories_path(@app, application_context_params), class: "d-flex flex-wrap gap-2 align-items-center" do |form| %>
        <%= form.hidden_field :operation_id, value: pending.id %>
        <%= form.select :outcome, [["微信已执行", "applied"], ["微信未执行", "not_applied"]], {}, class: "form-select w-auto", data: { enhanced_select: "single" }, aria: { label: "上次操作结果" } %>
        <label class="form-check mb-0"><%= form.check_box :confirmed, class: "form-check-input", required: true %><span>已核实微信后台当前类目</span></label>
        <%= render "admins/shared/submit_button", label: "登记核实结果", icon: :check %>
      <% end %>
    </div>
  <% elsif @category_page[:blocked] %><p class="text-warning px-3 pt-3 mb-0" role="status"><%= @category_page[:blocked] %></p><% end %>
  <% @category_page[:waiting].each do |entry| %>
    <div class="card-body border-top">
      <p>类目 <%= entry.first_category %> / <%= entry.second_category %> 已受理，等待微信列表更新。</p>
      <%= form_with url: verify_admins_app_categories_path(@app, application_context_params), class: "d-flex flex-wrap align-items-center gap-2" do |form| %>
        <%= form.hidden_field :acceptance_id, value: entry.id %>
        <label class="form-check mb-0"><%= form.check_box :confirmed, class: "form-check-input", required: true %><span>已在微信公众平台确认本次申请被拒或该类目已移除</span></label>
        <%= render "admins/shared/submit_button", label: "登记核实结果", icon: :check %>
      <% end %>
    </div>
  <% end %>
  <% quota = [("本月剩余 #{settings['quota']} 次" if settings['quota']), ("最多 #{settings['category_limit']} 个类目" if settings['category_limit'])].compact %>
  <% if quota.any? %><p class="text-secondary small px-3 py-2 mb-0"><%= quota.join(" · ") %></p><% end %>
  <% if categories.empty? %>
    <%= render "admins/shared/list_empty", icon: :package, title: "暂无服务类目" %>
  <% else %>
    <div class="table-responsive"><table class="table table-vcenter card-table table-hover mb-0">
      <thead><tr>
        <th scope="col"><span class="d-none d-sm-inline">一级类目</span><span class="d-sm-none">服务类目</span></th>
        <th scope="col" class="d-none d-sm-table-cell">二级类目</th><th scope="col">审核状态</th>
        <th scope="col" class="d-none d-sm-table-cell">审核意见</th><th scope="col">操作</th>
      </tr></thead>
      <tbody><% categories.each do |row| %><tr>
        <td><%= row["first_name"] %><span class="d-block d-sm-none small text-secondary"><%= row["second_name"] %></span></td>
        <td class="d-none d-sm-table-cell"><%= row["second_name"] %></td>
        <% label, color = { 1 => ["审核中", "warning"], 2 => ["未通过", "danger"], 3 => ["已通过", "success"] }.fetch(row["audit_status"].to_i, ["未知", "secondary"]) %>
        <td><span class="badge bg-<%= color %>-lt"><%= label %></span><span class="d-block d-sm-none small text-secondary text-break"><%= row["audit_reason"] %></span></td>
        <td class="d-none d-sm-table-cell text-break"><%= row["audit_reason"].presence || "—" %></td>
        <td><% unless pending %><button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#category-remove-<%= row['first'] %>-<%= row['second'] %>-confirm"><%= render "layouts/admins/icon", name: :trash %>删除</button><% end %></td>
      </tr><% end %></tbody>
    </table></div>
  <% end %>
  <% if (event = @category_page[:last_event]) %><div class="card-footer text-secondary small">最近审核通知 · <%= event.details.values_at("first", "second").join(" / ") %> · <%= event.details["result"] == "3" ? "审核通过" : "审核未通过" %> · <%= admin_list_time(Time.zone.at(event.details.fetch("occurred_at").to_i)) %></div><% end %>
</section>
<% if !pending && !@category_page[:blocked] && @category_page[:options].any? %><%= render "admins/apps/category_dialog" %><% end %>
<% unless pending %>
  <% categories.each do |row| %>
    <% key = "#{row['first']}-#{row['second']}"; form_id = "category-remove-#{key}" %>
    <%= form_with url: admins_app_category_path(@app, key, application_context_params), method: :delete, id: form_id do |form| %>
      <%= form.hidden_field :revision, value: @category_page[:revision], id: nil %>
    <% end %>
    <%= render "admins/shared/confirmation_modal", modal_id: "#{form_id}-confirm", form_id: form_id, title: "删除服务类目", context: "#{@app.display_name} · #{row['first_name']} / #{row['second_name']}", description: "确认从此小程序删除该类目？再次申请须按微信要求提交资质与审核。", color: "danger", confirm_label: "确认删除", confirm_icon: :trash, cancel_icon: :close %>
  <% end %>
<% end %>
