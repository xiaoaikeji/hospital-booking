<% content_for :title, title %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<%= render "admins/shared/enhanced_select_assets" %>
<%= render layout: "admins/shared/list_page_header", locals: { title: title, icon: :package } do %>
  <%= link_to "返回列表", admins_apps_path, class: "btn" %>
<% end %>
<% config = AppConfiguration.new(@app) %>
<% value, source = config.credential %>
<%= form_with model: [:admins, @app], class: "card" do |f| %>
  <div class="card-body row g-3">
    <%= render "admins/shared/form_errors", record: @app %>
    <div class="col-md-6"><%= f.label :provider, "平台", class: "form-label" %>
      <%= f.select :provider, App::PROVIDERS.invert, {}, disabled: @app.persisted?, class: "form-select", data: { enhanced_select: "single" } %></div>
    <div class="col-md-6"><%= f.label :appid, "AppID", class: "form-label" %>
      <%= f.text_field :appid, required: true, readonly: @app.persisted?, class: "form-control" %></div>
    <div class="col-md-6"><%= f.label :nickname, "名称", class: "form-label" %><%= f.text_field :nickname, class: "form-control" %></div>
    <div class="col-md-6"><%= f.label :status, "运行状态", class: "form-label" %>
      <%= f.select :status, App::STATUSES.invert, {}, class: "form-select", data: { enhanced_select: "single" } %></div>
    <div class="col-12"><%= f.label :appsecret, "AppSecret（#{source}）", class: "form-label" %>
      <%= f.text_field :appsecret, value: value, autocomplete: "off", class: "form-control" %>
      <% if @app.persisted? %><%= f.hidden_field :revision, value: config.revision([value, source]) %><% end %>
      <% if source == "加密数据库" %><label class="form-check mt-2"><%= f.check_box :clear_secret, class: "form-check-input" %>清除数据库覆盖</label><% end %></div>
    <div class="col-12"><%= f.label :memo, "备注", class: "form-label" %><%= f.text_area :memo, class: "form-control" %></div>
  </div>
  <div class="card-footer text-end"><%= render "admins/shared/submit_button", label: "保存", icon: :save %></div>
<% end %>
