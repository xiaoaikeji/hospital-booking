<% content_for :title, "#{title} · Booking 管理后台" %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<%= render "admins/shared/enhanced_select_assets" %>
<% content_for :head do %><%= javascript_include_tag "admins/app_type", defer: true unless @app.persisted? %><% end %>
<% confirm_id = "disable-app" if @app.persisted? && @app.status_in_database != "disabled" %>
<% disable_only = confirm_id && @credential_unavailable %>
<% clearable = ["加密数据库", AppConfiguration::DAMAGED_SOURCE]
   can_clear = clearable.include?(@credentials.fetch(:appsecret).last)
   can_clear_callback = AppConfiguration::CALLBACK_FIELDS.any? { |field| clearable.include?(@credentials[field]&.last) } %>
<%= render layout: "admins/shared/list_page_header", locals: { title: title, icon: :device_mobile } do %>
  <%= link_to admins_apps_path(application_list_context), class: "btn text-nowrap" do %><%= render "layouts/admins/icon", name: :arrow_left %>返回列表<% end %>
<% end %>
<%= form_with model: [:admins, @app], id: "app-form", class: "card", data: { admin_form: true, disable_confirmation: confirm_id, disable_field: "app[status]", disable_value: "disabled" } do |f| %>
  <% application_list_context.each do |key, value| %><%= hidden_field_tag "list[#{key}]", value, id: nil %><% end %>
  <div class="card-header"><h2 class="card-title">基本资料</h2></div>
  <div class="card-body">
    <%= render "admins/shared/form_errors", record: @app %>
    <div class="row g-3">
      <div class="col-md-6 col-xl-4">
        <%= f.label :provider, "平台", class: "form-label required" %>
        <%= f.select :provider, App::PROVIDERS.invert, {}, disabled: @app.persisted?, required: true, class: admin_field_class(@app, :provider, "form-select"), data: { enhanced_select: "single" }, aria: { describedby: ("provider-error" if @app.errors[:provider].any?) } %>
        <%= admin_field_errors(@app, :provider) %>
      </div>
      <div class="col-md-6 col-xl-4">
        <%= f.label :app_type, "应用类型", class: "form-label required" %>
        <%= f.select :app_type, App::TYPES.invert, {}, disabled: @app.persisted?, class: admin_field_class(@app, :app_type, "form-select"), data: { enhanced_select: "single" }, aria: { describedby: ("app_type-error" if @app.errors[:app_type].any?) } %>
        <%= admin_field_errors(@app, :app_type) %>
      </div>
      <div class="col-md-6 col-xl-4">
        <%= f.label :appid, "AppID", class: "form-label required" %>
        <%= f.text_field :appid, required: true, readonly: @app.persisted?, class: admin_field_class(@app, :appid), aria: { describedby: ("appid-error" if @app.errors[:appid].any?) } %>
        <%= admin_field_errors(@app, :appid) %>
      </div>
      <div class="col-md-6 col-xl-4">
        <%= f.label :nickname, "名称", class: "form-label" %>
        <%= f.text_field :nickname, class: admin_field_class(@app, :nickname) %>
      </div>
      <div class="col-md-6 col-xl-4">
        <%= f.label :status, "运行状态", class: "form-label required" %>
        <%= f.select :status, App::STATUSES.invert, {}, required: true, class: admin_field_class(@app, :status, "form-select"), data: { enhanced_select: "single" }, aria: { describedby: ("status-error" if @app.errors[:status].any?) } %>
        <%= admin_field_errors(@app, :status) %>
      </div>
      <div class="col-12"><%= f.label :memo, "备注", class: "form-label" %><%= f.text_area :memo, rows: 2, class: admin_field_class(@app, :memo) %></div>
    </div>
  </div>
  <div class="card-header border-top"><h2 class="card-title">接入凭据</h2></div>
  <div class="card-body"><div class="row g-3">
      <div class="col-12 col-xl-8">
        <%= render "admins/shared/configuration_field", form: f, field: :appsecret, label: "AppSecret", record: @app, value: @credentials.fetch(:appsecret).first, source: @credentials.fetch(:appsecret).last, disabled: @credential_unavailable %>
        <% if @credential_revision %><%= f.hidden_field :revision, value: @credential_revision %><% end %>
      </div>
    </div>
  </div>
  <% if @app.new_record? || @app.wechat_official_account? %>
    <%= tag.fieldset class: "border-0 p-0 m-0", id: "official-account-callback", hidden: !@app.wechat_official_account?, disabled: !@app.wechat_official_account? do %>
      <legend class="visually-hidden">公众号服务器配置</legend>
      <div class="card-header border-top"><h2 class="card-title">公众号服务器配置</h2></div>
      <div class="card-body"><div class="row g-3">
        <% if @app.persisted? %><div class="col-12">
          <div class="d-flex align-items-center gap-2 mb-2"><label for="callback-url" class="form-label mb-0">服务器地址</label>
            <%= render "admins/shared/field_help", label: "查看服务器地址说明", text: "在微信公众平台的服务器配置中填写此 HTTPS 地址，启用安全模式并选择 XML。" %></div>
          <%= text_field_tag nil, api_wechat_official_account_messages_url(appid: @app.appid), id: "callback-url", readonly: true, class: "form-control" %>
        </div><% end %>
        <div class="col-12 col-lg-6">
          <div class="d-flex align-items-center gap-2 mb-2"><%= f.label :wechat_original_id, "公众号原始 ID", class: "form-label mb-0" %>
            <%= render "admins/shared/field_help", label: "查看原始 ID 说明", text: "填写公众号设置中以 gh_ 开头的原始 ID，用于核对消息接收账号。" %></div>
          <%= f.text_field :wechat_original_id, class: admin_field_class(@app, :wechat_original_id), autocomplete: "off" %>
          <%= admin_field_errors(@app, :wechat_original_id) %>
        </div>
        <% { callback_token: ["回调 Token", "与微信公众平台填写的 Token 一致，使用 3 至 32 位英文字母或数字。"],
             callback_encoding_aes_key: ["消息加解密密钥", "填写该公众号服务器配置中的 43 位 EncodingAESKey。"] }.each do |field, (label, help)| %>
          <% value, source = @credentials.fetch(field, [nil, "未配置"]) %>
          <div class="col-12 col-lg-6"><%= render "admins/shared/configuration_field", form: f, field: field, label: label,
                record: @app, value: value, source: source, help: help, disabled: @credential_unavailable %></div>
        <% end %>
      </div></div>
    <% end %>
  <% end %>
  <div class="card-footer bg-transparent"><div class="btn-list justify-content-end">
    <%= link_to (@app.persisted? ? admins_app_path(@app, application_context_params) : admins_apps_path(application_list_context)), class: "btn" do %><%= render "layouts/admins/icon", name: :close %>取消<% end %>
    <% if @app.persisted? %><%= render "admins/shared/clear_configuration_button", target: "#clear-app-configuration", disabled: !can_clear %><% end %>
    <% if can_clear_callback %><button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#clear-callback">清除回调凭据</button><% end %>
    <% if disable_only %>
      <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#<%= confirm_id %>"><%= render "layouts/admins/icon", name: :alert %>停用应用</button>
    <% end %>
    <%= render "admins/shared/submit_button", label: "保存", icon: :save, disabled: @credential_unavailable %>
  </div></div>
<% end %>
<% if can_clear_callback %>
  <%= form_with model: [:admins, @app], url: admins_app_path(@app, application_context_params), id: "clear-callback-form", class: "d-none" do |f| %>
    <%= f.hidden_field :revision, value: @credential_revision, id: nil %><%= f.hidden_field :clear_callback, value: "1", id: nil %>
  <% end %>
  <%= render "admins/shared/confirmation_modal", modal_id: "clear-callback", form_id: "clear-callback-form", title: "清除公众号回调凭据",
      context: @app.display_name, description: "清除数据库中的 Token 和加解密密钥后，将读取同一账号的部署配置。",
      color: "warning", confirm_label: "确认清除", confirm_icon: :trash, cancel_icon: :close %>
<% end %>
<% if can_clear %>
  <%= form_with model: [:admins, @app], id: "clear-app-configuration-form", class: "d-none" do |f| %>
    <% application_list_context.each do |key, value| %><%= hidden_field_tag "list[#{key}]", value, id: nil %><% end %>
    <%= f.hidden_field :revision, value: @credential_revision, id: nil %>
    <%= f.hidden_field :clear_secret, value: "1", id: nil %>
  <% end %>
  <%= render "admins/shared/confirmation_modal", modal_id: "clear-app-configuration", form_id: "clear-app-configuration-form",
      title: "确认清除系统配置", context: @app.display_name, description: "清除此应用在数据库中的 AppSecret，并按环境变量、Rails credentials 的顺序读取。",
      color: "warning", confirm_label: "确认清除", confirm_icon: :trash, cancel_icon: :close %>
<% end %>
<% if disable_only %>
  <%= form_with url: disable_admins_app_path(@app, application_context_params), scope: :app, method: :patch, id: "disable-app-form", class: "d-none" do |f| %>
    <%= f.hidden_field :revision, value: AppConfiguration.new(@app).disable_revision, id: nil %>
  <% end %>
<% end %>
<% if confirm_id %>
  <%= render "admins/shared/confirmation_modal", modal_id: confirm_id, form_id: (disable_only ? "disable-app-form" : "app-form"),
        title: "确认停用应用", context: @app.display_name,
        description: (disable_only ? "此次只保存运行状态。此应用下次读取启动配置时将无法进入服务。" : "停用后，此应用下次读取启动配置时将无法进入服务。"),
        color: "warning", confirm_label: (disable_only ? "确认停用" : "确认停用并保存"), confirm_icon: :alert, cancel_icon: :close %>
<% end %>
