<div class="modal modal-blur fade" id="app-qrcode" tabindex="-1" aria-labelledby="app-qrcode-title" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title" id="app-qrcode-title">正式版小程序码</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
      </div>
      <div class="modal-body text-center">
        <p class="fw-medium text-break" data-app-name></p>
        <p class="text-secondary mb-0" role="status" aria-live="polite"></p>
        <img class="img-fluid" alt="正式版小程序码" hidden>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" data-bs-dismiss="modal"><%= render "layouts/admins/icon", name: :close %>关闭</button>
        <button class="btn" type="button" data-retry hidden><%= render "layouts/admins/icon", name: :rotate %>重试</button>
        <a class="btn btn-outline-secondary" data-download hidden><%= render "layouts/admins/icon", name: :export %>下载二维码</a>
      </div>
    </div>
  </div>
</div>
