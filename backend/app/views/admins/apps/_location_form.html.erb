<%= render "admins/shared/enhanced_select_assets" %>
<% content_for :head do %><%= javascript_include_tag "admins/location_application", defer: true %><% end %>
<% draft = flash[:location_draft].to_h
   draft = {} unless draft["app_id"] == @app.id
   choices = @location_entries.map do |entry|
     label = [entry.name, entry.description.presence, entry.label, entry.blocked_reason].compact.join(" · ")
     [label, entry.name, {disabled: entry.blocked_reason.present?}]
   end %>
<%= form_with url: admins_app_location_interface_applications_path(@app, application_context_params),
    scope: :location_application, multipart: true, id: "location-application", data: { admin_form: true } do |f| %>
  <div class="card-body"><div class="row gy-3"><div class="col-12 col-lg-8">
    <%= f.label :api_name, "接口", class: "form-label required" %>
    <%= f.select :api_name, options_for_select(choices, draft["api_name"]), { include_blank: "请选择接口" },
        required: true, class: "form-select", data: { enhanced_select: "single" } %>
  </div><div class="col-12 col-lg-8">
    <div class="d-flex align-items-center justify-content-between">
      <%= f.label :content, "申请原因", class: "form-label required" %>
      <small class="text-secondary"><span data-location-count><%= draft["content"].to_s.length %></span> / 300</small>
    </div>
    <%= f.text_area :content, value: draft["content"], rows: 4, maxlength: 300, required: true, class: "form-control", placeholder: "说明医院小程序在哪个页面、为了什么功能使用该接口" %>
    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
      <span class="small text-secondary">参考写法</span>
      <% { "收货地址" => "用户申请寄送体检报告时，自主选择收件地址，以便医院寄送报告。",
           "选择位置" => "用户查找院区时，在地图上自主选择出发位置，以便查看前往该院区的路线。",
           "附近院区" => "用户查找附近院区时，使用模糊位置展示所在区域的院区和大致距离。" }.each do |label, content| %>
        <button type="button" class="btn btn-sm" data-location-example="<%= content %>"><%= label %></button>
      <% end %>
    </div>
  </div><div class="col-12 col-lg-8">
    <div class="d-flex align-items-center gap-1 mb-2">
      <%= f.label :pictures, "补充图片", class: "form-label mb-0" %>
      <%= render "admins/shared/field_help", text: "请提供实际使用场景截图。最多 10 张 JPG、PNG 或 WEBP，单张不超过 10MB。", label: "查看补充图片要求" %>
    </div>
    <%= f.file_field :pictures, multiple: true, accept: "image/jpeg,image/png,image/webp", class: "form-control", data: { location_pictures: true } %>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-xl-4 g-2 mt-1" data-location-picture-list hidden></div>
    <template data-location-picture>
      <div class="col">
        <div class="ratio ratio-4x3 mb-1"><img class="object-cover rounded border" alt="" loading="lazy"></div>
        <div class="d-flex align-items-center gap-2">
          <span class="small text-truncate flex-fill"></span>
          <button type="button" class="btn btn-sm btn-icon btn-outline-danger flex-shrink-0"><%= render "layouts/admins/icon", name: :trash %></button>
        </div>
      </div>
    </template>
  </div></div></div>
  <div class="card-footer bg-transparent d-flex align-items-center justify-content-between flex-wrap gap-2">
    <%= link_to "微信申请说明", "https://developers.weixin.qq.com/doc/oplatform/openApi/miniprogram-management/privacy-api-management/api_applyprivacyinterface.html", target: "_blank", rel: "noopener noreferrer" %>
    <% if @location_entries.any? { |entry| entry.blocked_reason.nil? } %>
      <%= render "admins/shared/submit_button", label: "提交申请", icon: :check %>
    <% else %><span class="text-secondary">当前没有可申请的接口</span><% end %>
  </div>
<% end %>
<%= render "admins/shared/confirmation_modal", form_id: "location-application", modal_id: "location-apply-confirm",
    title: "提交地理位置申请", context: "#{@app.display_name} · #{@app.appid}", description: "所选接口、申请原因和补充图片将提交微信审核。",
    color: "primary", confirm_label: "确认提交", confirm_icon: :check, cancel_icon: :close %>
