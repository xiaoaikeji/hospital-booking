<div class="card-header flex-wrap gap-2"><h2 class="card-title">版本信息</h2><div class="card-actions btn-list">
  <%= link_to admins_mini_program_releases_path(app_id: @app.id), class: "btn" do %><%= render "layouts/admins/icon", name: :eye %>全部代码记录<% end %>
  <% if WechatPlatform::ReleaseActions.new(@app).upload? %><%= link_to admins_mini_program_releases_path(app_id: @app.id, upload: 1), class: "btn btn-primary" do %><%= render "layouts/admins/icon", name: :import %>上传代码<% end %><% end %>
</div></div>
<div class="card-body">
  <% progress = @current_round && (@current_round.publication == "unpublished" ? MiniProgramAudit::LABELS[@current_round.status] : MiniProgramAudit::PUBLICATIONS[@current_round.publication]) %>
  <%= render "admins/shared/field_rows", fields: {
    "线上版本" => @online_version || "尚无发布记录", "当前体验版" => @trial && link_to(@trial.version, admins_mini_program_release_path(@trial)),
    "最近审核" => @current_round && "#{@current_round.version} · #{progress}"
  }, columns: 3 %>
  <% if @tab == "releases" && @trial && WechatPlatform::ReleaseActions.new(@app, release: @trial).trial? %><div class="mt-3"><%= render "qrcode_button", app: @app, trial: @trial, label: "查看体验码" %></div><% end %>
  <% if @tab == "releases" && @app.platform_authorized? %>
    <% if @version_info %><hr><%= render "admins/shared/field_rows", fields: { "微信线上版本" => @version_info.dig("release_info", "release_version").presence || "尚未发布", "微信体验版" => @version_info.dig("exp_info", "exp_version").presence || "暂无体验版" } %><% end %>
    <% if @version_error %><div class="alert alert-warning mt-3" role="status"><%= @version_error %></div><% end %>
    <%= link_to admins_app_path(@app, application_context_params.merge(tab: "releases", verify_version: 1)), class: "btn btn-sm mt-2" do %><%= render "layouts/admins/icon", name: :rotate %>查询微信版本<% end %>
  <% end %>
</div>
