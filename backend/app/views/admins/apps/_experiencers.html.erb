<section class="card" aria-labelledby="experiencer-title">
  <div class="card-header">
    <h2 class="card-title" id="experiencer-title">体验者 <span class="text-secondary">（<%= @experiencers.size %>）</span></h2>
  </div>
  <div class="card-body">
    <%= form_with url: admins_app_experiencers_path(@app, application_context_params), class: "row g-2 align-items-end", data: { admin_form: true } do |form| %>
      <div class="col-12 col-sm-5 col-lg-3">
        <%= form.label :wechatid, "体验者微信号", class: "form-label required" %>
        <%= form.text_field :wechatid, class: "form-control", maxlength: 64, size: nil, required: true, autocomplete: "off", placeholder: "输入微信号" %>
      </div>
      <div class="col-auto"><%= render "admins/shared/submit_button", label: "绑定体验者", icon: :plus %></div>
    <% end %>
  </div>
  <% if @experiencers.empty? %>
    <%= render "admins/shared/list_empty", icon: :users, title: "暂无体验者" %>
  <% else %>
    <table class="table table-fixed table-vcenter card-table table-hover admin-list-table mb-0">
      <thead><tr><th scope="col">体验者标识</th><th scope="col" class="list-column-action px-2">操作</th></tr></thead>
      <tbody>
        <% @experiencers.each_with_index do |userstr, index| %>
          <tr><td><%= render "admins/shared/list_text", text: userstr %></td><td class="px-2">
            <button type="button" class="btn btn-sm btn-outline-danger text-nowrap" data-bs-toggle="modal" data-bs-target="#unbind-<%= index %>-confirmation"><%= render "layouts/admins/icon", name: :close %>解绑</button>
          </td></tr>
        <% end %>
      </tbody>
    </table>
    <% @experiencers.each_with_index do |userstr, index| %>
      <% form_id = "unbind-#{index}" %>
      <%= form_with url: admins_app_experiencers_path(@app, application_context_params), method: :delete, id: form_id, class: "d-none" do %>
        <%= hidden_field_tag :userstr, userstr, id: nil %>
      <% end %>
      <%= render "admins/shared/confirmation_modal", modal_id: "#{form_id}-confirmation", form_id: form_id, title: "解绑体验者",
            context: @app.display_name, description: "解除体验者 #{truncate(userstr, length: 32)} 对本应用体验版的访问权限？", color: "danger", confirm_label: "确认解绑", confirm_icon: :check, cancel_icon: :close %>
    <% end %>
  <% end %>
</section>
