<% auth = @app.app_authorization; authorized = @app.platform_authorized? %>
<section class="card mb-3" id="wechat-authorization">
  <div class="card-header flex-wrap gap-2"><h2 class="card-title">平台授权</h2>
    <div class="card-actions btn-list">
      <%= link_to admins_wechat_platform_path, class: "btn" do %><%= render "layouts/admins/icon", name: :settings %>平台状态<% end %>
      <% if @platform.missing.empty? %><%= button_to admins_app_authorization_path(@app), class: "btn btn-primary" do %><%= render "layouts/admins/icon", name: :check %><%= authorized ? "更新平台授权" : "发起平台授权" %><% end %><% end %>
    </div>
  </div>
  <div class="card-body">
    <% state = authorized ? "已授权" : (auth&.revoked_at ? "已取消授权" : "未授权") %>
    <% fields = { "授权状态" => tag.span(state, class: "badge bg-#{authorized ? 'success' : 'secondary'}-lt") } %>
    <% if auth && (authorized || auth.event_at) %>
      <% fields.merge!("授权方 AppID" => @app.appid, "授权时间" => admin_list_time(auth.authorized_at)) %>
      <% fields["取消时间"] = admin_list_time(auth.revoked_at) if auth.revoked_at %>
      <% fields["授权权限集"] = auth.scopes.any? ? "#{auth.scopes.size} 项（ID #{auth.scopes.join('、')}）" : "无" %>
    <% end %>
    <% fields["最近操作人"] = auth.initiator.display_name if auth&.initiator %>
    <%= render "admins/shared/field_rows", fields: fields, columns: 3 %>
    <% if !authorized && @app.code_capable? %><p class="text-secondary mt-3 mb-0"><%= MiniProgramAudit::PENDING.include?(@current_round&.status) ? "平台授权后可继续查询本轮审核并核实微信结果。" : "平台授权后可代本应用上传代码、提审和发布。" %></p><% end %>
    <% if @platform.missing.any? %><div class="alert alert-warning mt-3 mb-0" role="status">请配置第三方平台的 <%= @platform.missing.map { |key| "WECHAT_COMPONENT_#{key.upcase}" }.join("、") %>。</div>
    <% elsif !@platform.ticket_cached? && !@platform.token_cached? %><p class="text-secondary mt-3 mb-0" role="status">等待微信推送平台票据，请核对授权事件接收地址。</p><% end %>
    <details class="mt-3"><summary class="text-secondary">查看微信接收地址</summary><dl class="mt-2 mb-0">
      <dt>授权事件接收 URL</dt><dd><code><%= api_wechat_component_events_url %></code></dd>
      <dt>消息与事件接收 URL</dt><dd class="mb-0"><code><%= wechat_component_messages_template_url %></code></dd></dl></details>
  </div>
</section>
