<% auth = @app.app_authorization; authorized = @app.platform_authorized? %>
<section class="card mb-3" id="wechat-authorization">
  <div class="card-header"><h2 class="card-title">平台授权</h2></div>
  <div class="card-body">
    <%= render "admins/shared/field_rows", fields: { "授权状态" => authorized ? "已授权" : (auth&.event_at ? "已取消授权" : "未授权"), "授权方 AppID" => (auth&.event_at || authorized ? @app.appid : nil), "权限集" => auth&.scopes&.join("、"), authorized ? "授权时间" : "取消时间" => auth&.event_at && admin_list_time(auth.event_at), "最近操作人" => auth&.initiator&.display_name } %>
    <p class="text-secondary mt-3"><%= @app.code_capable? ? "代此小程序上传、提审和发布需要平台授权。恢复授权后可继续核实已有审核单或操作当前版本。" : "公众号通过平台授权委托管理账号。"%> 本应用的 AppSecret 在编辑页维护。</p>
    <% if @platform.missing.any? %><div class="alert alert-warning" role="status">请配置第三方平台的 <%= @platform.missing.join("、") %>。</div>
    <% elsif Rails.cache.read(@platform.ticket_key).blank? %><div class="alert alert-warning">等待微信推送平台票据，请核对授权事件接收地址。</div><% end %>
    <% if @platform.missing.empty? %><%= button_to authorized ? "更新平台授权" : "发起平台授权", admins_app_authorization_path(@app), class: "btn btn-primary" %><% end %>
  </div>
</section>
<% if @app.code_capable? %>
  <section class="card mb-3"><div class="card-header flex-wrap gap-2"><h2 class="card-title">代码发布</h2>
    <div class="card-actions btn-list"><%= link_to "全部代码记录", admins_mini_program_releases_path(app_id: @app.id), class: "btn" %>
    <% if WechatPlatform::ReleaseActions.new(@app).upload? %><%= link_to "上传代码", admins_mini_program_releases_path(app_id: @app.id, upload: 1), class: "btn btn-primary" %><% end %></div></div>
    <div class="card-body"><%= render "admins/shared/field_rows", fields: { "线上版本（已确认）" => @online_version, "当前体验版" => @trial_version, "最近发布进度" => @latest_progress && MiniProgramRelease::STATES[@latest_progress.progress], "近期上传" => safe_join(@recent_uploads.map { |r| link_to(r.version, admins_mini_program_release_path(r)) }, "、") } %></div>
    <div class="list-group list-group-flush"><% @audits.each do |round| %><div class="list-group-item">
      <div class="d-flex flex-wrap gap-2"><strong><%= round.version %></strong><span><%= MiniProgramAudit::LABELS[round.status] %></span><span class="text-secondary"><%= admin_list_time(round.created_at) %></span>
      <% if round.mini_program_release %><%= link_to "查看代码记录", admins_mini_program_release_path(round.mini_program_release) %><% end %></div>
      <% if round.rejection_reason %><div class="mt-2"><%= render "admins/shared/field_rows", fields: { "拒审原因" => round.rejection_reason }, full: ["拒审原因"] %>
      <% round.rejection_screenshots.each do |id| %><code class="me-2"><%= id %></code><% end %></div><% end %>
      <% unless round.mini_program_release %><div class="btn-list"><%= render "admins/mini_program_releases/round_actions", release: nil, round: round, actions: WechatPlatform::ReleaseActions.new(@app, round: round) %></div><% end %>
    </div><% end %></div>
    <%= render "admins/shared/pagination", pagy: @audit_history, url: ->(page) { admins_app_path(@app, page: page) } %>
  </section>
<% end %>
