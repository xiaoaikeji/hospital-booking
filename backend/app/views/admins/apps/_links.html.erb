<%= render "admins/shared/enhanced_select_assets" %>
<% page = @links_page; operations = page.fetch(:pending).index_by(&:mini_appid) %>
<% context = application_context_params.merge(params.permit(:links_q, :links_page).to_h) %>
<section class="card">
  <div class="card-header flex-wrap gap-2"><h2 class="card-title">关联小程序（<%= page[:rows].size %>）</h2><div class="card-actions btn-list">
    <%= link_to admins_official_account_links_path(q: params[:links_q].presence, page: params[:links_page].presence), class: "btn text-nowrap" do %><%= render "layouts/admins/icon", name: :arrow_left %>公众号关联管理<% end %>
    <% if @app.platform_authorized? %><%= link_to admins_app_path(@app, context.merge(tab: "links")), class: "btn" do %><%= render "layouts/admins/icon", name: :rotate %>重新读取<% end %><% end %>
  </div></div>
  <% unless page[:live] %><div class="alert alert-warning m-3"><%= page[:error] || "此公众号尚未完成平台授权。" %>
    <% if page[:fetched_at] %>以下为 <%= admin_list_time(page[:fetched_at]) %> 成功读取的记录。<% end %>
    <%= link_to "查看平台授权", admins_app_path(@app, anchor: "wechat-authorization"), class: "alert-link" %></div><% end %>
  <% if page[:rows].empty? %><%= render "admins/shared/list_empty", icon: :device_mobile, title: page[:live] ? "暂无关联小程序" : "暂无可显示的关联记录" %>
  <% else %><table class="table table-fixed table-vcenter card-table table-hover admin-list-table mb-0">
    <thead><tr>
      <th scope="col" class="px-2">小程序</th><th scope="col" class="d-none d-md-table-cell">AppID</th>
      <th scope="col" class="px-2">关联状态</th><th scope="col" class="d-none d-lg-table-cell">本院应用</th><th scope="col" class="px-2">操作</th>
    </tr></thead>
    <tbody><% page[:rows].each_with_index do |row, i| %><tr>
      <td class="px-2"><%= render "admins/shared/list_text", text: row["nickname"].presence || row["appid"] %>
        <% if row["nickname"].present? %><div class="d-md-none small text-secondary"><%= render "admins/shared/list_text", text: row["appid"] %></div><% end %></td>
      <td class="d-none d-md-table-cell"><%= render "admins/shared/list_text", text: row["appid"] %></td>
      <td class="px-2"><span class="badge text-wrap bg-<%= {1=>"success",2=>"warning",3=>"danger",12=>"warning",13=>"danger"}.fetch(row["status"], "secondary") %>-lt"><%= Wechat::OfficialAccountLinkClient::STATUS_LABELS.fetch(row["status"]) { "微信状态 #{row['status']}" } %></span></td>
      <td class="d-none d-lg-table-cell"><% if (local = page[:apps][row["appid"]]) %><%= render "admins/shared/list_text", text: local.display_name, url: admins_app_path(local) %><% else %>未在本院登记<% end %></td>
      <td class="px-2"><% if page[:live] && !operations[row["appid"]] %><button type="button" class="btn btn-sm btn-outline-danger text-nowrap" data-bs-toggle="modal" data-bs-target="#unlink-<%= i %>-confirm"><%= render "layouts/admins/icon", name: :close %>解除关联</button><% else %>—<% end %></td>
    </tr><% end %></tbody>
  </table><% end %>
  <% if page[:live] %><%= render "admins/apps/link_form", page: page, context: context %><% end %>
</section>
<% if page[:live] %><% page[:rows].each_with_index do |row, i| %>
  <% next if operations[row["appid"]] %>
  <%= form_with url: admins_app_mini_program_link_path(@app, row.fetch("appid"), context), method: :delete, id: "unlink-#{i}" do |f| %><%= f.hidden_field :revision, value: page[:revision], id: nil %><% end %>
  <%= render "admins/shared/confirmation_modal", modal_id: "unlink-#{i}-confirm", form_id: "unlink-#{i}", title: "解除关联", context: "#{@app.display_name} · #{row['nickname']}（#{row['appid']}）", description: "确认解除该公众号与此小程序的关联？", color: "danger", confirm_label: "确认解除关联", confirm_icon: :close %>
<% end %><% end %>
<% if operations.any? %><section class="card mt-3"><div class="card-header"><h2 class="card-title">待核实操作</h2></div>
  <% operations.each_value do |op| %><div class="card-body">
    <p><%= op.action == "create" ? "发起关联" : "解除关联" %> · <%= op.mini_appid %> · <%= admin_list_time(op.updated_at) %></p>
    <% if page[:live] %><%= form_with url: verify_admins_app_mini_program_links_path(@app, context), class: "d-flex flex-wrap align-items-center gap-2" do |f| %>
      <%= f.hidden_field :operation_id, value: op.id, id: nil %><%= f.hidden_field :version, value: op.lock_version, id: nil %>
      <%= f.select :outcome, [["微信已执行", "applied"], ["微信未执行", "not_applied"]], {}, class: "form-select w-auto", id: nil, data: {enhanced_select: "single"}, aria: {label: "操作结果"} %>
      <label class="form-check mb-0"><%= f.check_box :confirmed, required: true, class: "form-check-input", id: nil %>已核实微信后台记录</label>
      <%= f.button type: "submit", class: "btn btn-outline-primary text-nowrap" do %><%= render "layouts/admins/icon", name: :check %>登记核实结果<% end %>
    <% end %><% end %></div><% end %></section><% end %>
<% if page[:history].any? %><section class="card mt-3"><div class="card-header"><h2 class="card-title">最近关联操作</h2></div>
  <div class="list-group list-group-flush"><% page[:history].each do |entry| %><div class="list-group-item">
    <%= Log::OPERATION_EVENTS[["wechat", entry.action]] %> · <%= entry.details["mini_appid"] %> · <%= entry.status == "success" ? "成功" : "未完成" %>
    <small class="text-secondary"><%= admin_list_time(entry.created_at) %></small>
  </div><% end %></div></section><% end %>
