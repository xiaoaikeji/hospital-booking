<% content_for :title, @app.display_name %>
<%= render layout: "admins/shared/list_page_header", locals: { title: @app.display_name, icon: :package } do %>
  <%= link_to "返回列表", admins_apps_path, class: "btn" %>
  <%= link_to "编辑", edit_admins_app_path(@app), class: "btn btn-primary" %>
<% end %>
<section class="card mb-3"><dl class="card-body datagrid mb-0">
  <% { "平台" => App::PROVIDERS[@app.provider], "AppID" => @app.appid, "状态" => App::STATUSES[@app.status], "接入凭据" => AppConfiguration.new(@app).credential_status, "备注" => @app.memo }.each do |label, value| %>
    <div class="datagrid-item"><dt class="datagrid-title"><%= label %></dt><dd class="datagrid-content"><%= value.presence || "—" %></dd></div>
  <% end %>
</dl></section>
<% if @app.provider == "wechat" %>
  <%= render "admins/shared/enhanced_select_assets" %>
  <%= render "wechat" %>
<% end %>
<%= form_with url: admins_app_path(@app), method: :delete, id: "delete-app" do %>
  <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirm-delete-app">删除</button>
<% end %>
<%= render "admins/shared/confirmation_modal", modal_id: "confirm-delete-app", form_id: "delete-app", title: "确认删除应用", context: @app.display_name, description: "仅可删除没有授权、发布及业务记录的空应用。", color: "danger", confirm_label: "删除" %>
