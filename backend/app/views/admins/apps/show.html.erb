<% content_for :title, "#{@app.display_name} · Booking 管理后台" %>
<%= render layout: "admins/shared/list_page_header", locals: { title: @app.display_name, icon: :package } do %>
  <%= link_to admins_apps_path, class: "btn text-nowrap" do %><%= render "layouts/admins/icon", name: :arrow_left %>返回列表<% end %>
  <%= link_to edit_admins_app_path(@app), class: "btn btn-outline-primary text-nowrap" do %><%= render "layouts/admins/icon", name: :edit %>编辑<% end %>
  <button type="button" class="btn btn-outline-danger text-nowrap" data-bs-toggle="modal" data-bs-target="#<%= dom_id(@app, :delete) %>-confirmation"><%= render "layouts/admins/icon", name: :trash %>删除</button>
<% end %>
<%= render "delete_confirmation", app: @app %>

<section class="card mb-3">
  <div class="card-header"><h2 class="card-title">应用资料</h2></div>
  <div class="card-body">
    <%= render "admins/shared/field_rows", fields: { "应用平台" => @app.platform_label, "AppID" => @app.appid, "运行状态" => app_status_badge(@app.status), "接入凭据" => AppConfiguration.new(@app).credential_status, "创建时间" => admin_list_time(@app.created_at), "备注" => @app.memo }, full: ["备注"] %>
  </div>
</section>
<% if @app.provider == "wechat" %>
  <%= render "admins/shared/enhanced_select_assets" %>
  <%= render "wechat" %>
<% end %>
