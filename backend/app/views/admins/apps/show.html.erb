<% content_for :title, "#{@app.display_name} · 应用详情" %>
<% content_for :head do %><%= javascript_include_tag "admins/app_qrcode", defer: true %><%= javascript_include_tag "admins/releases", defer: true if @app.code_capable? %><% end %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "应用详情", icon: :device_mobile } do %>
  <%= link_to edit_admins_app_path(@app, application_context_params), class: "btn btn-outline-primary" do %><%= render "layouts/admins/icon", name: :edit %>编辑<% end %>
  <%= link_to admins_apps_path(application_list_context), class: "btn" do %><%= render "layouts/admins/icon", name: :arrow_left %>返回列表<% end %>
<% end %>
<section class="card mb-3">
  <% if @app.code_capable? %><div class="card-header"><nav class="nav nav-tabs card-header-tabs" aria-label="应用详情分区">
    <% @tabs.each do |key, label| %>
      <%= link_to label, admins_app_path(@app, application_context_params.merge(tab: (key unless key == "overview")).compact), class: class_names("nav-link", active: @tab == key), aria: { current: ("page" if @tab == key) } %>
    <% end %>
  </nav></div><% end %>
  <% if %w[overview releases].exclude?(@tab) %>
    <div class="card-body py-2 text-break"><strong><%= @app.display_name %></strong> <span class="text-secondary ms-2"><%= @app.appid %></span></div>
  <% elsif @tab == "releases" %><%= render "versions" %><% else %>
    <h2 class="visually-hidden">应用资料</h2>
    <div class="card-body"><%= render "admins/shared/field_rows", fields: {
      "ID" => "##{@app.id}", "应用平台" => @app.platform_label, "应用名称" => @app.display_name,
      "AppID" => @app.appid, "原始 ID" => @app.app_authorization&.original_id, "运行状态" => app_status_badge(@app.status),
      "AppSecret" => AppConfiguration.new(@app).credential_status, "创建时间" => admin_list_time(@app.created_at),
      "更新时间" => admin_list_time(@app.updated_at),
      **(@app.provider == "wechat" ? { "二维码" => render("qrcode_button", app: @app, label: (@app.code_capable? ? "正式版小程序码" : "公众号二维码")) } : {}),
      "备注" => @app.memo
    }, full: ["备注"], columns: 3 %></div>

  <% end %>
</section>
<%= render "wechat" if @app.provider == "wechat" && @tab == "overview" %>
<% if @app.code_capable? && %w[overview releases].include?(@tab) %>
  <% if @tab == "overview" %><section class="card mb-3"><%= render "versions" %></section><% end %>
  <%= render "release_history" %>
<% end %>
<% if %w[overview releases].exclude?(@tab) %>
  <%= render(@app.platform_authorized? && @tab_error.nil? ? "admins/apps/#{@tab}" : "management_notice") %>
<% end %>
<%= render "qrcode_modal" if @app.provider == "wechat" && %w[overview releases].include?(@tab) %>
