<% content_for :title, "#{@app.display_name} · 应用详情" %>
<% content_for :head do %><%= javascript_include_tag "admins/app_qrcode", defer: true %><% end %>
<% tabs = { "overview" => "基本资料", "plugins" => "插件管理" } %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "应用详情", icon: :device_mobile } do %>
  <%= link_to edit_admins_app_path(@app, application_context_params), class: "btn btn-outline-primary" do %><%= render "layouts/admins/icon", name: :edit %>编辑<% end %>
  <%= link_to admins_apps_path(application_list_context), class: "btn" do %><%= render "layouts/admins/icon", name: :arrow_left %>返回列表<% end %>
<% end %>
<section class="card mb-3">
  <% if @app.code_capable? %><div class="card-header"><nav class="nav nav-tabs card-header-tabs" aria-label="应用详情分区">
    <% tabs.each do |key, label| %>
      <%= link_to label, admins_app_path(@app, application_context_params.merge(tab: (key unless key == "overview")).compact), class: class_names("nav-link", active: @tab == key), aria: { current: ("page" if @tab == key) } %>
    <% end %>
  </nav></div><% end %>
  <% if @tab == "overview" %>
    <div class="card-body"><div class="row gy-3">
      <div class="<%= @app.code_capable? ? "col-12 col-xl-8" : "col-12" %>">
        <%= render "admins/shared/field_rows", fields: {
          "ID" => "##{@app.id}", "应用平台" => @app.platform_label, "应用名称" => @app.display_name,
          "AppID" => @app.appid, "运行状态" => app_status_badge(@app.status), "AppSecret" => @app_secret.status,
          **(@app.wechat_official_account? ? { "原始 ID" => @app.wechat_original_id, "服务器地址" => api_wechat_official_account_messages_url(appid: @app.appid) } : {}),
          "创建时间" => admin_list_time(@app.created_at), "更新时间" => admin_list_time(@app.updated_at), "备注" => @app.memo
        }, full: ["服务器地址", "备注"], columns: 2 %>
        <% if @app_secret.source %><p class="text-danger mb-0 mt-2">AppSecret · <%= configuration_source(@app_secret.source).first %></p><% end %>
      </div>
      <% if @app.code_capable? %><div class="col-12 col-xl-4"><%= render "qrcode_panel", app: @app %></div><% end %>
    </div></div>
  <% else %>
    <div class="card-body text-break"><strong><%= @app.display_name %></strong> <span class="text-secondary ms-2"><%= @app.appid %></span></div>
  <% end %>
</section>
<%= render "official_account_actions", app: @app if @app.wechat_official_account? %>
<% if @tab == "plugins" %>
  <% if @tab_error %>
    <div class="alert alert-warning" role="alert"><%= @tab_error %></div>
  <% else %><%= render "plugins" %><% end %>
<% end %>

<% if @sync_history.present? %>
  <section id="fan-sync-history" class="card mt-3" aria-labelledby="fan-sync-history-title">
    <div class="card-header"><h2 class="card-title" id="fan-sync-history-title">粉丝同步记录</h2></div>
    <div class="list-group list-group-flush">
      <% @sync_history.each do |log| %>
        <div class="list-group-item">
          <div class="row g-2 align-items-center">
            <div class="col fw-medium">同步公众号粉丝</div>
            <div class="col-auto"><%= render "admins/operation_logs/status", status: log.status %></div>
            <time class="col-12 col-sm-auto small text-secondary text-nowrap" datetime="<%= log.created_at.iso8601 %>"><%= admin_list_time(log.created_at) %></time>
          </div>
        </div>
      <% end %>
    </div>
    <%= render "admins/shared/pagination", pagy: @sync_pagy, url: ->(page) { admins_app_path(@app, application_context_params.merge(history_page: page, anchor: "fan-sync-history")) } %>
  </section>
<% end %>
