<section class="card"><div class="card-body">
  <h2 class="card-title"><%= @tabs.fetch(@tab) %></h2>
  <% if @tab_error %>
    <div class="alert alert-warning" role="alert"><%= @tab_error %></div>
    <%= link_to admins_app_path(@app, application_context_params.merge(tab: @tab)), class: "btn" do %><%= render "layouts/admins/icon", name: :rotate %>重新读取<% end %>
  <% else %>
    <p class="text-secondary">完成 <%= @app.display_name %> 的平台授权后即可管理<%= @tabs.fetch(@tab) %>。</p>
  <% end %>
  <%= link_to admins_app_path(@app, application_context_params.merge(anchor: "wechat-authorization")), class: "btn btn-info" do %><%= render "layouts/admins/icon", name: :eye %>查看平台授权<% end %>
</div></section>
