<section class="card"><div class="card-body">
  <h2 class="card-title"><%= @tabs.fetch(@tab) %></h2>
  <% if @tab_error %>
    <div class="alert alert-warning" role="alert"><%= @tab_error %></div>
    <%= link_to "重新读取", admins_app_path(@app, application_context_params.merge(tab: @tab)), class: "btn" %>
  <% else %>
    <p class="text-secondary">完成 <%= @app.display_name %> 的平台授权后即可管理<%= @tabs.fetch(@tab) %>。</p>
  <% end %>
  <%= link_to "查看平台授权", admins_app_path(@app, application_context_params.merge(anchor: "wechat-authorization")), class: "btn btn-outline-primary" %>
</div></section>
