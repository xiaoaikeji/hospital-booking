<%= form_with url: resolve_admins_app_audit_path(audit.app, audit), namespace: dom_id(audit, :resolve), class: "border-top mt-3 pt-3", data: { admin_form: true } do |f| %>
  <%= render "admins/mini_program_releases/return_fields" %>
  <p class="text-secondary">请在微信后台核实 AppID、版本和本轮操作时间，再登记结果。</p>
  <div class="row g-3">
    <% if audit.status == "withdraw_unknown" %>
      <%= f.hidden_field :outcome, value: "not_withdrawn" %><div class="col-12">登记本轮撤回未执行</div>
    <% else %>
      <% choices = audit.status == "submit_unknown" ? [["微信已受理", "accepted"], ["已核实未受理", "not_accepted"]] : [["已核实本轮发布成功", "published"], ["已核实本轮未发布", "not_published"]] %>
      <div class="col-md-6">
        <%= f.label :outcome, "核实结果", class: "form-label" %>
        <%= f.select :outcome, choices, {}, class: "form-select", data: { enhanced_select: "single" } %>
      </div>
      <% if audit.status == "submit_unknown" %>
        <div class="col-md-6">
          <%= f.label :audit_id, "微信审核单号", class: "form-label" %>
          <%= f.text_field :audit_id, placeholder: "已受理时填写真实审核单号", class: "form-control" %>
        </div>
      <% end %>
    <% end %>
  </div>
  <label class="form-check my-3"><%= f.check_box :confirmed, required: true, class: "form-check-input" %><span class="form-check-label">我已核实微信后台记录</span></label>
  <%= render "admins/shared/submit_button", label: "登记核实结果", icon: :check %>
<% end %>
