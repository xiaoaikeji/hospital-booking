<% content_for :title, "公众号关联管理 · Booking 管理后台" %>
<% empty = @apps.empty? %>
<% content_for :fill_content, "true" if empty %>

<%= render layout: "admins/shared/list_page_header", locals: { title: "公众号关联管理", icon: :link } do %><% end %>
<section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="公众号列表">
  <div class="card-header flex-shrink-0">
    <%= form_with url: admins_official_account_links_path, method: :get, class: "d-flex flex-wrap flex-lg-nowrap align-items-center gap-2 w-100", html: { role: "search", aria: { label: "搜索公众号" } } do |f| %>
      <div class="col-12 col-sm-5 col-lg-3 flex-shrink-0">
        <%= f.search_field :q, value: @q, class: "form-control text-truncate", placeholder: "公众号名称 / AppID", aria: { label: "搜索公众号" } %>
      </div>
      <%= f.button type: "submit", class: "btn flex-shrink-0 text-nowrap" do %><%= render "layouts/admins/icon", name: :search %>搜索<% end %>
      <% if @q.present? %>
        <%= link_to admins_official_account_links_path, class: "btn flex-shrink-0 text-nowrap" do %><%= render "layouts/admins/icon", name: :rotate %>重置筛选<% end %>
      <% end %>
    <% end %>
  </div>
  <% if empty %>
    <%= render "admins/shared/list_empty", icon: :link, title: (@q.present? ? "未找到匹配的公众号" : "暂无公众号"), description: ("试试其他关键词，或重置筛选。" if @q.present?) %>
  <% else %>
    <table class="table table-fixed table-vcenter card-table table-hover admin-list-table official-account-links-table mb-0">
      <thead><tr>
        <th scope="col" class="list-column-id px-2">ID</th>
        <th scope="col" class="px-2">公众号</th>
        <th scope="col" class="d-none d-md-table-cell">AppID</th>
        <th scope="col" class="list-column-status px-2">平台授权</th>
        <th scope="col" class="list-column-status px-2 d-none d-sm-table-cell">运行状态</th>
        <th scope="col" class="list-column-action px-2">操作</th>
      </tr></thead>
      <tbody><% @apps.each do |app| %>
        <tr>
          <td class="text-secondary px-2"><%= render "admins/shared/list_text", text: "##{app.id}" %></td>
          <td class="px-2"><%= render "admins/shared/list_text", text: app.display_name, url: admins_app_path(app) %></td>
          <td class="d-none d-md-table-cell"><%= render "admins/shared/list_text", text: app.appid %></td>
          <td class="px-2"><span class="badge bg-<%= app.platform_authorized? ? 'success' : 'secondary' %>-lt"><%= app.platform_authorized? ? "已授权" : "未授权" %></span></td>
          <td class="px-2 d-none d-sm-table-cell"><%= app_status_badge(app.status) %></td>
          <td class="px-2">
            <%= link_to admins_app_path(app, tab: "links", links_q: @q.presence, links_page: params[:page].presence), class: "btn btn-sm btn-outline-primary text-nowrap" do %><%= render "layouts/admins/icon", name: :link %>关联小程序<% end %>
          </td>
        </tr>
      <% end %></tbody>
    </table>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(n) { admins_official_account_links_path(q: @q.presence, page: n) } %>
  <% end %>
</section>
