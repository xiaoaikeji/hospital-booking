<% content_for :mobile_theme_menu, "true" %>
<% content_for :head do %>
  <%= javascript_include_tag "tabler/libs/fullcalendar/index.global.min", "admins/doctor_schedule_calendar", defer: true %>
  <style>
    .doctor-schedule-calendar {
      --fc-border-color: var(--tblr-border-color);
      --fc-today-bg-color: var(--tblr-primary-lt);
    }

    /* Tabler 的 stretched-link 覆盖日期格，包括班次下方的空白。 */
    .doctor-schedule-calendar .fc-daygrid-day {
      position: relative;
    }

    .doctor-schedule-calendar .fc-daygrid-day-frame {
      position: static;
    }

    .doctor-schedule-calendar .fc-daygrid-day-number {
      position: static;
      width: 100%;
      min-height: 5rem;
      padding: .375rem .5rem;
      font-size: var(--tblr-font-size-h5);
      line-height: 1.35;
      overflow-wrap: anywhere;
      text-decoration: none;
    }

    .doctor-schedule-calendar .fc-daygrid-day-number > span {
      position: relative;
      z-index: 2;
    }

    .doctor-schedule-calendar .fc-daygrid-day-number:focus-visible::after {
      outline: 2px solid var(--tblr-primary);
      outline-offset: -2px;
    }

    @media (max-width: 767.98px) {
      .doctor-schedule-calendar .fc-daygrid-day-number {
        padding-inline: .1875rem;
      }
    }
  </style>
<% end %>

<div class="card-body p-0">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 p-md-4">
    <h2 class="card-title mb-0" id="doctor-schedule-month"><%= calendar_month.strftime("%Y年%-m月") %></h2>
    <div class="btn-group" role="group" aria-label="切换月份">
      <%= link_to schedule_path(month: calendar_month.prev_month), class: "btn", aria: { label: "上月" } do %>
        <%= render "layouts/admins/icon", name: :chevron_left %><span class="d-none d-sm-inline">上月</span>
      <% end %>
      <%= link_to "本月", schedule_path(month: @today), class: "btn" %>
      <%= link_to schedule_path(month: calendar_month.next_month), class: "btn", aria: { label: "下月" } do %>
        <span class="d-none d-sm-inline">下月</span><%= render "layouts/admins/icon", name: :chevron_right, icon_class: "icon-end" %>
      <% end %>
    </div>
  </div>
  <div class="px-md-4 pb-md-4">
    <%= tag.div id: "doctor-schedule-calendar", class: "doctor-schedule-calendar",
      role: "region", aria: { labelledby: "doctor-schedule-month" },
      data: { initial_date: calendar_month.iso8601, today: @today.iso8601, days: @calendar_days,
        server_time: (@calendar_now.to_r * 1000).to_i, clock_url: clock_admins_doctor_schedule_path(@doctor),
        adjustment_url: schedule_path(tab: :date) } %>
  </div>
</div>
