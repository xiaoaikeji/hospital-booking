<div class="card-body">
  <%= form_with url: admins_doctor_schedule_path(@doctor), method: :get, class: "row g-2 align-items-end", data: { date_editor: "date-adjustment-editor" } do %>
    <%= hidden_field_tag :tab, "date" %>
    <%= hidden_field_tag :month, calendar_month.strftime("%Y-%m"), id: nil %>
    <div class="col-12 col-sm-auto">
      <%= label_tag "schedule-date", "日期", class: "form-label required" %>
      <%= render "admins/shared/date_field", id: "schedule-date", name: :date, value: @date_input || @date.iso8601,
        required: true, clearable: false, placeholder: "YYYY-MM-DD", error_id: ("schedule-date-error" if @date_error) %>
    </div>
    <div class="col-auto"><%= button_tag type: :submit, class: "btn" do %><%= render "layouts/admins/icon", name: :search %>查看当天<% end %></div>
    <div id="schedule-date-error" class="<%= class_names("col-12 invalid-feedback mt-1", "d-block" => @date_error) %>">请输入有效日期，格式为 YYYY-MM-DD。</div>
  <% end %>
</div>
<%= form_with url: date_adjustment_admins_doctor_schedule_path(@doctor), method: :patch, id: "date-adjustment-editor", data: { admin_form: true } do %>
  <%= hidden_field_tag :month, calendar_month.strftime("%Y-%m"), id: nil %>
  <%= hidden_field_tag :date, @date.iso8601, id: nil %>
  <%= hidden_field_tag :revision, @schedule_revision, id: nil if @editable %>
  <div class="card-body border-top">
    <%= render "admins/shared/form_errors", record: @editor %>
    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
      <h2 class="card-title mb-0"><%= @date.iso8601 %> <%= Schedule::WEEKDAYS.fetch(@date.wday) %></h2>
      <% if @editable %>
        <%= render "admins/shared/field_help", label: "查看指定日期调整说明",
          text: "关闭晚班期间，保存只修改日间班次。清空当天全部班次并保存后休诊。撤销日期调整后恢复每周排班。" %>
      <% end %>
      <span class="badge <%= @day.adjusted ? 'bg-primary-lt' : 'bg-secondary-lt' %>"><%= @day.adjusted ? "已调整" : "沿用每周排班" %></span>
      <% if @day.shifts.empty? %><span class="badge bg-secondary-lt">当日无班</span><% end %>
    </div>
    <%= render "shift_fields", scope: "date_adjustment", prefix: "adjustment", label: "", fields: @date_fields %>
  </div>
  <% if @editable %>
    <div class="card-footer bg-transparent"><div class="btn-list justify-content-end pe-6 pe-md-5">
      <% if @day.adjusted %>
        <%= button_tag type: :button, class: "btn btn-outline-warning", disabled: @date_error,
          data: { bs_toggle: "modal", bs_target: "#revoke-date-adjustment-confirmation" } do %>
          <%= render "layouts/admins/icon", name: :rotate %>撤销日期调整
        <% end %>
      <% end %>
      <%= render "admins/shared/submit_button", label: "保存日期调整", icon: :save, disabled: @date_error %>
    </div></div>
  <% end %>
<% end %>
<% if @editable && @day.adjusted %>
  <%= form_with url: date_adjustment_admins_doctor_schedule_path(@doctor), method: :delete, id: "revoke-date-adjustment", hidden: true do %>
    <%= hidden_field_tag :month, calendar_month.strftime("%Y-%m"), id: nil %>
    <%= hidden_field_tag :date, @date.iso8601, id: nil %>
    <%= hidden_field_tag :revision, @schedule_revision, id: nil %>
  <% end %>
  <%= render "admins/shared/confirmation_modal", modal_id: "revoke-date-adjustment-confirmation", form_id: "revoke-date-adjustment",
    color: "warning", title: "撤销日期调整", context: "#{@doctor.name} · #{@date.iso8601}",
    description: "撤销后，这一天恢复每周排班。", cancel_icon: :close, confirm_icon: :rotate, confirm_label: "确认撤销" %>
<% end %>
