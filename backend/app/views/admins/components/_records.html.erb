<section class="card mb-3" aria-labelledby="records-status-title">
  <div class="card-header"><h2 class="card-title" id="records-status-title">状态与分类标签</h2></div>
  <div class="card-body">
    <div class="d-flex flex-wrap gap-2 mb-4">
      <% [["待确认", "orange"], ["已确认", "primary"], ["服务中", "info"], ["已完成", "success"], ["已取消", "secondary"], ["异常", "danger"]].each do |label, color| %>
        <span class="badge bg-<%= color %>-lt"><%= label %></span>
      <% end %>
    </div>
    <div class="d-flex flex-wrap gap-3 mb-4"><span class="status status-success"><span class="status-dot status-dot-animated"></span>营业中</span><span class="status status-secondary"><span class="status-dot"></span>已停用</span></div>
    <div class="d-flex flex-wrap gap-2"><span class="badge bg-primary-lt">VIP 客户</span><span class="badge bg-secondary-lt">回头客</span><span class="badge bg-secondary-lt">电话登记</span><span class="badge bg-secondary-lt">首次到店</span></div>
  </div>
</section>

<section class="card mb-3"><div class="card-header"><h2 class="card-title">详情字段</h2></div><div class="card-body">
  <%= render "admins/shared/field_rows", fields: { "应用平台" => "微信小程序", "运行状态" => "正常", "备注" => "门诊预约" }, full: ["备注"] %>
</div></section>

<section class="card" aria-labelledby="records-pagination-title">
  <div class="card-header">
    <h2 class="card-title" id="records-pagination-title">分页</h2>
    <%= link_to "查看完整列表", admins_components_path(tab: "list_examples"), class: "ms-auto" %>
  </div>
  <%= render "admins/shared/pagination", pagy: @pagination_example, url: ->(_page) { "#records-pagination-title" } %>
</section>
