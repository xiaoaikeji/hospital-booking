<% scenes = { "list" => "列表操作", "edit" => "编辑页", "settings" => "配置页", "detail" => "详情页", "error" => "错误页" } %>
<nav class="card mb-3" aria-label="页面操作场景">
  <div class="card-body">
    <div class="nav nav-pills gap-2" role="tablist">
      <% scenes.each_with_index do |(key, label), index| %>
        <button type="button" class="nav-link<%= ' active' if index.zero? %>" id="page-actions-tab-<%= key %>" data-bs-toggle="tab" data-bs-target="#page-actions-<%= key %>" role="tab" aria-controls="page-actions-<%= key %>" aria-selected="<%= index.zero? %>"><%= label %></button>
      <% end %>
    </div>
  </div>
</nav>

<div class="tab-content">
  <section class="tab-pane active show" id="page-actions-list" role="tabpanel" aria-labelledby="page-actions-tab-list" tabindex="0">
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">列表按钮</h2>
        <%= link_to "查看完整列表", admins_components_path(tab: "list_examples"), class: "ms-auto" %>
      </div>
      <div class="card-body"><div class="row g-3">
        <% groups = {
          "页头" => [[:plus, "新增预约", "btn-primary"], [:import, "导入", "btn-outline-secondary"], [:export, "导出", "btn-outline-secondary"]],
          "搜索栏" => [[:search, "搜索", ""], [:rotate, "重置筛选", ""]],
          "表格行" => [[:eye, "查看", "btn-sm btn-info"], [:edit, "编辑", "btn-sm btn-outline-primary"], [:trash, "删除", "btn-sm btn-outline-danger", "#page-actions-delete"]]
        } %>
        <% groups.each do |label, actions| %>
          <div class="col-12 col-lg-4">
            <h3 class="subheader mb-2"><%= label %></h3>
            <div class="btn-list">
              <% actions.each do |icon, text, style, target| %>
                <button type="button" class="btn <%= style %>" data-bs-toggle="modal" data-bs-target="<%= target || '#component-notice' %>"><%= render "layouts/admins/icon", name: icon %><%= text %></button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div></div>
    </div>
  </section>

  <section class="tab-pane" id="page-actions-edit" role="tabpanel" aria-labelledby="page-actions-tab-edit" tabindex="0">
    <div class="card">
      <div class="card-header"><h2 class="card-title">编辑页底部操作</h2></div>
      <div class="card-footer btn-list justify-content-end">
        <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#component-notice"><%= render "layouts/admins/icon", name: :close %>取消</button>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#component-notice"><%= render "layouts/admins/icon", name: :save %>保存</button>
      </div>
    </div>
  </section>

  <section class="tab-pane" id="page-actions-settings" role="tabpanel" aria-labelledby="page-actions-tab-settings" tabindex="0">
    <div class="card">
      <div class="card-header"><h2 class="card-title">配置页底部操作</h2></div>
      <div class="card-footer btn-list justify-content-end">
        <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#page-actions-clear"><%= render "layouts/admins/icon", name: :trash %>清除系统配置</button>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#component-notice"><%= render "layouts/admins/icon", name: :save %>保存设置</button>
      </div>
    </div>
  </section>

  <section class="tab-pane" id="page-actions-detail" role="tabpanel" aria-labelledby="page-actions-tab-detail" tabindex="0">
    <div class="card">
      <div class="card-header"><h2 class="card-title">详情页操作</h2></div>
      <div class="card-body"><div class="btn-list justify-content-end">
        <% [[:arrow_left, "返回列表", "btn", "#component-notice"], [:edit, "编辑", "btn btn-outline-primary", "#component-notice"], [:trash, "删除", "btn btn-outline-danger", "#page-actions-delete"]].each do |icon, label, style, target| %>
          <button type="button" class="<%= style %>" data-bs-toggle="modal" data-bs-target="<%= target %>"><%= render "layouts/admins/icon", name: icon %><%= label %></button>
        <% end %>
      </div></div>
    </div>
  </section>

  <section class="tab-pane" id="page-actions-error" role="tabpanel" aria-labelledby="page-actions-tab-error" tabindex="0">
    <div class="card">
      <div class="card-header"><h2 class="card-title">错误页操作</h2><%= link_to "查看完整错误页", "/error-pages.html", class: "ms-auto", target: "_blank", rel: "noopener" %></div>
      <div class="card-body"><div class="btn-list">
        <%= link_to admins_root_path, class: "btn btn-lg btn-primary" do %><%= render "layouts/admins/icon", name: :arrow %>返回后台首页<% end %>
        <%= link_to admins_reservations_path, class: "btn btn-lg" do %><%= render "layouts/admins/icon", name: :calendar %>查看预约列表<% end %>
      </div></div>
    </div>
  </section>
</div>

<%= render "admins/shared/confirmation_modal", modal_id: "page-actions-delete", title: "确认删除记录", context: "示例预约 #1", description: "删除后无法恢复，请确认后再操作。", confirm_label: "确认删除", color: "danger", confirm_icon: :trash, cancel_icon: :close %>
<%= render "admins/shared/confirmation_modal", modal_id: "page-actions-clear", title: "确认清除系统配置", context: "文件存储", description: "清除本页系统配置后，将按 ENV、credentials 读取。", confirm_label: "确认清除", color: "warning", confirm_icon: :trash, cancel_icon: :close %>
