<% toolbars = @list_example == "toolbars"; logs = @list_example == "logs" %>
<% empty = !toolbars && @list_records.empty? %>
<% content_for :fill_content, "true" if empty %>
<% advanced = @list_filters&.slice(:period, :tag)&.any? %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
  <nav class="nav nav-pills" aria-label="列表示例">
    <% @list_examples.each do |key, label| %>
      <%= link_to label, admins_components_path(tab: "list_examples", example: key), class: class_names("nav-link", active: @list_example == key), aria: { current: ("page" if @list_example == key) } %>
    <% end %>
  </nav>
  <% unless logs || toolbars %>
    <button type="button" class="btn" data-bs-toggle="collapse" data-bs-target="#list-example-advanced" aria-controls="list-example-advanced" aria-expanded="<%= advanced %>">
      <span data-collapse-label="collapsed">更多筛选</span>
      <span data-collapse-label="expanded">收起筛选</span>
    </button>
  <% end %>
</div>

<% if toolbars %>
  <%= render "list_toolbars" %>
<% else %>
  <%= render "list_example_records", empty: empty, logs: logs, advanced: advanced %>
<% end %>
