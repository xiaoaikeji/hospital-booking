<%= render "admins/shared/operation_styles", new_target: "#component-new", new_label: "新增预约", save_target: "#component-notice", import_target: "#reservation-import", export_target: "#reservation-export", delete_target: "#component-delete", disable_target: "#component-disable", view_path: admins_reservation_path(1), edit_path: edit_admins_reservation_path(1) %>
<section class="card mt-3" aria-labelledby="actions-dropdown-title"><div class="card-header"><h2 class="card-title" id="actions-dropdown-title">更多操作与确认框</h2></div><div class="card-body"><div class="btn-list">
  <div class="dropdown"><button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">更多操作</button><div class="dropdown-menu"><%= link_to "查看", admins_reservation_path(1), class: "dropdown-item" %><%= link_to "编辑", edit_admins_reservation_path(1), class: "dropdown-item" %><div class="dropdown-divider"></div><button type="button" class="dropdown-item text-warning" data-bs-toggle="modal" data-bs-target="#component-disable">停用服务</button><button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#component-delete">删除</button></div></div>
  <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#component-delete">删除确认框</button><button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#component-disable">高风险操作确认框</button>
</div></div></section>
<%= render "admins/reservation_previews/form_modal", modal_id: "component-new", title: "新增预约", submit_label: "保存", reservation: nil %>
<%= render "admins/reservation_previews/transfer_modals", total_count: @records.size %>
<%= render "admins/shared/confirmation_modal", modal_id: "component-delete", title: "确认删除记录", context: "所选记录", description: "请确认是否删除所选记录，删除后无法恢复。", confirm_label: "确认删除", color: "danger" %>
<%= render "admins/shared/confirmation_modal", modal_id: "component-disable", title: "确认停用服务", context: "所选服务项目", description: "停用后，客户将无法继续预约该服务，请确认后再操作。", confirm_label: "确认停用", color: "warning" %>
