<% preview_params = { tab: "list_examples", example: "toolbars" } %>
<% active_filters = { status: @toolbar_status, q: @toolbar_query.presence }.compact.merge(@toolbar_ranges) %>
<% filter_url = ->(changes) { admins_components_path(preview_params.merge(active_filters).merge(changes).compact) } %>
<% empty = @toolbar_records.empty? %>
<% content_for :fill_content, "true" if empty %>

<%= render layout: "admins/shared/list_page_header", locals: { title: "预约列表", icon: :calendar, heading: :h2 } do %>
  <button type="button" class="btn btn-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#component-notice">
    <%= render "layouts/admins/icon", name: :plus %>新增预约
  </button>
<% end %>

<section class="card mb-3 flex-shrink-0" aria-label="预约筛选条件">
  <div class="list-group list-group-flush">
    <%= render "admins/shared/list_filter_row", label: "预约状态", key: :status, options: @toolbar_status_options, selected: @toolbar_status, filter_url: filter_url %>
  </div>
</section>

<section class="<%= class_names("card", "flex-fill" => empty) %>" aria-label="预约列表示例">
  <div class="card-header flex-shrink-0 overflow-x-auto">
    <%= form_with url: admins_components_path, method: :get, class: "d-flex flex-nowrap align-items-center gap-1 gap-sm-2 w-100", html: { role: "search", aria: { label: "搜索预约" } } do |form| %>
      <% preview_params.merge(status: @toolbar_status).compact.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
      <div class="col-4 col-md-3 flex-shrink-0">
        <%= form.search_field :q, value: @toolbar_query, class: "form-control text-truncate", placeholder: "客户 / 手机号", aria: { label: "客户或手机号" } %>
      </div>
      <% { date_range: "预约", created_date_range: "创建" }.each do |field, prefix| %>
        <div class="col-5 col-sm-4 col-md-3 col-xl-2 flex-shrink-0">
          <%= render "admins/shared/date_field", id: "toolbar-#{field.to_s.dasherize}", name: field, value: @toolbar_ranges[field], prefix: prefix, selection_mode: "multiple-ranged", placeholder: "起止日期", clearable: false %>
        </div>
      <% end %>
      <button type="submit" class="btn flex-shrink-0 text-nowrap"><%= render "layouts/admins/icon", name: :search %>搜索</button>
      <% if active_filters.any? %>
        <%= link_to admins_components_path(preview_params), class: "btn flex-shrink-0 text-nowrap" do %><%= render "layouts/admins/icon", name: :rotate %>重置筛选<% end %>
      <% end %>
      <div class="d-flex flex-nowrap gap-1 gap-sm-2 ms-auto flex-shrink-0">
        <% [[:import, "导入"], [:export, "导出"]].each do |icon, label| %>
          <button type="button" class="btn btn-outline-secondary text-nowrap" data-bs-toggle="modal" data-bs-target="#component-notice"><%= render "layouts/admins/icon", name: icon %><%= label %></button>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if empty %>
    <div class="empty flex-fill h-auto p-4" role="status"><div>
      <div class="empty-icon mx-auto"><%= render "layouts/admins/icon", name: :calendar, icon_class: "w-100 h-100" %></div>
      <h3 class="empty-title">没有找到匹配的预约</h3>
      <p class="empty-subtitle text-secondary">试试其他关键词，或重置筛选。</p>
    </div></div>
  <% else %>
    <div class="table-responsive">
      <table class="table card-table table-vcenter table-hover text-nowrap mb-0">
        <thead><tr>
          <th scope="col">ID</th><th scope="col">客户</th><th scope="col">服务项目</th>
          <th scope="col">预约日期</th><th scope="col">创建日期</th><th scope="col">状态</th>
        </tr></thead>
        <tbody>
          <% @toolbar_records.each do |record| %>
            <tr>
              <td class="text-secondary">#<%= record[:id] %></td>
              <td><div><%= record[:name] %></div><div class="text-secondary small"><%= record[:mobile] %></div></td>
              <td><%= record[:service] %></td>
              <td><%= record[:date] %></td>
              <td><%= record[:created_date] %></td>
              <td><span class="badge bg-<%= record[:color] %>-lt"><%= record[:status] %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
