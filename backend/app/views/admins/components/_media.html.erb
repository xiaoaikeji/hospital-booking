<div class="row row-deck row-cards">
  <div class="col-xl-4">
    <section class="card" aria-labelledby="media-cover-title">
      <div class="card-header"><h2 class="card-title" id="media-cover-title">单图封面</h2></div>
      <div class="card-body">
        <%= render "admins/shared/image_thumbnail", image: @images.first, modal_id: "image-room", variant: :tile %>
        <div class="d-flex align-items-center gap-1 mt-3 mb-2"><label class="form-label mb-0" for="component-cover">封面图片</label><%= render "admins/shared/field_help", text: "支持 JPG、PNG、WEBP，每张最大 2MB。", label: "查看封面图片要求" %></div>
        <input type="file" class="form-control" id="component-cover" accept="image/jpeg,image/png,image/webp">
        <div class="btn-list mt-3"><button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#component-notice">替换封面</button><button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#component-image-delete">移除</button></div>
      </div>
    </section>
  </div>
  <div class="col-xl-8">
    <section class="card" aria-labelledby="media-gallery-title">
      <div class="card-header"><h2 class="card-title" id="media-gallery-title">多图管理</h2><span class="badge bg-secondary-lt ms-auto">3 张</span></div>
      <div class="card-body">
        <div class="row g-3 mb-3">
          <% @images.each do |image| %><div class="col-6 col-md-4">
            <%= render "admins/shared/image_thumbnail", image: image, modal_id: "image-#{image[:key]}", variant: :tile %>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2"><span class="small"><%= image[:title] %></span><button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#component-image-delete" aria-label="删除<%= image[:title] %>">删除</button></div>
          </div><% end %>
        </div>
        <label class="form-label" for="component-gallery">添加图片</label>
        <input type="file" class="form-control" id="component-gallery" accept="image/jpeg,image/png,image/webp" multiple>
        <button type="button" class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#component-notice"><%= render "layouts/admins/icon", name: :plus %>添加图片</button>
      </div>
    </section>
  </div>
  <div class="col-12">
    <section class="card" aria-labelledby="media-thumbnails-title">
      <div class="card-header"><h2 class="card-title" id="media-thumbnails-title">列表小图与放大预览</h2></div>
      <div class="card-body d-flex flex-wrap gap-4">
        <% @images.each do |image| %>
          <div class="d-flex align-items-center gap-2">
            <%= render "admins/shared/image_thumbnail", image: image, modal_id: "image-#{image[:key]}", size: "avatar-sm" %>
            <span><%= image[:title] %></span>
          </div>
        <% end %>
      </div>
    </section>
  </div>
  <div class="col-lg-6">
    <section class="card" aria-labelledby="media-avatar-title">
      <div class="card-header"><h2 class="card-title" id="media-avatar-title">头像与缺省状态</h2></div>
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
          <%= image_tag "admins/components/staff-1.jpg", class: "avatar avatar-xl rounded-circle", alt: "员工头像" %>
          <span class="avatar avatar-lg bg-primary-lt rounded-circle">陈</span>
          <span class="avatar avatar-lg bg-secondary-lt"><%= render "layouts/admins/icon", name: :users %></span>
          <span class="avatar avatar-lg bg-secondary-lt"><%= render "layouts/admins/icon", name: :package %></span>
        </div>
        <label class="form-label" for="component-avatar">员工头像</label><input type="file" class="form-control" id="component-avatar" accept="image/jpeg,image/png,image/webp">
        <div class="d-flex flex-wrap align-items-center gap-3 mt-4"><span class="text-secondary">服务团队</span><div class="avatar-list avatar-list-stacked avatar-list-sm"><% (1..3).each do |index| %><%= image_tag "admins/components/staff-#{index}.jpg", class: "avatar rounded-circle", alt: "团队成员 #{index}" %><% end %><span class="avatar bg-primary text-white rounded-circle" aria-label="另有 2 位团队成员">+2</span></div></div>
      </div>
    </section>
  </div>
  <div class="col-lg-6">
    <section class="card" aria-labelledby="media-attachment-title">
      <div class="card-header"><h2 class="card-title" id="media-attachment-title">附件上传与下载</h2></div>
      <div class="card-body">
        <label class="form-label" for="component-attachment">导入文件</label><input type="file" class="form-control mb-4" id="component-attachment" accept=".csv,.xlsx">
        <div class="list-group list-group-flush">
          <div class="list-group-item px-0"><div class="d-flex flex-wrap align-items-center gap-3">
            <span class="avatar bg-primary-lt"><%= render "layouts/admins/icon", name: :export %></span>
            <div class="flex-fill"><div>门店环境.jpg</div><div class="text-secondary small">图片附件</div></div>
            <%= link_to "下载", image_path(@images.first[:asset]), download: "门店环境.jpg", class: "btn btn-sm btn-outline-secondary" %>
            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#component-image-delete">删除</button>
          </div></div>
        </div>
      </div>
    </section>
  </div>
  <div class="col-12">
    <section class="card" aria-labelledby="media-choice-title">
      <div class="card-header"><h2 class="card-title" id="media-choice-title">图片单选</h2></div>
      <div class="card-body"><fieldset><legend class="form-label">选择展示封面</legend><div class="row g-3">
        <% @images.each_with_index do |image, index| %><div class="col-6 col-lg-3">
          <label class="form-imagecheck w-100"><input type="radio" name="component-cover-choice" value="<%= image[:key] %>" class="form-imagecheck-input" <%= "checked" if index.zero? %>><span class="form-imagecheck-figure"><span class="ratio ratio-4x3"><%= image_tag image[:asset], class: "form-imagecheck-image w-100 h-100 object-cover", alt: "" %></span><span class="form-imagecheck-caption"><%= image[:title] %></span></span></label>
        </div><% end %>
      </div></fieldset></div>
    </section>
  </div>
</div>
<% @images.each do |image| %><%= render "admins/shared/image_modal", image: image, modal_id: "image-#{image[:key]}" %><% end %>
<%= render "admins/shared/confirmation_modal", modal_id: "component-image-delete", title: "确认删除图片", context: "所选图片", description: "删除后，这张图片将不再展示，请确认后再操作。", confirm_label: "确认删除", color: "danger" %>
