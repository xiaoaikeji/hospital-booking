<% rules = [["取消预约", "exact", "取消指引"], ["预约", "contain", "预约说明"], ["营业时间", "exact", "门店营业时间"]] %>
<section class="col-12" id="draft-keyword-order" aria-labelledby="draft-keyword-title" data-draft-keyword-order>
  <div class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title" id="draft-keyword-title">自动回复规则排序</h2>
        <div class="card-subtitle">从上往下匹配，命中第一条后执行。</div>
      </div>
    </div>
    <ol class="list-group list-group-flush" data-draft-keyword-list>
      <% rules.each_with_index do |(keyword, match, reply), index| %>
        <li class="list-group-item" data-draft-rule data-keyword="<%= keyword %>" data-match="<%= match %>" data-reply="<%= reply %>">
          <div class="d-flex flex-wrap align-items-center gap-3">
            <span class="cursor-move text-secondary d-inline-flex" draggable="true" aria-hidden="true" data-draft-rule-grip>
              <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <circle cx="9" cy="5" r="1.4"/><circle cx="15" cy="5" r="1.4"/>
                <circle cx="9" cy="12" r="1.4"/><circle cx="15" cy="12" r="1.4"/>
                <circle cx="9" cy="19" r="1.4"/><circle cx="15" cy="19" r="1.4"/>
              </svg>
            </span>
            <span class="badge bg-primary-lt" data-draft-rule-position><%= index + 1 %></span>
            <div class="flex-grow-1 text-break">
              <span class="fw-medium"><%= keyword %></span>
              <div class="small text-secondary"><%= match == "exact" ? "完全匹配" : "包含" %> · <%= reply %></div>
            </div>
            <div class="btn-list">
              <button type="button" class="btn btn-sm" data-draft-rule-move="up" aria-label="上移「<%= keyword %>」" <%= "disabled" if index.zero? %>>上移</button>
              <button type="button" class="btn btn-sm" data-draft-rule-move="down" aria-label="下移「<%= keyword %>」" <%= "disabled" if index == rules.length - 1 %>>下移</button>
            </div>
          </div>
        </li>
      <% end %>
    </ol>
    <div class="card-footer text-secondary" role="status" data-draft-rule-example>输入「取消预约」会回复「取消指引」。</div>
  </div>
</section>
