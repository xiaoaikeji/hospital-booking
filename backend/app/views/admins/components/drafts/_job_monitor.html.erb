<% states = { success: ["成功", "green"], recovered: ["重试恢复", "yellow"], failure: ["失败未恢复", "red"], missing: ["无执行记录", "secondary"] } %>
<% jobs = [
  ["通知投递检查", %i[success success success success recovered success failure success],
    { 4 => ["12:38", "Net::ReadTimeout", "重试恢复", "green"], 6 => ["14:15", "Net::OpenTimeout", "等待重试", "yellow"] }],
  ["微信结果通知", %i[success missing success recovered success success success success],
    { 3 => ["11:24", "WechatPlatform::Error", "重试恢复", "green"] }]
] %>
<section class="col-12" id="draft-job-monitor" aria-labelledby="draft-jobs-title" data-draft-job-monitor>
  <div class="row row-cards">
    <div class="col-lg-8">
      <div class="card h-100">
        <div class="card-header">
          <div>
            <h2 class="card-title" id="draft-jobs-title">定时任务运行记录</h2>
            <div class="card-subtitle">示例数据 · 每格 1 小时</div>
          </div>
        </div>
        <div class="list-group list-group-flush">
          <% jobs.each_with_index do |(task, slots, errors), job_index| %>
            <div class="list-group-item">
              <div class="fw-medium mb-2"><%= task %></div>
              <div class="tracking" role="group" aria-label="<%= task %>每小时状态">
                <% slots.each_with_index do |state, index| %>
                  <% label, color = states.fetch(state) %>
                  <% range = format("%02d:00–%02d:00", index + 8, index + 9) %>
                  <% detail_id = "draft-job-#{job_index}-#{index}" %>
                  <button type="button" class="tracking-block <%= state == :missing ? 'bg-secondary-lt' : "bg-#{color}" %> border-0 p-0"
                          title="<%= range %> · <%= label %>" aria-label="<%= task %> <%= range %> <%= label %>" aria-pressed="false"
                          aria-controls="draft-job-failures" data-draft-job-slot data-range="<%= task %> · <%= range %>"
                          data-state="<%= state %>" data-detail-id="<%= detail_id %>"></button>
                  <% if (detail = errors[index]) %>
                    <% time, error_class, status, status_color = detail %>
                    <template id="<%= detail_id %>">
                      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="text-break"><%= error_class %><div class="small text-secondary"><%= time %></div></div>
                        <span class="badge bg-<%= status_color %>-lt"><%= status %></span>
                      </div>
                    </template>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <div class="card-footer mt-auto">
          <div class="legend-list flex-wrap">
            <% states.each_value do |label, color| %>
              <span class="legend legend-<%= color %>"><span class="legend-dot"></span><%= label %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card h-100" id="draft-job-failures" aria-labelledby="draft-job-failures-title">
        <div class="card-header">
          <div>
            <h3 class="card-title" id="draft-job-failures-title">失败记录</h3>
            <div class="card-subtitle" data-draft-job-range></div>
          </div>
        </div>
        <div class="card-body" aria-live="polite" data-draft-job-detail>查看对应任务在这一小时的失败记录。</div>
      </div>
    </div>
  </div>
</section>
