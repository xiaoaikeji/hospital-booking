<% groups = {
  "粉丝与渠道" => [["粉丝列表", :users], ["渠道二维码", :qrcode]],
  "菜单与回复" => [["自定义菜单", :templates], ["回复内容", :templates], ["自动回复规则", :settings]],
  "模板通知" => [["微信模板消息", :templates]]
} %>
<section class="col-12" id="draft-account-actions" aria-labelledby="draft-account-title">
  <div class="card">
    <div class="card-header"><h2 class="card-title" id="draft-account-title">公众号运营入口</h2></div>
    <div class="card-body">
      <div class="row g-3">
        <% groups.each do |label, entries| %>
          <div class="col-md-4">
            <h3 class="h4 mb-2"><%= label %></h3>
            <ul class="list-group">
              <% entries.each do |name, icon| %>
                <li class="list-group-item d-flex align-items-center gap-2">
                  <span class="text-secondary d-inline-flex"><%= render "layouts/admins/icon", name: icon %></span><%= name %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
