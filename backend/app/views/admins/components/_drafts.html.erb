<% content_for :head do %>
  <%= javascript_include_tag "admins/notification_variables", "admins/component_drafts", defer: true %>
  <style>
    [data-help-preview] button[data-bs-toggle="tooltip"] .icon {
      --tblr-icon-size: 1.125em;
      font-size: inherit;
    }
  </style>
<% end %>

<div class="row row-cards">
  <%= render "admins/components/drafts/heading_help" %>
  <%= render "admins/components/drafts/message_composer" %>
  <%= render "admins/components/drafts/keyword_order" %>
  <%= render "admins/components/drafts/job_monitor" %>
  <%= render "admins/components/drafts/account_actions" %>
</div>
