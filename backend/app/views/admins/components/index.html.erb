<% content_for :title, "组件规范 · Booking 管理后台" %>
<div class="page-header mt-0 mb-3">
  <div class="row g-2 align-items-center">
    <div class="col-auto"><h1 class="page-title fs-1 gap-3">
      <span class="text-primary d-inline-flex"><%= render "layouts/admins/icon", name: :package, icon_class: "w-5 h-5" %></span>
      <span class="d-inline-flex align-items-center gap-1">组件规范
        <%= render "admins/shared/field_help", label: "查看预览说明", text: "预览操作不会保存或上传文件。" %>
      </span>
    </h1></div>
    <div class="col-auto ms-auto"><%= link_to "返回预约列表", admins_reservations_path, class: "btn text-nowrap" %></div>
  </div>
</div>
<nav class="card mb-3" aria-label="样式规范分类">
  <div class="list-group list-group-flush">
    <% @groups.each do |group, tabs| %>
      <div class="list-group-item py-2" role="group" aria-label="<%= group %>">
        <div class="row g-2 align-items-center">
          <div class="col-12 col-md-2 col-xl-1 text-secondary"><%= group %></div>
          <div class="col"><ul class="nav nav-pills">
            <% tabs.each do |key, label| %>
              <li class="nav-item"><%= link_to label, admins_components_path(tab: key), class: class_names("nav-link", active: @tab == key), aria: { current: ("page" if @tab == key) } %></li>
            <% end %>
          </ul></div>
        </div>
      </div>
    <% end %>
  </div>
</nav>
<%= render "admins/components/#{@tab}" %>
<%= render "notice_modal" %>
