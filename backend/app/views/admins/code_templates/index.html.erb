<% content_for :title, "小程序模板管理 · Booking 管理后台" %>
<% content_for :head do %><%= javascript_include_tag "admins/code_templates", defer: true %><% end %>
<%= render layout: "admins/shared/list_page_header", locals: { title: "小程序模板管理", icon: :templates } do %>
  <% if @configured %>
    <span id="template-feedback" role="status" class="small text-secondary"></span>
    <button type="button" class="btn" id="refresh-templates"><%= render "layouts/admins/icon", name: :rotate %>刷新微信数据</button>
  <% end %>
<% end %>
<% unless @configured %>
  <section class="card mb-3"><div class="card-body">
    <h2 class="card-title">微信第三方平台未配置</h2>
    <p class="text-secondary mb-0">请先在部署环境配置第三方平台凭据，再读取草稿或管理模板。</p>
  </div></section>
<% end %>
<div id="template-library" data-source="<%= admins_code_templates_path(fresh: 1) if @configured %>">
  <%= render "lists" if @configured || @lists.values.any?(&:present?) %>
</div>
