<% @lists.each do |key, rows| %>
  <% drafts = key == :drafts; title = drafts ? "微信草稿箱" : "代码模板库" %>
  <section class="card mb-3 template-library-card <%= "template-drafts" if drafts %>" aria-label="<%= title %>">
    <div class="card-header"><h2 class="card-title"><%= title %></h2><% if rows %><span class="ms-auto text-secondary small"><%= rows.size %> <%= drafts ? "份草稿" : "个模板" %></span><% end %></div>
    <% if @errors[key] %><div class="alert alert-warning m-3" role="status"><%= @errors[key] %><%= "，以下为上次成功读取的内容" if rows %></div><% end %>
    <% if rows.present? %>
      <table class="table table-fixed table-vcenter card-table table-hover admin-list-table template-table mb-0">
        <thead><tr><th class="list-column-id">ID</th><th>来源小程序</th><th>AppID</th><th>版本</th><th>说明</th><% unless drafts %><th>模板类型</th><th>使用次数</th><% end %><th>开发者</th><th class="list-column-time"><%= drafts ? "上传时间" : "加入时间" %></th><th class="template-actions">操作</th></tr></thead>
        <tbody><% rows.each do |row| %>
          <% id = row.fetch(drafts ? "draft_id" : "template_id").to_s; standard = row["template_type"].to_i == 1 %>
          <tr><td class="text-secondary" data-label="ID"><%= render "admins/shared/list_text", text: "##{id}" %></td>
            <td data-label="来源小程序"><%= render "admins/shared/list_text", text: row["source_miniprogram"].presence || "—" %></td>
            <td data-label="AppID"><%= render "admins/shared/list_text", text: row["source_miniprogram_appid"].presence || "—" %></td>
            <td data-label="版本"><%= render "admins/shared/list_text", text: row["user_version"].presence || "—" %></td>
            <td data-label="说明"><%= render "admins/shared/list_text", text: row["user_desc"].presence || "—", multiline: true %></td>
            <% unless drafts %><td data-label="模板类型"><%= standard ? "标准模板" : "普通模板" %>
              <% if standard %><div class="small text-secondary"><%= row["audit_status"] && WechatPlatform::CodeTemplates::AUDIT_STATES[row["audit_status"].to_i] || "审核状态未知" %></div><% if row["reason"].present? %><small class="text-danger"><%= render "admins/shared/list_text", text: row["reason"], multiline: true %></small><% end %><% end %></td>
              <td data-label="使用次数"><%= render "admins/shared/list_text", text: "已使用 #{@counts.fetch(id, 0)} 次" %></td><% end %>
            <td data-label="开发者"><%= render "admins/shared/list_text", text: row["developer"].presence || "—" %></td>
            <td data-label="<%= drafts ? "上传时间" : "加入时间" %>"><%= row["create_time"].present? ? admin_list_time(Time.zone.at(row["create_time"].to_i)) : "—" %></td>
            <td class="template-actions"><% if @configured %><div class="d-flex flex-wrap gap-1">
              <% (drafts ? WechatPlatform::CodeTemplates::TYPES.keys : ["delete"]).each do |operation| %>
                <% label = drafts ? "加入#{WechatPlatform::CodeTemplates::TYPES.fetch(operation)}库" : "删除"; form_id = "template-#{operation}-#{id}" %>
                <%= form_with url: drafts ? admins_code_templates_path : admins_code_template_path(id), method: drafts ? :post : :delete, id: form_id do %>
                  <% if drafts %><%= hidden_field_tag :draft_id, id, id: nil %><%= hidden_field_tag :template_type, operation, id: nil %><% end %>
                  <button type="button" class="btn btn-sm text-nowrap <%= drafts ? ("btn-outline-primary" if operation == "normal") : "btn-outline-danger" %>" data-bs-toggle="modal" data-bs-target="#<%= form_id %>-confirm"><%= render "layouts/admins/icon", name: drafts ? :plus : :trash %><%= label %></button>
                <% end %>
                <%= render "admins/shared/confirmation_modal", modal_id: "#{form_id}-confirm", form_id: form_id, title: "确认#{label}", context: "#{title} ##{id} · #{row['user_version']}", description: drafts ? "将此草稿加入微信模板库。" : "删除后无法再用此模板上传，已上传记录保留。", color: drafts ? "primary" : "danger", confirm_label: "确认#{label}", confirm_icon: drafts ? :check : :trash, cancel_icon: :close %>
              <% end %>
            </div><% end %></td>
          </tr>
        <% end %></tbody>
      </table>
    <% elsif rows %><%= render "admins/shared/list_empty", icon: :package, title: "暂无#{title}记录" %>
    <% elsif !@configured || @errors[key] %><%= render "admins/shared/list_empty", icon: :package, title: "尚无成功读取的记录" %><% end %>
  </section>
<% end %>
