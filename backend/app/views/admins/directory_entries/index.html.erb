<% content_for :title, "#{entry_title} · Booking 管理后台" %>
<% content_for :fill_content, "true" if @entries.empty? %>
<% editable = current_admin.maintain_booking_directory? %>
<%= render layout: "admins/shared/list_page_header", locals: { title: entry_title, icon: :package } do %>
  <% if editable %>
    <%= link_to new_polymorphic_path([:admins, entry_model]), class: "btn btn-primary text-nowrap" do %><%= render "layouts/admins/icon", name: :plus %>新增<%= entry_label %><% end %>
  <% end %>
<% end %>

<section class="card mb-3 flex-shrink-0" aria-label="筛选条件">
  <div class="list-group list-group-flush">
    <%= render "admins/shared/list_filter_row", label: "状态", key: :status, options: DirectoryEntry::STATUSES,
      selected: @status, filter_url: ->(changes) { directory_path(**changes) } %>
  </div>
</section>

<section class="<%= class_names("card directory-list-card", "flex-fill" => @entries.empty?) %>" aria-label="<%= entry_label %>列表">
  <% if @entries.empty? %>
    <%= render "admins/shared/list_empty", icon: :package, title: (@status ? "没有符合条件的#{entry_label}" : "暂无#{entry_label}") %>
  <% else %>
    <table class="table table-fixed table-vcenter card-table table-hover admin-list-table mb-0">
      <thead>
        <tr>
          <th scope="col" class="list-column-id px-2">ID</th>
          <th scope="col" class="px-2">名称</th>
          <%= render "#{controller_path}/columns", entry: nil %>
          <th scope="col" class="directory-order px-2">排序</th>
          <th scope="col" class="list-column-status px-2">状态</th>
          <th scope="col" class="directory-actions px-2">操作</th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <tr id="<%= dom_id(entry) %>">
            <td class="text-secondary px-2"><%= render "admins/shared/list_text", text: "##{entry.id}" %></td>
            <td class="px-2">
              <div class="d-flex align-items-center gap-2">
                <% if entry.image.attached? %>
                  <%= render "admins/shared/image_thumbnail", image: { asset: polymorphic_path([:image, :admins, entry]), title: entry.name },
                    modal_id: dom_id(entry, :image), size: (entry.is_a?(Doctor) ? "avatar-sm rounded-circle" : "avatar-sm") %>
                <% elsif entry.is_a?(Doctor) %>
                  <span class="avatar avatar-sm rounded-circle bg-primary-lt"><%= entry.name.first %></span>
                <% end %>
                <div class="overflow-hidden">
                  <%= render "admins/shared/list_text", text: entry.name %>
                  <% if entry.is_a?(Doctor) %><div class="directory-fee-compact small text-secondary"><%= entry.fee_in_yuan %> 元</div><% end %>
                </div>
              </div>
            </td>
            <%= render "#{controller_path}/columns", entry: entry %>
            <td class="px-2"><%= render "admins/shared/list_text", text: entry.sort_order.to_s %></td>
            <td class="px-2"><span class="badge <%= entry.enabled? ? 'bg-success-lt' : 'bg-secondary-lt' %>"><%= DirectoryEntry::STATUSES.fetch(entry.status) %></span></td>
            <td class="directory-action-cell px-2">
              <div class="d-flex flex-wrap gap-1">
                <% if editable %>
                  <%= link_to edit_polymorphic_path([:admins, entry]), class: "btn btn-sm btn-outline-primary text-nowrap" do %><%= render "layouts/admins/icon", name: :edit %>编辑<% end %>
                  <% if entry.enabled? %>
                    <button type="button" class="btn btn-sm btn-outline-warning text-nowrap" data-bs-toggle="modal" data-bs-target="#<%= dom_id(entry, :disable) %>-confirmation"><%= render "layouts/admins/icon", name: :alert %>停用</button>
                  <% else %>
                    <%= button_to polymorphic_path([:status, :admins, entry]), method: :patch, params: { status: 1 }, class: "btn btn-sm btn-outline-success text-nowrap" do %><%= render "layouts/admins/icon", name: :check %>启用<% end %>
                  <% end %>
                <% else %>
                  <%= link_to polymorphic_path([:admins, entry]), class: "btn btn-sm text-nowrap" do %><%= render "layouts/admins/icon", name: :eye %>查看<% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admins/shared/pagination", pagy: @pagy, url: ->(page) { directory_path(status: @status, page: page) } %>
  <% end %>
</section>

<% @entries.each do |entry| %>
  <% if entry.image.attached? %>
    <%= render "admins/shared/image_modal", image: { asset: polymorphic_path([:image, :admins, entry]), title: entry.name }, modal_id: dom_id(entry, :image) %>
  <% end %>
  <% if editable && entry.enabled? %>
    <% form_id = dom_id(entry, :disable) %>
    <%= form_with url: polymorphic_path([:status, :admins, entry]), method: :patch, id: form_id, data: { admin_form: true }, html: { hidden: true } do |form| %>
      <%= form.hidden_field :status, value: 0, id: nil %>
    <% end %>
    <%= render "admins/shared/confirmation_modal", modal_id: "#{form_id}-confirmation", form_id: form_id,
      color: "warning", title: "停用#{entry_label}", context: entry.name, description: "停用后将在小程序隐藏该#{entry_label}。",
      confirm_label: "确认停用" %>
  <% end %>
<% end %>
