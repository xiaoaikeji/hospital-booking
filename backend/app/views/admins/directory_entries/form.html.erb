<% content_for :title, "#{title} · Booking 管理后台" %>
<% doctor = entry_model == Doctor %>
<%= render "admins/shared/enhanced_select_assets" %>
<%= render layout: "admins/shared/list_page_header", locals: { title: title, icon: (doctor ? :users : :package) } do %>
  <%= link_to directory_path, class: "btn text-nowrap" do %><%= render "layouts/admins/icon", name: :arrow_left %>返回列表<% end %>
<% end %>

<% image = { asset: polymorphic_path([:image, :admins, @entry]), title: @entry.name } if @entry.persisted? && @entry.image.attached? %>
<%= form_with model: [:admins, @entry], class: "card", data: { admin_form: true } do |f| %>
  <% if doctor %><div class="card-header"><h2 class="card-title">基本信息</h2></div><% end %>
  <div class="card-body">
    <%= render "admins/shared/form_errors", record: @entry %>
    <% if doctor %>
      <div class="row align-items-start g-4">
        <div class="col-xl-8">
          <%= render "#{controller_path}/fields", f: f %>
        </div>
        <div class="col-md-8 col-xl-4">
          <%= render "admins/shared/single_image_field", form: f, image: image, label: image_label,
            limit: upload_limit, modal_id: dom_id(@entry, :image), size: "avatar-2xl rounded-circle",
            size_hint: "建议使用正方形图片，头像会裁成圆形。" %>
        </div>
      </div>
      <section class="border-top mt-4 pt-3" aria-labelledby="doctor-display-settings">
        <h2 class="card-title mb-3" id="doctor-display-settings">展示设置</h2>
        <div class="row g-3">
          <div class="col-sm-6">
            <div class="d-flex flex-wrap align-items-center gap-3" role="group" aria-labelledby="doctor-display-position">
              <span class="form-label mb-0" id="doctor-display-position">展示位置</span>
              <label class="form-check form-switch mb-0">
                <%= f.check_box :display_on_homepage, { class: "form-check-input", role: "switch" } %>
                <span class="form-check-label">小程序首页</span>
              </label>
            </div>
          </div>
          <% if @entry.new_record? %>
            <div class="col-sm-6">
              <div class="d-flex flex-wrap align-items-center gap-3" role="group" aria-labelledby="doctor-status">
                <span class="form-label mb-0" id="doctor-status">状态</span>
                <label class="form-check form-switch mb-0">
                  <%= f.check_box :status, { class: admin_field_class(@entry, :status, "form-check-input"), role: "switch",
                    aria: { describedby: ("status-error" if @entry.errors[:status].any?) } }, 1, 0 %>
                  <span class="form-check-label">启用</span>
                </label>
              </div>
              <%= admin_field_errors(@entry, :status) %>
            </div>
          <% end %>
        </div>
      </section>
    <% else %>
      <%= render "admins/departments/fields", f: f, image: image %>
    <% end %>
  </div>
  <div class="card-footer btn-list justify-content-end">
    <%= link_to directory_path, class: "btn" do %><%= render "layouts/admins/icon", name: :close %>取消<% end %>
    <%= render "admins/shared/submit_button", label: "保存", icon: :save %>
  </div>
<% end %>
<%= render "admins/shared/image_modal", image: image, modal_id: dom_id(@entry, :image) if image %>
