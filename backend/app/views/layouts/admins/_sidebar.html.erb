<aside class="navbar navbar-vertical navbar-expand-lg" aria-label="侧边导航">
  <div class="container-fluid">
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="展开侧边导航">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="navbar-brand navbar-brand-autodark justify-content-center">
      <a href="<%= admins_root_path %>" class="d-flex align-items-center text-reset text-decoration-none">
        <%= render "layouts/admins/brand_mark" %>
        <span class="nav-link-title"><span class="ms-2">Booking</span></span>
      </a>
    </div>
    <%# Balance the mobile sidebar toggle so the brand stays centered. %>
    <span class="navbar-toggler invisible d-lg-none" aria-hidden="true"></span>
    <div class="navbar-footer d-none d-lg-block">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a href="<%= edit_admins_account_path %>" class="nav-link">
            <span class="avatar avatar-sm bg-primary-lt"><%= current_admin.display_name.first %></span>
            <div class="nav-link-title"><%= current_admin.display_name %><div class="small text-secondary"><%= current_admin.role_name %></div></div>
          </a>
        </li>
      </ul>
    </div>
    <nav class="collapse navbar-collapse" id="sidebar-menu" aria-label="后台菜单">
      <ul class="navbar-nav pt-lg-3">
        <li class="nav-section-title">工作台</li>
        <li class="nav-item<%= " active" if controller_path == "admins/dashboard" %>">
          <a class="nav-link" href="<%= admins_root_path %>" aria-current="<%= controller_path == "admins/dashboard" ? "page" : "false" %>">
            <span class="nav-link-icon"><%= render "layouts/admins/icon", name: :home %></span>
            <span class="nav-link-title">首页概览</span>
          </a>
        </li>
        <% groups = [
          ["预约管理", :calendar, [["预约列表", admins_reservations_path, "admins/reservations"], ["今日排期", admins_root_path(anchor: "schedule")]]],
          ["客户管理", :users, [["客户列表", admins_customers_path, "admins/customers"], ["服务团队", admins_root_path(anchor: "staff")]]],
          ["服务管理", :package, [["服务项目", admins_root_path(anchor: "services")], ["预约规则", admins_root_path(anchor: "settings")]]],
          ["财务管理", :wallet, [["收款记录", admins_root_path(anchor: "payments")], ["经营概况", admins_root_path(anchor: "reports")]]]
        ]
        settings_pages = system_settings_pages
        groups << ["系统设置", :settings, settings_pages] if settings_pages.any? %>
        <% groups.each do |label, icon, children| %>
          <% group_active = children.any? { |_title, _path, controller| controller == controller_path } %>
          <li class="nav-item dropdown<%= " active" if group_active %>">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="false" role="button" aria-haspopup="true" aria-expanded="<%= group_active %>">
              <span class="nav-link-icon"><%= render "layouts/admins/icon", name: icon %></span>
              <span class="nav-link-title"><%= label %></span>
            </a>
            <div class="dropdown-menu<%= " show" if group_active %>">
              <% children.each do |title, path, controller| %>
                <% active = controller == controller_path %>
                <a class="dropdown-item<%= " active" if active %>" href="<%= path %>" aria-current="<%= active ? "page" : "false" %>"><%= title %></a>
              <% end %>
            </div>
          </li>
        <% end %>
        <li class="nav-section-title">管理</li>
        <li class="nav-item">
          <a class="nav-link" href="<%= admins_root_path(anchor: "reports") %>"><span class="nav-link-icon"><%= render "layouts/admins/icon", name: :chart %></span><span class="nav-link-title">数据概况</span></a>
        </li>
        <% [
          (["应用管理", admins_apps_path, :device_mobile, "admins/apps"] if current_admin.super_admin?),
          (["代码", admins_mini_program_releases_path, :code, "admins/mini_program_releases"] if current_admin.super_admin?),
          (["模板", admins_code_templates_path, :templates, "admins/code_templates"] if current_admin.super_admin?),
          (["公众号关联管理", admins_official_account_links_path, :link, "admins/official_account_links"] if current_admin.super_admin?),
          (["公众号粉丝", admins_official_account_fans_path, :users, "admins/official_account_fans"] if current_admin.super_admin?),
          (["公众号自定义菜单", admins_official_account_menus_path, :templates, "admins/official_account_menus"] if current_admin.super_admin?),
          (["回复内容", admins_reply_contents_path, :templates, "admins/reply_contents"] if current_admin.super_admin?),
          (["发送记录", admins_notifications_path, :bell, "admins/notifications"] if current_admin.super_admin?),
          (["渠道二维码", admins_channel_qrcodes_path, :qrcode, "admins/channel_qrcodes"] if current_admin.super_admin?),
          (["插件列表", admins_plugins_path, :puzzle, "admins/plugins"] if current_admin.super_admin?),
          (["违规记录", admins_illegal_records_path, :alert, "admins/illegal_records"] if current_admin.super_admin?),
          (["微信第三方平台", admins_wechat_platform_path, :settings, "admins/wechat_platforms"] if current_admin.super_admin?),
          (["开放平台账号", admins_open_platform_accounts_path, :affiliate, "admins/open_platform_accounts"] if current_admin.super_admin?),
          (["管理员", admins_administrators_path, :users, "admins/administrators"] if current_admin.super_admin?),
          ["操作日志", admins_operation_logs_path, :chart, "admins/operation_logs"]
        ].compact.each do |label, path, icon, controller| %>
          <li class="nav-item<%= ' active' if controller_path == controller %>"><a class="nav-link" href="<%= path %>" aria-current="<%= controller_path == controller ? 'page' : 'false' %>"><span class="nav-link-icon"><%= render "layouts/admins/icon", name: icon %></span><span class="nav-link-title"><%= label %></span></a></li>
        <% end %>
        <li class="nav-item<%= " active" if controller_path == "admins/components" %>">
          <a class="nav-link" href="<%= admins_components_path %>" aria-current="<%= controller_path == "admins/components" ? "page" : "false" %>"><span class="nav-link-icon"><%= render "layouts/admins/icon", name: :package %></span><span class="nav-link-title">组件规范</span></a>
        </li>
        <li class="nav-item mt-auto">
          <button type="button" class="nav-link" data-bs-toggle="offcanvas" data-bs-target="#theme-settings" aria-controls="theme-settings">
            <span class="nav-link-icon"><%= render "layouts/admins/icon", name: :brush %></span><span class="nav-link-title">个人外观</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</aside>
