<%# Controls and illustrations from Desktop/tabler-1.7.1/dashboard/index.html, theme settings. %>
<button type="button" class="<%= class_names("btn btn-floating btn-icon btn-primary d-print-none", "d-none d-md-inline-flex" => content_for?(:mobile_theme_menu)) %>" data-bs-toggle="offcanvas" data-bs-target="#theme-settings" aria-controls="theme-settings" aria-label="自定义主题">
  <%= render "layouts/admins/icon", name: :brush %>
</button>
<form class="offcanvas offcanvas-end" tabindex="-1" id="theme-settings" aria-labelledby="theme-settings-title"
      <%= tag.attributes(data: { url: (admins_personal_appearance_path if current_admin), revision: admin_appearance.revision,
        defaults: admin_appearance.defaults, overrides: admin_appearance.overrides }) %>>
  <div class="offcanvas-header border-bottom">
    <h2 class="offcanvas-title" id="theme-settings-title"><%= current_admin ? "个人外观" : "外观预览" %></h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="关闭"></button>
  </div>
  <fieldset class="offcanvas-body p-0">
    <% { "外观" => %w[scheme theme_primary theme_font theme_base theme_radius],
         "布局" => %w[navbar_position navbar_theme layout navbar navbar_style offcanvas_style sidebar] }.each do |heading, fields| %>
      <section class="p-4 border-bottom">
        <h3 class="subheader mb-3"><%= heading %></h3>
        <div class="space-y-4">
          <% fields.each do |field| %>
            <%= render "admins/shared/appearance_choices", field: field, name: field.dasherize, selected: admin_appearance.values[field] %>
          <% end %>
        </div>
      </section>
    <% end %>
  </fieldset>
  <div class="offcanvas-footer border-top space-y-2">
    <div role="status" class="small text-secondary" data-theme-status></div>
    <button type="button" class="btn w-100" id="reset-theme-settings">恢复默认外观</button>
    <button type="button" class="btn btn-primary w-100" data-bs-dismiss="offcanvas">完成</button>
  </div>
</form>
