<% settings_path = system_settings_pages.first&.second %>
<header class="navbar navbar-expand d-print-none" aria-label="顶部导航">
  <div class="container-xl flex-nowrap gap-2">
    <a href="<%= admins_root_path %>" class="navbar-brand d-none gap-2 flex-shrink-0" data-admin-horizontal-brand aria-label="Booking 首页">
      <%= render "layouts/admins/brand_mark" %>
      <span class="d-none d-xl-inline">Booking</span>
    </a>
    <div class="navbar-nav flex-row flex-shrink-0 order-last">
      <div class="nav-item d-none d-md-flex">
        <button type="button" class="nav-link px-3" data-bs-toggle="offcanvas" data-bs-target="#theme-settings" aria-controls="theme-settings" aria-label="个人外观"><%= render "layouts/admins/icon", name: :brush %></button>
      </div>
      <div class="nav-item dropdown position-static">
        <a href="#" class="nav-link px-3" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="查看通知">
          <%= render "layouts/admins/icon", name: :bell %><span class="badge bg-red"></span>
        </a>
        <div class="dropdown-menu dropdown-menu-arrow dropdown-menu-end dropdown-menu-card">
          <div class="card">
            <div class="card-header"><h3 class="card-title">通知</h3><span class="badge bg-blue-lt ms-auto">2 条</span></div>
            <div class="list-group list-group-flush">
              <a href="<%= admins_reservations_path %>" class="list-group-item list-group-item-action"><div class="fw-medium">收到一笔新的预约</div><div class="text-secondary small">陈女士 · 今日 14:30</div></a>
              <a href="<%= admins_root_path(anchor: "schedule") %>" class="list-group-item list-group-item-action"><div class="fw-medium">今日排期已更新</div><div class="text-secondary small">接下来的预约请查看今日排期</div></a>
            </div>
          </div>
        </div>
      </div>
      <div class="nav-item dropdown">
        <a href="#" class="nav-link d-flex lh-1 p-0 px-2" data-bs-toggle="dropdown" aria-expanded="false" aria-label="打开管理员菜单">
          <span class="avatar avatar-sm bg-primary-lt"><%= current_admin.display_name.first %></span>
          <div class="d-none d-xxl-block ps-2"><div><%= current_admin.display_name %></div><div class="mt-1 small text-secondary"><%= current_admin.role_name %></div></div>
        </a>
        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
          <span class="dropdown-header"><%= current_admin.role_name %></span>
          <%= link_to "账号与密码", edit_admins_account_path, class: "dropdown-item" %>
          <%= link_to "系统设置", settings_path, class: "dropdown-item" if settings_path %>
          <%= link_to "操作日志", admins_operation_logs_path, class: "dropdown-item" %>
          <%= link_to "管理员", admins_administrators_path, class: "dropdown-item" if current_admin.super_admin? %>
          <div class="dropdown-divider"></div>
          <%= button_to "退出登录", destroy_admin_session_path, method: :delete, class: "dropdown-item", form: { class: "m-0" } %>
        </div>
      </div>
    </div>
    <nav class="navbar-collapse overflow-x-auto admin-header__nav" aria-label="快捷导航" tabindex="0">
      <ul class="navbar-nav flex-row flex-nowrap">
        <% [
          ["首页", admins_root_path, :home, controller_path == "admins/dashboard"],
          ["预约", admins_reservations_path, :calendar, controller_path == "admins/reservations"],
          ["客户", admins_customers_path, :users, controller_path == "admins/customers"],
          ["服务", admins_root_path(anchor: "services"), :package, false],
          ["收款", admins_root_path(anchor: "payments"), :wallet, false],
          ["报表", admins_root_path(anchor: "reports"), :chart, false],
          (["系统设置", settings_path, :settings, controller_path.start_with?("admins/system_settings/")] if settings_path),
          ["组件", admins_components_path, :package, controller_path == "admins/components"]
        ].compact.each do |label, path, icon, active| %>
          <li class="nav-item flex-shrink-0<%= " active" if active %>">
            <a class="nav-link" href="<%= path %>" aria-current="<%= active ? "page" : "false" %>">
              <span class="nav-link-icon"><%= render "layouts/admins/icon", name: icon %></span>
              <span class="nav-link-title"><%= label %></span>
            </a>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>
</header>
