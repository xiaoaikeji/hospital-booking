# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets
/public/uploads/*
!/public/uploads/.keep
/public/tmp/*
!/public/tmp/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key


/config/database.yml
/config/application.yml
/config/deploy/*.rb

# Ignore .docx temp files
~$*.docx
~$*.xlsx

# Ignore MacOS folder meta info
.DS_Store
certs

/config/code_templates.yml

# Rails source lives under backend/.
/backend/.bundle
/backend/db/*.sqlite3
/backend/db/*.sqlite3-*
/backend/log/*
!/backend/log/.keep
/backend/tmp/*
!/backend/tmp/.keep
!/backend/tmp/pids/
/backend/tmp/pids/*
!/backend/tmp/pids/.keep
/backend/storage/*
!/backend/storage/.keep
/backend/public/assets
/backend/public/uploads/*
!/backend/public/uploads/.keep
/backend/public/tmp/*
!/backend/public/tmp/.keep
/backend/app/assets/builds/*
!/backend/app/assets/builds/.keep
/backend/config/master.key
/backend/config/credentials.yml.enc
/backend/config/credentials/*.key
/backend/config/credentials/*.yml.enc
/backend/config/database.yml
/backend/config/application.yml
/backend/config/deploy/*.rb
/backend/config/code_templates.yml

# Local environment settings and dependencies.
.env
.env.*
!.env.example
!.env.sample
node_modules/
/miniapp/project.private.config.json
